---
import DashboardLayout from "@layouts/DashboardLayout.astro";
import StatCard from "@components/dashboard/StatCard.astro";
import Icon from "@components/ui/Icon.astro";

interface CandidateAssessment {
  id: string;
  title: string;
  company: string;
  role: string;
  category: string;
  duration: string;
  status: "Not started" | "In progress" | "Submitted" | "Passed" | "Failed";
  dueIn?: string;
  score?: number;
}

const items: CandidateAssessment[] = [
  { id: "ca-1", title: "React + TypeScript take-home",  company: "Linear",     role: "Senior Frontend Engineer", category: "Coding",     duration: "90 min", status: "In progress", dueIn: "in 2 days" },
  { id: "ca-2", title: "Product sense case study",       company: "Notion",     role: "Product Manager",            category: "Written",    duration: "48 hrs", status: "Not started", dueIn: "in 4 days" },
  { id: "ca-3", title: "System design interview",         company: "Vercel",     role: "Staff Engineer",              category: "Coding",     duration: "60 min", status: "Submitted",  score: 88 },
  { id: "ca-4", title: "Design portfolio review",          company: "Figma",      role: "Sr. Product Designer",         category: "Design",     duration: "45 min", status: "Passed",     score: 94 },
  { id: "ca-5", title: "Values & culture-add",              company: "Stripe",     role: "Product Manager",              category: "Behavioral",duration: "30 min", status: "Failed",     score: 62 },
];

const stats = [
  { label: "Assigned",   value: items.length,                                             icon: "briefcase", tone: "brand"   as const },
  { label: "In progress",value: items.filter((i) => i.status === "In progress").length,   icon: "clock",     tone: "info"    as const },
  { label: "Completed",  value: items.filter((i) => ["Submitted","Passed","Failed"].includes(i.status)).length, icon: "checkCircle", tone: "success" as const },
  { label: "Avg score",  value: "81%",                                                     icon: "award",     tone: "accent"  as const },
];

const statusChip: Record<string, string> = {
  "Not started":  "bg-ink-100 text-ink-700 dark:!bg-white/[0.06] dark:!text-ink-800",
  "In progress":  "bg-amber-100 text-amber-800 dark:!bg-amber-500/15 dark:!text-amber-400",
  "Submitted":    "bg-sky-100 text-sky-700 dark:!bg-sky-500/15 dark:!text-sky-400",
  "Passed":       "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400",
  "Failed":       "bg-rose-100 text-rose-700 dark:!bg-rose-500/15 dark:!text-rose-400",
};

const categoryTone: Record<string, string> = {
  Coding:     "bg-brand-50 text-brand-700 ring-brand-100/60 dark:!bg-brand-500/12 dark:!text-brand-400 dark:ring-brand-500/20",
  Design:     "bg-violet-50 text-violet-700 ring-violet-100/60 dark:!bg-violet-500/12 dark:!text-violet-400 dark:ring-violet-500/20",
  Written:    "bg-amber-50 text-amber-700 ring-amber-100/60 dark:!bg-amber-500/12 dark:!text-amber-400 dark:ring-amber-500/20",
  Behavioral: "bg-emerald-50 text-emerald-700 ring-emerald-100/60 dark:!bg-emerald-500/12 dark:!text-emerald-400 dark:ring-emerald-500/20",
};

const tips = [
  { icon: "clock",    body: "Do the test when you're fresh — no notifications, no interruptions." },
  { icon: "shield",   body: "Ask clarifying questions in your submission — showing your thinking matters." },
  { icon: "sparkles", body: "Read the rubric before you start. Most take-homes are graded on 3-5 dimensions." },
];
---
<DashboardLayout title="Assessments" active="assessments">
  <header class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Your work samples</p>
      <h1 class="mt-2 text-[26px] font-semibold leading-tight tracking-tight text-ink-900 sm:text-[32px]">
        Your <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">assessments</span>
      </h1>
      <p class="mt-2 text-[13.5px] text-ink-500">Tests companies have assigned. Complete them to move to the next round.</p>
    </div>
  </header>

  <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((s) => <StatCard {...s} />)}
  </div>

  <!-- Segment tabs -->
  <div class="mt-8 flex flex-wrap gap-1.5">
    {["All", "Active", "Submitted", "Passed"].map((t, i) => (
      <button type="button" data-asm-filter={t} data-active={i === 0 ? "true" : "false"} class="asm-tab inline-flex h-9 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3.5 text-[12.5px] font-medium text-ink-800 transition-colors hover:border-ink-400 data-[active=true]:!border-ink-900 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50 dark:!border-white/10 dark:!bg-white/[0.03]">
        {t}
      </button>
    ))}
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <!-- List -->
    <div class="lg:col-span-2 space-y-3">
      {items.map((a) => (
        <article class="asm-card group rounded-2xl border border-ink-200/70 bg-white p-5 transition-colors hover:border-ink-300 dark:!border-white/[0.08] dark:!bg-white/[0.03]" data-status={a.status}>
          <header class="flex flex-wrap items-start justify-between gap-3">
            <div class="flex items-start gap-3 min-w-0 flex-1">
              <span class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ring-1 ${categoryTone[a.category]}`}>
                <Icon name="award" size={17} strokeWidth={1.8} />
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest ${statusChip[a.status]}`}>
                    {a.status === "In progress" && <span class="h-1 w-1 rounded-full bg-amber-500"></span>}
                    {a.status}
                  </span>
                  {a.dueIn && (
                    <span class="text-[11.5px] text-ink-500">Due {a.dueIn}</span>
                  )}
                </div>
                <h3 class="mt-2 text-[15px] font-semibold text-ink-900">{a.title}</h3>
                <p class="mt-1 text-[12.5px] text-ink-500">
                  <span class="font-semibold text-ink-800">{a.company}</span> · {a.role}
                </p>
                <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11.5px] text-ink-500">
                  <span class="inline-flex items-center gap-1"><Icon name="clock" size={11} /> {a.duration}</span>
                  <span>· {a.category}</span>
                </div>
              </div>
            </div>

            <div class="flex flex-col items-end gap-2">
              {typeof a.score === "number" && (
                <span class="text-[20px] font-semibold tabular-nums text-emerald-600 dark:!text-emerald-400">{a.score}%</span>
              )}
              {a.status === "Not started" && (
                <button type="button" class="inline-flex h-9 items-center gap-1 rounded-full bg-ink-900 px-3.5 text-[12.5px] font-semibold text-ink-50 hover:bg-brand-600">
                  Start test
                  <Icon name="arrowRight" size={12} />
                </button>
              )}
              {a.status === "In progress" && (
                <button type="button" class="inline-flex h-9 items-center gap-1 rounded-full bg-brand-600 px-3.5 text-[12.5px] font-semibold text-white hover:bg-brand-700">
                  Continue
                  <Icon name="arrowRight" size={12} />
                </button>
              )}
              {(a.status === "Submitted" || a.status === "Passed" || a.status === "Failed") && (
                <button type="button" class="inline-flex h-9 items-center gap-1 rounded-full border border-ink-200 bg-white px-3.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">
                  View feedback
                  <Icon name="arrowUpRight" size={11} />
                </button>
              )}
            </div>
          </header>

          {a.status === "In progress" && (
            <div class="mt-4">
              <div class="flex items-center justify-between text-[11px] text-ink-500">
                <span>Progress</span>
                <span class="font-semibold tabular-nums text-ink-800">60%</span>
              </div>
              <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-ink-100 dark:!bg-white/[0.06]">
                <div class="h-full w-[60%] rounded-full bg-gradient-to-r from-brand-500 to-accent-500"></div>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>

    <!-- Sidebar tips -->
    <aside class="space-y-4 lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-2xl border border-ink-200/70 bg-gradient-to-br from-brand-50/60 via-white to-accent-50/40 p-5 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
        <div class="flex items-center gap-2 text-brand-700 dark:!text-brand-400">
          <Icon name="sparkles" size={13} />
          <p class="text-[11px] font-bold uppercase tracking-[0.22em]">Tips</p>
        </div>
        <ul class="mt-4 space-y-3">
          {tips.map((t) => (
            <li class="flex items-start gap-2.5 text-[13px] leading-relaxed text-ink-700">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-white text-brand-700 ring-1 ring-ink-200/60 dark:!bg-white/[0.06] dark:!text-brand-400 dark:!ring-white/10">
                <Icon name={t.icon as any} size={12} />
              </span>
              {t.body}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-ink-200/70 bg-white p-5 dark:!border-white/[0.08] dark:!bg-white/[0.03]">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Support</p>
        <p class="mt-3 text-[13px] leading-relaxed text-ink-700">Stuck on a test? Reach out — we forward technical questions to the hiring team.</p>
        <a href="/contact" class="mt-4 inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">
          Contact support
          <Icon name="arrowRight" size={12} />
        </a>
      </div>
    </aside>
  </div>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".asm-tab");
    const cards = document.querySelectorAll<HTMLElement>(".asm-card");
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabs.forEach((b) => (b.dataset.active = String(b === btn)));
        const f = btn.dataset.asmFilter;
        cards.forEach((c) => {
          const s = c.dataset.status ?? "";
          let show = false;
          if (f === "All") show = true;
          else if (f === "Active") show = s === "Not started" || s === "In progress";
          else if (f === "Submitted") show = s === "Submitted";
          else if (f === "Passed") show = s === "Passed";
          c.hidden = !show;
        });
      });
    });
  </script>
</DashboardLayout>

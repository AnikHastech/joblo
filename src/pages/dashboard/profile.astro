---
import DashboardLayout from "@layouts/DashboardLayout.astro";
import Icon from "@components/ui/Icon.astro";
import Badge from "@components/ui/Badge.astro";
import { currentCandidate, experience, education } from "@data/dashboard";
import { getCompany } from "@data/companies";
---
<DashboardLayout
  title="My profile"
  subtitle="This is what recruiters see when they view your public profile."
  active="profile"
>
  <!-- Actions -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2 rounded-full border border-ink-200 bg-white p-1 dark:!border-white/10 dark:!bg-white/[0.04]">
      <button type="button" data-active="true" class="rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-700 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">Preview</button>
      <button type="button" data-active="false" class="rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-500 hover:text-ink-900">Public link</button>
    </div>
    <div class="flex items-center gap-2">
      <a href="/dashboard/profile/edit" class="inline-flex items-center gap-1.5 rounded-full bg-ink-900 px-4 py-2 text-[13px] font-semibold text-ink-50 shadow-sm transition-all hover:bg-brand-600">
        <Icon name="filter" size={12} />
        Edit profile
      </a>
      <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-2 text-[13px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        <Icon name="arrowUpRight" size={12} />
        View public
      </button>
    </div>
  </div>

  <!-- Header card -->
  <div class="rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035]">
    <div class="relative h-32 overflow-hidden rounded-t-3xl bg-gradient-to-br from-brand-500/70 via-accent-400/60 to-brand-600/70">
      <div class="absolute inset-0 bg-grid opacity-25 mix-blend-overlay"></div>
    </div>
    <div class="relative px-6 pb-6 sm:px-10">
      <img src={currentCandidate.avatar} alt={currentCandidate.name} class="-mt-12 h-24 w-24 rounded-2xl bg-white p-1 shadow-sm ring-2 ring-white sm:h-28 sm:w-28 dark:!bg-ink-100 dark:ring-ink-100" />
      <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-[24px] font-semibold tracking-tight text-ink-900 sm:text-[28px]">{currentCandidate.name}</h2>
            <Badge variant="success" size="sm" dot>Verified</Badge>
            <Badge variant="brand" size="sm">{currentCandidate.availability}</Badge>
          </div>
          <p class="mt-1 text-[14px] text-ink-700">{currentCandidate.headline}</p>
          <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12.5px] text-ink-500">
            <span class="inline-flex items-center gap-1.5"><Icon name="mapPin" size={12} /> {currentCandidate.location}</span>
            <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={12} /> {currentCandidate.timezone}</span>
            <span class="inline-flex items-center gap-1.5"><Icon name="wallet" size={12} /> {currentCandidate.desiredSalary}</span>
            {currentCandidate.openToRemote && <span class="inline-flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400"><Icon name="globe" size={12} /> Open to remote</span>}
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a href={currentCandidate.links.website} class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-700 hover:border-ink-400 dark:!border-white/10" aria-label="Website"><Icon name="globe" size={13} /></a>
          <a href={currentCandidate.links.linkedin} class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-700 hover:border-ink-400 dark:!border-white/10" aria-label="LinkedIn"><Icon name="linkedin" size={13} /></a>
          <a href={currentCandidate.links.github} class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-700 hover:border-ink-400 dark:!border-white/10" aria-label="GitHub"><Icon name="github" size={13} /></a>
          <a href={currentCandidate.links.dribbble} class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-700 hover:border-ink-400 dark:!border-white/10" aria-label="Dribbble"><Icon name="dribbble" size={13} /></a>
        </div>
      </div>
    </div>
  </div>

  <!-- Body grid -->
  <div class="mt-6 grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-8 space-y-6">
      <!-- Bio -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">About</p>
        <p class="mt-3 text-[15px] leading-[1.75] text-ink-700">{currentCandidate.bio}</p>
      </section>

      <!-- Experience -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Experience</p>
          <a href="/dashboard/profile/edit" class="text-[12px] font-medium text-brand-700 hover:underline">Edit</a>
        </div>
        <ol class="relative mt-5 space-y-6">
          <span class="absolute left-[19px] top-2 bottom-2 w-px bg-ink-200 dark:!bg-white/10" aria-hidden="true"></span>
          {experience.map((e) => {
            const c = getCompany(`c${["linear","vercel","stripe","figma","notion","supabase","arc","rippling","airbnb","shopify","anthropic","cloudflare"].indexOf(e.companySlug) + 1}`);
            return (
              <li class="relative flex gap-4 pl-1">
                <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-[13px] font-bold text-white ring-4 ring-white dark:!ring-ink-100" style={`background:${c?.brandColor ?? "#111"}`}>{e.company[0]}</span>
                <div class="min-w-0 flex-1 pt-0.5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-[14.5px] font-semibold text-ink-900">{e.role}</p>
                    <p class="text-[12px] tabular-nums text-ink-500">{e.start} — {e.end}</p>
                  </div>
                  <p class="mt-0.5 text-[13px] text-ink-700">{e.company} · {e.location}</p>
                  <p class="mt-2 text-[13.5px] leading-relaxed text-ink-600">{e.summary}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>

      <!-- Education -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Education</p>
          <a href="/dashboard/profile/edit" class="text-[12px] font-medium text-brand-700 hover:underline">Edit</a>
        </div>
        <ul class="mt-5 space-y-4">
          {education.map((e) => (
            <li class="flex gap-4">
              <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-ink-100 text-ink-700 dark:!bg-white/[0.06]"><Icon name="award" size={15} /></span>
              <div>
                <p class="text-[14px] font-semibold text-ink-900">{e.school}</p>
                <p class="mt-0.5 text-[13px] text-ink-700">{e.degree}</p>
                <p class="mt-0.5 text-[11.5px] tabular-nums text-ink-500">{e.start} — {e.end}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="lg:col-span-4 space-y-6">
      <!-- Skills -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Skills</p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {currentCandidate.skills.map((s) => (
            <span class="rounded-full border border-ink-200 bg-white px-3 py-1 text-[12.5px] text-ink-700 dark:!border-white/10 dark:!bg-white/[0.03]">{s}</span>
          ))}
        </div>
      </section>

      <!-- Languages -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Languages</p>
        <ul class="mt-4 space-y-2 text-[13.5px] text-ink-700">
          {currentCandidate.languages.map((l) => (
            <li class="flex items-center gap-2"><Icon name="globe" size={12} class="text-ink-500" />{l}</li>
          ))}
        </ul>
      </section>

      <!-- Contact -->
      <section class="rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-6 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-700 dark:text-brand-400">Contact</p>
        <dl class="mt-4 space-y-3 text-[13px]">
          <div class="flex items-center justify-between gap-3">
            <dt class="inline-flex items-center gap-2 text-ink-500"><Icon name="send" size={13} /> Email</dt>
            <dd class="font-medium text-ink-900">{currentCandidate.email}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="inline-flex items-center gap-2 text-ink-500"><Icon name="bell" size={13} /> Phone</dt>
            <dd class="font-medium text-ink-900 tabular-nums">{currentCandidate.phone}</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</DashboardLayout>

---
import DashboardLayout from "@layouts/DashboardLayout.astro";
import JobCard from "@components/jobs/JobCard.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import Icon from "@components/ui/Icon.astro";
import { savedJobs } from "@data/dashboard";
---
<DashboardLayout
  title="Saved jobs"
  subtitle={`${savedJobs.length} role${savedJobs.length === 1 ? "" : "s"} bookmarked. We'll ping you if any close soon.`}
  active="saved"
>
  <div class="flex items-center justify-between">
    <div class="inline-flex rounded-full border border-ink-200 bg-white p-0.5 dark:!border-white/10 dark:!bg-white/[0.04]" role="group">
      <button type="button" data-saved-filter="all"     data-active="true"  class="saved-tab rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-700 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">All ({savedJobs.length})</button>
      <button type="button" data-saved-filter="applied" data-active="false" class="saved-tab rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-700 hover:text-ink-900">Applied</button>
      <button type="button" data-saved-filter="not"     data-active="false" class="saved-tab rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-700 hover:text-ink-900">Not yet</button>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        <Icon name="filter" size={12} />
        Sort
      </button>
    </div>
  </div>

  {savedJobs.length === 0 ? (
    <div class="mt-8">
      <EmptyState
        icon="bookmark"
        title="No saved jobs yet"
        body="When you find something interesting, tap the bookmark icon on any job card to save it here."
        ctaLabel="Browse jobs"
        ctaHref="/jobs"
      />
    </div>
  ) : (
    <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {savedJobs.map((j, i) => (
        <div class="saved-item" data-status={i % 2 === 0 ? "applied" : "not"}>
          <JobCard job={j} />
        </div>
      ))}
    </div>
  )}

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".saved-tab");
    const items = document.querySelectorAll<HTMLElement>(".saved-item");
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabs.forEach((b) => (b.dataset.active = String(b === btn)));
        const f = btn.dataset.savedFilter;
        items.forEach((it) => { it.hidden = !(f === "all" || it.dataset.status === f); });
      });
    });
  </script>
</DashboardLayout>

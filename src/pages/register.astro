---
import AuthLayout from "@layouts/AuthLayout.astro";
import Icon from "@components/ui/Icon.astro";
---
<AuthLayout
  title="Create account"
  eyebrow="Get started free"
  heading="Create your Joblo account"
  subheading="60 seconds. No credit card. You can upgrade any time."
  aside="candidate"
>
  <!-- Role toggle -->
  <div class="mb-6 grid grid-cols-2 gap-2">
    <label class="cursor-pointer">
      <input type="radio" name="role" value="candidate" checked class="peer sr-only" />
      <div class="rounded-2xl border border-ink-200 bg-white p-4 transition-all peer-checked:border-brand-500 peer-checked:ring-2 peer-checked:ring-brand-200 dark:!border-white/10 dark:!bg-white/[0.04] dark:peer-checked:!ring-brand-500/40">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 text-brand-700 dark:!bg-brand-500/15 dark:!text-brand-400">
          <Icon name="user" size={15} />
        </span>
        <p class="mt-3 text-[13.5px] font-semibold text-ink-900">Find work</p>
        <p class="mt-0.5 text-[11.5px] text-ink-500">Browse jobs, apply, message hiring teams.</p>
      </div>
    </label>
    <label class="cursor-pointer">
      <input type="radio" name="role" value="employer" class="peer sr-only" />
      <div class="rounded-2xl border border-ink-200 bg-white p-4 transition-all peer-checked:border-brand-500 peer-checked:ring-2 peer-checked:ring-brand-200 dark:!border-white/10 dark:!bg-white/[0.04] dark:peer-checked:!ring-brand-500/40">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent-50 text-accent-700 dark:!bg-accent-500/15 dark:!text-accent-400">
          <Icon name="briefcase" size={15} />
        </span>
        <p class="mt-3 text-[13.5px] font-semibold text-ink-900">I'm hiring</p>
        <p class="mt-0.5 text-[11.5px] text-ink-500">Post jobs, manage applicants, hire.</p>
      </div>
    </label>
  </div>

  <!-- Social providers -->
  <div class="grid gap-2 sm:grid-cols-2">
    <button type="button" class="inline-flex h-11 items-center justify-center gap-2 rounded-full border border-ink-200 bg-white text-[13.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
      <span class="flex h-4 w-4 items-center justify-center text-[11px] font-bold text-white bg-black rounded-sm">G</span>
      Sign up with Google
    </button>
    <button type="button" class="inline-flex h-11 items-center justify-center gap-2 rounded-full border border-ink-200 bg-white text-[13.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
      <Icon name="linkedin" size={13} />
      Sign up with LinkedIn
    </button>
  </div>

  <div class="my-6 flex items-center gap-3 text-[11.5px] uppercase tracking-widest text-ink-400">
    <span class="h-px flex-1 bg-ink-200 dark:!bg-white/10"></span>
    or with email
    <span class="h-px flex-1 bg-ink-200 dark:!bg-white/10"></span>
  </div>

  <form class="space-y-4">
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="block">
        <span class="text-[12.5px] font-medium text-ink-700">First name</span>
        <input type="text" required autocomplete="given-name" placeholder="Ada" class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
      </label>
      <label class="block">
        <span class="text-[12.5px] font-medium text-ink-700">Last name</span>
        <input type="text" required autocomplete="family-name" placeholder="Lovelace" class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
      </label>
    </div>
    <label class="block">
      <span class="text-[12.5px] font-medium text-ink-700">Work email</span>
      <input type="email" required autocomplete="email" placeholder="you@work.com" class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
    </label>
    <label class="block">
      <span class="text-[12.5px] font-medium text-ink-700">Password</span>
      <input type="password" required autocomplete="new-password" minlength="8" placeholder="Min. 8 characters" class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
      <div class="mt-2 flex gap-1">
        {["bg-rose-500","bg-amber-500","bg-emerald-500","bg-emerald-600"].map((c, i) => (
          <span class={`h-1 flex-1 rounded-full ${i === 0 ? c : "bg-ink-200 dark:!bg-white/10"}`}></span>
        ))}
      </div>
      <p class="mt-1 text-[11px] text-ink-500">Use a mix of letters, numbers, and symbols.</p>
    </label>

    <label class="flex items-start gap-2 text-[12px] text-ink-600">
      <input type="checkbox" required class="mt-0.5 h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
      I agree to Joblo's <a href="/terms" class="font-semibold text-brand-700 hover:underline">Terms</a> and <a href="/privacy" class="font-semibold text-brand-700 hover:underline">Privacy Policy</a>.
    </label>

    <button type="submit" class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-ink-900 px-6 text-[14.5px] font-semibold text-ink-50 shadow-sm transition-all hover:bg-brand-600 hover:shadow-md">
      Create account
      <Icon name="arrowRight" size={13} class="transition-transform group-hover:translate-x-0.5" />
    </button>
  </form>

  <p class="mt-6 text-center text-[13px] text-ink-500">
    Already have an account? <a href="/login" class="font-semibold text-brand-700 hover:underline">Sign in</a>
  </p>
</AuthLayout>

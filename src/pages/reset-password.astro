---
import AuthLayout from "@layouts/AuthLayout.astro";
import Icon from "@components/ui/Icon.astro";

const rules = [
  "At least 12 characters",
  "One uppercase and one lowercase letter",
  "At least one number and one symbol",
  "Not a password you've used before",
];
---
<AuthLayout
  title="Set a new password"
  eyebrow="Password reset"
  heading="Choose a new password"
  subheading="Almost done. Pick something you'll remember — but not something anyone could guess."
>
  <form class="space-y-4">
    <label class="block">
      <span class="text-[12.5px] font-medium text-ink-700">New password</span>
      <div class="relative mt-1.5">
        <input
          id="new-password"
          type="password"
          required
          autocomplete="new-password"
          placeholder="At least 12 characters"
          class="h-11 w-full rounded-xl border border-ink-200 bg-white pl-3.5 pr-11 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]"
        />
        <button
          type="button"
          data-toggle="new-password"
          class="password-toggle absolute right-1.5 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-900 dark:hover:!bg-white/[0.06]"
          aria-label="Toggle password visibility"
        >
          <Icon name="close" size={13} />
        </button>
      </div>
    </label>

    <!-- Strength meter -->
    <div>
      <div class="flex items-center justify-between text-[11.5px] text-ink-500">
        <span>Strength</span>
        <span id="strength-label" class="font-semibold text-ink-800">—</span>
      </div>
      <div class="mt-1.5 flex gap-1.5">
        <span data-bar="1" class="strength-bar h-1.5 flex-1 rounded-full bg-ink-200 dark:!bg-white/10"></span>
        <span data-bar="2" class="strength-bar h-1.5 flex-1 rounded-full bg-ink-200 dark:!bg-white/10"></span>
        <span data-bar="3" class="strength-bar h-1.5 flex-1 rounded-full bg-ink-200 dark:!bg-white/10"></span>
        <span data-bar="4" class="strength-bar h-1.5 flex-1 rounded-full bg-ink-200 dark:!bg-white/10"></span>
      </div>
    </div>

    <label class="block">
      <span class="text-[12.5px] font-medium text-ink-700">Confirm new password</span>
      <div class="relative mt-1.5">
        <input
          id="confirm-password"
          type="password"
          required
          autocomplete="new-password"
          placeholder="Type it again"
          class="h-11 w-full rounded-xl border border-ink-200 bg-white pl-3.5 pr-11 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]"
        />
        <button
          type="button"
          data-toggle="confirm-password"
          class="password-toggle absolute right-1.5 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-900 dark:hover:!bg-white/[0.06]"
          aria-label="Toggle password visibility"
        >
          <Icon name="close" size={13} />
        </button>
      </div>
      <p id="match-hint" class="mt-1.5 hidden text-[12px] text-rose-600 dark:!text-rose-400">Passwords don't match yet.</p>
    </label>

    <button type="submit" class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-ink-900 px-6 text-[14.5px] font-semibold text-ink-50 shadow-sm transition-all hover:bg-brand-600 hover:shadow-md">
      Save new password
      <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
    </button>
  </form>

  <!-- Requirements -->
  <div class="mt-8 rounded-2xl border border-ink-200/70 bg-ink-50/60 p-5 dark:!border-white/[0.08] dark:!bg-white/[0.02]">
    <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Password requirements</p>
    <ul class="mt-3 space-y-2 text-[13px] text-ink-700">
      {rules.map((r) => (
        <li class="flex items-start gap-2.5">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink-900 text-ink-50 dark:!bg-brand-500 dark:text-white">
            <Icon name="check" size={11} strokeWidth={2.5} />
          </span>
          {r}
        </li>
      ))}
    </ul>
  </div>

  <p class="mt-6 text-center text-[13px] text-ink-500">
    Remember it now?
    <a href="/login" class="font-semibold text-ink-900 hover:text-brand-700 transition-colors">Sign in</a>
  </p>
</AuthLayout>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>(".password-toggle");
  toggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.toggle!;
      const input = document.getElementById(id) as HTMLInputElement | null;
      if (!input) return;
      input.type = input.type === "password" ? "text" : "password";
    });
  });

  const pwd  = document.getElementById("new-password")     as HTMLInputElement | null;
  const cfm  = document.getElementById("confirm-password") as HTMLInputElement | null;
  const bars = document.querySelectorAll<HTMLElement>(".strength-bar");
  const lbl  = document.getElementById("strength-label");
  const hint = document.getElementById("match-hint");

  const scorePassword = (v: string): number => {
    let s = 0;
    if (v.length >= 12) s++;
    if (/[A-Z]/.test(v) && /[a-z]/.test(v)) s++;
    if (/\d/.test(v)) s++;
    if (/[^A-Za-z0-9]/.test(v)) s++;
    return s;
  };
  const labels = ["Too weak", "Weak", "Okay", "Strong", "Excellent"];
  const colors = ["bg-rose-500", "bg-amber-500", "bg-yellow-500", "bg-emerald-500", "bg-emerald-600"];

  const render = () => {
    const s = pwd ? scorePassword(pwd.value) : 0;
    bars.forEach((b, i) => {
      b.className = "strength-bar h-1.5 flex-1 rounded-full " + (i < s ? colors[s] : "bg-ink-200 dark:!bg-white/10");
    });
    if (lbl) lbl.textContent = pwd?.value ? labels[s] : "—";
    if (hint && pwd && cfm) hint.hidden = !cfm.value || cfm.value === pwd.value;
  };
  pwd?.addEventListener("input", render);
  cfm?.addEventListener("input", render);
</script>

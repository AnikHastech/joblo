---
import AuthLayout from "@layouts/AuthLayout.astro";
import Icon from "@components/ui/Icon.astro";
---
<AuthLayout
  title="Reset password"
  eyebrow="Password reset"
  heading="Forgot your password?"
  subheading="Enter the email you signed up with — we'll send a magic link to reset it."
>
  <form class="space-y-4">
    <label class="block">
      <span class="text-[12.5px] font-medium text-ink-700">Email address</span>
      <input
        type="email"
        required
        autocomplete="email"
        placeholder="you@work.com"
        class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]"
      />
    </label>

    <button type="submit" class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-ink-900 px-6 text-[14.5px] font-semibold text-ink-50 shadow-sm transition-all hover:bg-brand-600 hover:shadow-md">
      Send reset link
      <Icon name="send" size={13} class="transition-transform group-hover:translate-x-0.5" />
    </button>
  </form>

  <!-- What to expect -->
  <div class="mt-8 rounded-2xl border border-ink-200/70 bg-ink-50/60 p-5 dark:!border-white/[0.08] dark:!bg-white/[0.02]">
    <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">What happens next</p>
    <ol class="mt-3 space-y-2.5 text-[13px] text-ink-700">
      {[
        "We email you a secure, single-use reset link.",
        "Click the link within 15 minutes to open a reset page.",
        "Choose a new password — you're back in.",
      ].map((s, i) => (
        <li class="flex items-start gap-3">
          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-ink-900 text-[10px] font-bold text-ink-50 tabular-nums dark:!bg-brand-500 dark:text-white">
            {i + 1}
          </span>
          {s}
        </li>
      ))}
    </ol>
  </div>

  <p class="mt-6 text-center text-[13px] text-ink-500">
    Remembered it? <a href="/login" class="font-semibold text-brand-700 hover:underline">Back to sign in</a>
  </p>

  <p class="mt-2 text-center text-[13px] text-ink-500">
    Not signed up yet? <a href="/register" class="font-semibold text-brand-700 hover:underline">Create an account</a>
  </p>
</AuthLayout>

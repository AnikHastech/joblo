---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import JobCard from "@components/jobs/JobCard.astro";
import { categories } from "@data/categories";
import { jobs } from "@data/jobs";
import { getCompany } from "@data/companies";
import { site } from "@data/site";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const catJobs = jobs.filter((j) => j.categorySlug === category.slug);

const companyIds = new Set(catJobs.map((j) => j.companyId));
const remoteCount = catJobs.filter((j) => j.remote).length;
const avgMin = catJobs.length ? Math.round(catJobs.reduce((a, j) => a + j.salaryMin, 0) / catJobs.length / 1000) : 0;
const avgMax = catJobs.length ? Math.round(catJobs.reduce((a, j) => a + j.salaryMax, 0) / catJobs.length / 1000) : 0;

// Related categories (all others, cap 4)
const related = categories.filter((c) => c.slug !== category.slug).slice(0, 4);

// Featured companies in this category (unique)
const featuredCos = Array.from(companyIds).slice(0, 6).map((id) => getCompany(id));
---
<BaseLayout
  title={`${category.name} jobs · ${site.name}`}
  description={`Browse ${catJobs.length} live ${category.name.toLowerCase()} roles from ${companyIds.size} verified companies. Filter by seniority, salary, and location.`}
>
  <!-- Hero -->
  <section class="section-category-hero relative isolate pt-14 pb-14 sm:pt-20 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-25 mask-radial"></div>
      <div
        class="absolute -top-32 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full blur-3xl opacity-40"
        style={`background:${category.gradient}`}
      ></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-ink-50"></div>
    </div>

    <Container size="xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[12.5px] text-ink-500">
        <a href="/" class="hover:text-ink-900 transition-colors">Home</a>
        <Icon name="chevronDown" size={10} class="-rotate-90 text-ink-300" />
        <a href="/categories" class="hover:text-ink-900 transition-colors">Categories</a>
        <Icon name="chevronDown" size={10} class="-rotate-90 text-ink-300" />
        <span class="font-medium text-ink-800">{category.name}</span>
      </nav>

      <div class="mt-8 rounded-3xl border border-ink-200/70 bg-white/80 p-6 backdrop-blur-md shadow-sm dark:!border-white/10 dark:!bg-white/[0.04] sm:p-10">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-8">
            <div class="flex items-start gap-5">
              <span
                class="flex h-20 w-20 shrink-0 items-center justify-center rounded-3xl text-4xl font-semibold text-white shadow-sm ring-1 ring-black/5"
                style={`background:${category.gradient}`}
                aria-hidden="true"
              >
                {category.icon}
              </span>
              <div class="min-w-0 flex-1">
                <SectionEyebrow number="01" label={`Category · ${category.slug}`} />
                <h1 class="mt-3 text-[34px] font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-[46px]">
                  {category.name.split(" ").slice(0, -1).join(" ")}
                  {" "}
                  <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">
                    {category.name.split(" ").slice(-1)}
                  </span>
                </h1>
                <p class="mt-3 max-w-xl text-[15px] text-ink-600">
                  {catJobs.length} live role{catJobs.length === 1 ? "" : "s"} from {companyIds.size} companies. Curated in real time.
                </p>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4">
            <dl class="grid grid-cols-2 divide-x divide-y divide-ink-200 rounded-2xl border border-ink-200/70 bg-white dark:!divide-white/10 dark:!border-white/10 dark:!bg-white/[0.03]">
              <div class="p-4 text-center">
                <dt class="text-[10px] font-semibold uppercase tracking-widest text-ink-500">Live now</dt>
                <dd class="mt-1 text-[20px] font-semibold text-ink-900 tabular-nums">{catJobs.length}</dd>
              </div>
              <div class="p-4 text-center">
                <dt class="text-[10px] font-semibold uppercase tracking-widest text-ink-500">Companies</dt>
                <dd class="mt-1 text-[20px] font-semibold text-ink-900 tabular-nums">{companyIds.size}</dd>
              </div>
              <div class="p-4 text-center">
                <dt class="text-[10px] font-semibold uppercase tracking-widest text-ink-500">Remote</dt>
                <dd class="mt-1 text-[20px] font-semibold text-ink-900 tabular-nums">{remoteCount}</dd>
              </div>
              <div class="p-4 text-center">
                <dt class="text-[10px] font-semibold uppercase tracking-widest text-ink-500">Avg salary</dt>
                <dd class="mt-1 text-[16px] font-semibold text-ink-900 tabular-nums">
                  {catJobs.length ? `$${avgMin}–${avgMax}k` : "—"}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Companies bar -->
  {featuredCos.length > 0 && (
    <section class="pt-8 pb-8 sm:pt-10">
      <Container size="xl">
        <div class="flex flex-wrap items-center gap-4">
          <span class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Hiring in {category.name.toLowerCase()}:</span>
          <div class="flex flex-wrap items-center gap-2">
            {featuredCos.map((c) => (
              <a
                href={`/companies/${c.slug}`}
                class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[13px] font-medium text-ink-800 transition-colors hover:border-ink-400 hover:bg-ink-50 dark:!border-white/10 dark:!bg-white/[0.03]"
              >
                <span
                  class="flex h-5 w-5 items-center justify-center rounded-md text-[10px] font-bold text-white"
                  style={`background:${c.brandColor}`}
                  aria-hidden="true"
                >
                  {c.name[0]}
                </span>
                {c.name}
              </a>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- Jobs list -->
  <section class="pb-16 sm:pb-20">
    <Container size="xl">
      <div class="flex items-end justify-between">
        <div>
          <SectionEyebrow number="02" label="Open roles" />
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">All {category.name.toLowerCase()} jobs</h2>
        </div>
        <a href={`/jobs?category=${category.slug}`} class="hidden text-[13px] font-medium text-brand-700 hover:underline sm:inline-flex items-center gap-1">
          Open in job board <Icon name="arrowUpRight" size={12} />
        </a>
      </div>

      {catJobs.length === 0 ? (
        <div class="mt-10 rounded-3xl border border-dashed border-ink-200 bg-ink-50/40 p-12 text-center dark:!border-white/10 dark:!bg-white/[0.02]">
          <p class="text-[15.5px] font-semibold text-ink-900">No live roles in this category right now</p>
          <p class="mt-2 text-[13.5px] text-ink-500">Set an alert to be notified as soon as one goes live.</p>
        </div>
      ) : (
        <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {catJobs.map((j) => <JobCard job={j} />)}
        </div>
      )}
    </Container>
  </section>

  <!-- Related categories -->
  <section class="pb-24 sm:pb-32">
    <Container size="xl">
      <div class="border-t border-ink-200 pt-14 dark:!border-white/10">
        <SectionEyebrow number="03" label="Explore more" />
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">Related categories</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((r) => (
            <a
              href={`/categories/${r.slug}`}
              class="group flex items-center gap-3 rounded-2xl border border-ink-200/70 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-sm dark:!border-white/[0.08] dark:!bg-white/[0.035]"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-xl text-lg font-semibold text-white ring-1 ring-black/5" style={`background:${r.gradient}`}>{r.icon}</span>
              <div class="min-w-0 flex-1">
                <p class="text-[14px] font-semibold text-ink-900 group-hover:text-brand-700 transition-colors">{r.name}</p>
                <p class="mt-0.5 text-[11.5px] text-ink-500 tabular-nums">{r.openings.toLocaleString()} openings</p>
              </div>
              <Icon name="arrowRight" size={13} class="text-ink-400 transition-transform group-hover:translate-x-0.5" />
            </a>
          ))}
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import Badge from "@components/ui/Badge.astro";
import { candidates } from "@data/candidates";
import { site } from "@data/site";

const availabilityStyle: Record<string, string> = {
  "Open to offers":      "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400",
  "Available in 2 weeks":"bg-amber-100 text-amber-800 dark:!bg-amber-500/15 dark:!text-amber-400",
  "Interviewing":        "bg-violet-100 text-violet-700 dark:!bg-violet-500/15 dark:!text-violet-400",
};

const skillCounts: Record<string, number> = {};
candidates.forEach((c) => c.skills.forEach((s) => { skillCounts[s] = (skillCounts[s] ?? 0) + 1; }));
const topSkills = Object.entries(skillCounts).sort((a,b) => b[1]-a[1]).slice(0, 8).map(([s]) => s);
---
<BaseLayout
  title={`Candidate directory · ${site.name}`}
  description={`Browse ${site.stats.candidates} verified professionals — filter by role, experience, availability, and skills.`}
>
  <!-- Hero -->
  <section class="section-candidates-hero relative isolate pt-14 pb-14 sm:pt-20 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-30 mask-radial"></div>
      <div class="absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-br from-accent-200/40 via-brand-200/30 to-transparent blur-3xl dark:!from-accent-500/15 dark:!via-brand-500/10"></div>
    </div>
    <Container size="xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[12.5px] text-ink-500">
        <a href="/" class="hover:text-ink-900 transition-colors">Home</a>
        <Icon name="chevronDown" size={10} class="-rotate-90 text-ink-300" />
        <span class="font-medium text-ink-800">Candidates</span>
      </nav>
      <div class="mt-6 max-w-3xl">
        <SectionEyebrow number="01" label="Talent directory" />
        <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">
          Meet the <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">people</span> hiring managers want.
        </h1>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-ink-600">
          {site.stats.candidates} verified professionals actively looking. Filter by discipline, experience, and availability — reach out in one click.
        </p>
      </div>

      <div class="mt-8 max-w-xl">
        <div class="relative">
          <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-ink-400"><Icon name="search" size={16} /></span>
          <input id="cand-search" type="search" placeholder="Search by name, role, or skill…" class="h-13 w-full rounded-full border border-ink-200 bg-white pl-13 pr-5 text-[14.5px] text-ink-900 placeholder:text-ink-400 shadow-sm focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="text-[12.5px] uppercase tracking-widest text-ink-500">Trending skills</span>
        {topSkills.map((s) => (
          <button type="button" data-skill={s} class="skill-chip rounded-full border border-ink-200 bg-white/70 px-3 py-1 text-[12.5px] text-ink-700 backdrop-blur transition-colors hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50 dark:!border-white/10 dark:!bg-white/[0.04] dark:text-ink-800">
            {s}
          </button>
        ))}
      </div>
    </Container>
  </section>

  <!-- Grid -->
  <section class="pt-4 pb-24 sm:pb-32">
    <Container size="xl">
      <div class="flex items-center justify-between">
        <p class="text-[14.5px] text-ink-800">
          <span id="cand-count" class="font-semibold tabular-nums text-ink-900">{candidates.length}</span>
          <span class="text-ink-500"> verified candidates</span>
        </p>
      </div>

      <div id="cand-grid" class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {candidates.map((c) => (
          <article
            class="cand-item group relative flex flex-col rounded-3xl border border-ink-200/70 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:!border-white/[0.08] dark:!bg-white/[0.035]"
            data-name={c.name.toLowerCase()}
            data-role={c.role.toLowerCase()}
            data-skills={c.skills.join(" ").toLowerCase()}
          >
            <header class="flex items-start gap-4">
              <img src={c.avatar} alt={c.name} width="56" height="56" class="h-14 w-14 shrink-0 rounded-2xl bg-ink-100 ring-1 ring-ink-200 dark:ring-white/10" />
              <div class="min-w-0 flex-1">
                <a href={`/candidates/${c.slug}`} class="line-clamp-1 text-[16px] font-semibold text-ink-900 hover:text-brand-700 transition-colors">{c.name}</a>
                <p class="mt-0.5 text-[12.5px] text-ink-500 line-clamp-1">{c.role}</p>
                {c.verified && (
                  <span class="mt-1.5 inline-flex items-center gap-1 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400">
                    <Icon name="checkCircle" size={9} strokeWidth={2.5} /> Verified
                  </span>
                )}
              </div>
            </header>

            <p class={`mt-4 inline-flex items-center gap-1.5 self-start rounded-full px-2.5 py-1 text-[11.5px] font-semibold ${availabilityStyle[c.availability]}`}>
              <span class="h-1.5 w-1.5 rounded-full bg-current opacity-60"></span>
              {c.availability}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {c.skills.slice(0, 4).map((s) => (
                <span class="rounded-full border border-ink-200 bg-white px-2.5 py-0.5 text-[11px] text-ink-700 dark:!border-white/10 dark:!bg-white/[0.03]">{s}</span>
              ))}
            </div>

            <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-ink-100 pt-4 text-[12.5px] dark:!border-white/[0.06]">
              <div>
                <dt class="text-[10px] uppercase tracking-widest text-ink-400">Experience</dt>
                <dd class="mt-0.5 font-semibold text-ink-900 tabular-nums">{c.experienceYears}y</dd>
              </div>
              <div>
                <dt class="text-[10px] uppercase tracking-widest text-ink-400">Rate</dt>
                <dd class="mt-0.5 font-semibold text-ink-900 tabular-nums">{c.rate}</dd>
              </div>
              <div>
                <dt class="text-[10px] uppercase tracking-widest text-ink-400">Based in</dt>
                <dd class="mt-0.5 truncate font-medium text-ink-800">{c.location.split(",")[0]}</dd>
              </div>
            </dl>

            <footer class="mt-5 flex items-center gap-2">
              <a href={`/candidates/${c.slug}`} class="inline-flex h-10 flex-1 items-center justify-center gap-1.5 rounded-full bg-ink-900 px-3 text-[13px] font-semibold text-ink-50 hover:bg-brand-600">
                View profile
                <Icon name="arrowRight" size={12} />
              </a>
              <button type="button" class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-500 hover:border-ink-400 hover:text-ink-900 dark:!border-white/10" aria-label={`Save ${c.name}`}>
                <Icon name="bookmark" size={13} />
              </button>
            </footer>
          </article>
        ))}
      </div>

      <div id="cand-empty" hidden class="mt-10">
        <EmptyState icon="users" title="No candidates match your search" body="Try broader keywords or clear the search." />
      </div>

      <!-- Pagination -->
      <nav id="cand-pagination" aria-label="Pagination" class="mt-12 flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
        <p class="text-[12.5px] text-ink-500 tabular-nums">
          Showing <span id="cand-range" class="font-semibold text-ink-900">1–6</span>
          of <span id="cand-total" class="font-semibold text-ink-900">0</span>
        </p>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="cand-prev"
            class="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3.5 text-[13px] font-medium text-ink-800 transition-colors hover:border-ink-400 hover:bg-ink-50 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-ink-200 disabled:hover:bg-white dark:!border-white/10 dark:!bg-white/[0.03] dark:hover:!bg-white/[0.06]"
          >
            <Icon name="chevronDown" size={12} class="rotate-90" />
            Prev
          </button>
          <div id="cand-pages" class="flex items-center gap-1"></div>
          <button
            type="button"
            id="cand-next"
            class="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3.5 text-[13px] font-medium text-ink-800 transition-colors hover:border-ink-400 hover:bg-ink-50 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-ink-200 disabled:hover:bg-white dark:!border-white/10 dark:!bg-white/[0.03] dark:hover:!bg-white/[0.06]"
          >
            Next
            <Icon name="chevronDown" size={12} class="-rotate-90" />
          </button>
        </div>
      </nav>
    </Container>
  </section>
</BaseLayout>

<script>
  const search = document.getElementById("cand-search") as HTMLInputElement | null;
  const skills = document.querySelectorAll<HTMLButtonElement>(".skill-chip");
  const items  = Array.from(document.querySelectorAll<HTMLElement>(".cand-item"));
  const empty  = document.getElementById("cand-empty");
  const count  = document.getElementById("cand-count");
  const pagNav   = document.getElementById("cand-pagination");
  const pagPages = document.getElementById("cand-pages");
  const pagPrev  = document.getElementById("cand-prev") as HTMLButtonElement | null;
  const pagNext  = document.getElementById("cand-next") as HTMLButtonElement | null;
  const pagRange = document.getElementById("cand-range");
  const pagTotal = document.getElementById("cand-total");

  const PAGE_SIZE = 6;
  let skillFilter = "";
  let page = 1;

  const getVisible = () => {
    const q = (search?.value ?? "").toLowerCase().trim();
    return items.filter((el) => {
      const hay = `${el.dataset.name} ${el.dataset.role} ${el.dataset.skills}`;
      const qOk = !q || hay.includes(q);
      const sOk = !skillFilter || (el.dataset.skills ?? "").includes(skillFilter.toLowerCase());
      return qOk && sOk;
    });
  };

  const renderPages = (totalPages: number) => {
    if (!pagPages) return;
    pagPages.innerHTML = "";
    if (totalPages <= 1) return;
    for (let p = 1; p <= totalPages; p++) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = String(p);
      btn.className = "flex h-10 min-w-10 items-center justify-center rounded-full px-3 text-[13px] font-semibold tabular-nums transition-colors " + (
        p === page
          ? "bg-ink-900 text-ink-50 dark:!bg-brand-500 dark:!text-white"
          : "border border-ink-200 bg-white text-ink-800 hover:border-ink-400 hover:bg-ink-50 dark:!border-white/10 dark:!bg-white/[0.03] dark:hover:!bg-white/[0.06]"
      );
      btn.addEventListener("click", () => { page = p; apply(); });
      pagPages.appendChild(btn);
    }
  };

  const apply = () => {
    const visible = getVisible();
    const total = visible.length;
    const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (page > totalPages) page = totalPages;
    if (page < 1) page = 1;

    // Hide all, then show the current page slice
    items.forEach((el) => (el.hidden = true));
    const start = (page - 1) * PAGE_SIZE;
    const end   = start + PAGE_SIZE;
    visible.slice(start, end).forEach((el) => (el.hidden = false));

    if (count) count.textContent = String(total);
    if (empty) empty.hidden = total !== 0;

    // Pagination state
    if (pagNav) pagNav.hidden = total <= PAGE_SIZE;
    if (pagPrev) pagPrev.disabled = page <= 1;
    if (pagNext) pagNext.disabled = page >= totalPages;
    if (pagRange) pagRange.textContent = total === 0 ? "0" : `${start + 1}–${Math.min(end, total)}`;
    if (pagTotal) pagTotal.textContent = String(total);
    renderPages(totalPages);
  };

  search?.addEventListener("input", () => { page = 1; apply(); });
  skills.forEach((b) => {
    b.addEventListener("click", () => {
      const s = b.dataset.skill ?? "";
      skillFilter = skillFilter === s ? "" : s;
      skills.forEach((x) => x.classList.toggle("!bg-ink-900", x.dataset.skill === skillFilter && !!skillFilter));
      skills.forEach((x) => x.classList.toggle("!text-ink-50", x.dataset.skill === skillFilter && !!skillFilter));
      page = 1;
      apply();
    });
  });
  pagPrev?.addEventListener("click", () => { page--; apply(); window.scrollTo({ top: (document.getElementById("cand-grid")?.offsetTop ?? 0) - 96, behavior: "smooth" }); });
  pagNext?.addEventListener("click", () => { page++; apply(); window.scrollTo({ top: (document.getElementById("cand-grid")?.offsetTop ?? 0) - 96, behavior: "smooth" }); });

  apply();
</script>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import { site } from "@data/site";

const offices = [
  { city: "San Francisco", country: "USA",       address: "Pier 27, San Francisco, CA 94111",   timezone: "PT · UTC-8",  role: "Global HQ" },
  { city: "London",        country: "UK",        address: "60 Great Portland St, London W1W 7RT", timezone: "GMT · UTC+0", role: "EMEA" },
  { city: "Singapore",     country: "Singapore", address: "18 Robinson Road, #12-01, S 048547",  timezone: "SGT · UTC+8", role: "APAC" },
];

const channels = [
  { icon: "send",     label: "General inquiries", value: site.email,                 href: `mailto:${site.email}` },
  { icon: "briefcase",label: "Sales & pricing",   value: "sales@joblo.com",          href: "mailto:sales@joblo.com" },
  { icon: "shield",   label: "Support",           value: "help@joblo.com",           href: "mailto:help@joblo.com" },
  { icon: "users",    label: "Press & partnerships", value: "press@joblo.com",        href: "mailto:press@joblo.com" },
];

const faqs = [
  { q: "How fast do you reply?",                a: "Business hours in your timezone — usually within 4 hours, always within one business day." },
  { q: "Can I book a demo?",                    a: "Yes. Use the form or email sales@joblo.com — 30-minute walkthrough, no slides." },
  { q: "Do you offer startup / non-profit pricing?", a: "40% off for pre-seed / seed and 50% off for verified non-profits. Mention it in your message." },
  { q: "How is my data handled?",               a: "SOC 2 Type II, GDPR-compliant, and we never sell your data. Full policy at /privacy." },
];
---
<BaseLayout
  title={`Contact · ${site.name}`}
  description="Get in touch with the Joblo team — sales, support, partnerships, or general inquiries. Real people, quick replies."
>
  <!-- Hero -->
  <section class="section-contact-hero relative isolate pt-14 pb-8 sm:pt-20">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-30 mask-radial"></div>
      <div class="absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-gradient-to-br from-brand-200/40 via-accent-200/30 to-transparent blur-3xl dark:!from-brand-500/15 dark:!via-accent-500/10"></div>
    </div>
    <Container size="xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[12.5px] text-ink-500">
        <a href="/" class="hover:text-ink-900 transition-colors">Home</a>
        <Icon name="chevronDown" size={10} class="-rotate-90 text-ink-300" />
        <span class="font-medium text-ink-800">Contact</span>
      </nav>
      <div class="mt-6 max-w-3xl">
        <SectionEyebrow number="01" label="Get in touch" />
        <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">
          Say <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">hello</span>.
        </h1>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-ink-600">
          Real people, quick replies. Whether it's sales, support, or a partnership idea — we'd love to hear from you.
        </p>
      </div>
    </Container>
  </section>

  <!-- Form + channels -->
  <section class="pb-16 sm:pb-20">
    <Container size="xl">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Form -->
        <div class="lg:col-span-7">
          <form class="rounded-3xl border border-ink-200/70 bg-white p-6 sm:p-10 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Send us a message</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">Tell us what you need.</h2>

            <div class="mt-8 grid gap-5 sm:grid-cols-2">
              <label class="block">
                <span class="text-[12.5px] font-medium text-ink-700">Full name</span>
                <input type="text" required placeholder="Ada Lovelace" class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
              </label>
              <label class="block">
                <span class="text-[12.5px] font-medium text-ink-700">Work email</span>
                <input type="email" required placeholder="you@company.com" class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
              </label>
              <label class="block">
                <span class="text-[12.5px] font-medium text-ink-700">Company (optional)</span>
                <input type="text" placeholder="Acme Inc." class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
              </label>
              <label class="block">
                <span class="text-[12.5px] font-medium text-ink-700">Topic</span>
                <select class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]">
                  <option>Sales</option>
                  <option>Support</option>
                  <option>Partnerships</option>
                  <option>Press</option>
                  <option>Something else</option>
                </select>
              </label>
            </div>

            <label class="mt-5 block">
              <span class="text-[12.5px] font-medium text-ink-700">How can we help?</span>
              <textarea rows="5" required placeholder="A short description helps us route your message to the right person…" class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white px-3.5 py-2.5 text-[14px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]"></textarea>
            </label>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
              <label class="inline-flex items-center gap-2 text-[12.5px] text-ink-500">
                <input type="checkbox" class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
                Subscribe to our monthly newsletter
              </label>
              <button type="submit" class="group inline-flex h-12 items-center gap-2 rounded-full bg-ink-900 px-6 text-[14px] font-semibold text-ink-50 shadow-sm transition-all hover:bg-brand-600 hover:shadow-md">
                Send message
                <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
              </button>
            </div>
          </form>
        </div>

        <!-- Channels + response -->
        <div class="lg:col-span-5">
          <div class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Direct channels</p>
            <ul class="mt-5 space-y-3">
              {channels.map((c) => (
                <li>
                  <a href={c.href} class="group flex items-start gap-3 rounded-2xl border border-ink-200/70 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-sm dark:!border-white/[0.08] dark:!bg-white/[0.02]">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-accent-50 text-brand-700 ring-1 ring-brand-100/50 dark:!from-brand-500/10 dark:!to-accent-500/10 dark:ring-white/10 dark:text-brand-400">
                      <Icon name={c.icon as any} size={15} />
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="text-[13.5px] font-semibold text-ink-900">{c.label}</p>
                      <p class="mt-0.5 text-[13px] text-brand-700 group-hover:underline">{c.value}</p>
                    </div>
                    <Icon name="arrowUpRight" size={13} class="text-ink-400 transition-transform group-hover:translate-x-0.5" />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-6 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
            <div class="flex items-center gap-2 text-brand-700 dark:text-brand-400">
              <Icon name="livePulse" size={14} />
              <p class="text-[11px] font-semibold uppercase tracking-[0.22em]">Response time</p>
            </div>
            <p class="mt-3 text-[14.5px] leading-relaxed text-ink-800">
              Median reply time this week: <span class="font-semibold text-ink-900">2h 14m</span>. Always within one business day.
            </p>
            <p class="mt-1 text-[12.5px] text-ink-500">A real person on the sales, support, or founders' team — never a bot.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Offices -->
  <section class="pb-16 sm:pb-20">
    <Container size="xl">
      <SectionEyebrow number="02" label="Where we are" />
      <h2 class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-4xl">
        Three offices, <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">one team</span>
      </h2>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {offices.map((o) => (
          <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-ink-200/70 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:!border-white/[0.08] dark:!bg-white/[0.035]">
            <div class="flex items-center justify-between">
              <span class="text-[10.5px] font-semibold uppercase tracking-widest text-ink-500">{o.role}</span>
              <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[10.5px] font-medium tabular-nums text-ink-600 dark:!bg-white/[0.06] dark:text-ink-700">{o.timezone}</span>
            </div>
            <h3 class="mt-4 text-[22px] font-semibold tracking-tight text-ink-900">{o.city}</h3>
            <p class="mt-0.5 text-[13px] text-ink-500">{o.country}</p>
            <p class="mt-5 text-[13.5px] leading-relaxed text-ink-700">{o.address}</p>
            <a href={`https://maps.google.com/?q=${encodeURIComponent(o.address)}`} target="_blank" rel="noreferrer" class="mt-auto pt-5 inline-flex items-center gap-1.5 text-[13px] font-medium text-brand-700 hover:underline">
              Get directions
              <Icon name="arrowUpRight" size={12} />
            </a>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- FAQ -->
  <section class="pb-24 sm:pb-32">
    <Container size="xl">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16">
        <div class="lg:sticky lg:top-24 lg:col-span-5">
          <SectionEyebrow number="03" label="FAQ" />
          <h2 class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-4xl">
            Common <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">questions</span>
          </h2>
          <p class="mt-4 text-[14.5px] text-ink-600">If your question isn't here, use the form — we'll get back to you personally.</p>
        </div>
        <div class="lg:col-span-7">
          <ul id="contact-faq-list" class="space-y-3">
            {faqs.map((f, i) => (
              <li>
                <details open={i === 0} class="contact-faq-details group rounded-2xl border border-ink-200/70 bg-white transition-colors open:border-ink-300 dark:!border-white/[0.08] dark:!bg-white/[0.035] dark:open:!border-brand-500/40">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 list-none p-5 select-none">
                    <span class="text-[14.5px] font-semibold text-ink-900">{f.q}</span>
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-100 text-ink-700 transition-transform group-open:rotate-45 dark:!bg-white/[0.06]">
                      <Icon name="plus" size={12} strokeWidth={2.2} />
                    </span>
                  </summary>
                  <div class="contact-faq-body grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
                    <div class="overflow-hidden">
                      <div class="px-5 pb-5">
                        <p class="text-[14px] leading-relaxed text-ink-600 border-l-2 border-ink-200 pl-3 dark:!border-white/10">{f.a}</p>
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <script>
    const all = document.querySelectorAll<HTMLDetailsElement>("#contact-faq-list details");
    all.forEach((d) => {
      const body = d.querySelector<HTMLElement>(".contact-faq-body");
      if (d.open && body) body.style.gridTemplateRows = "1fr";
    });
    const openIt = (d: HTMLDetailsElement) => {
      const body = d.querySelector<HTMLElement>(".contact-faq-body");
      if (!body) return;
      d.open = true;
      requestAnimationFrame(() => { body.style.gridTemplateRows = "1fr"; });
    };
    const closeIt = (d: HTMLDetailsElement) => {
      const body = d.querySelector<HTMLElement>(".contact-faq-body");
      if (!body) return;
      body.style.gridTemplateRows = "0fr";
      window.setTimeout(() => { d.open = false; }, 320);
    };
    all.forEach((d) => {
      d.querySelector<HTMLElement>("summary")?.addEventListener("click", (e) => {
        e.preventDefault();
        if (d.open) return;
        all.forEach((other) => { if (other !== d && other.open) closeIt(other); });
        openIt(d);
      });
    });
  </script>
</BaseLayout>

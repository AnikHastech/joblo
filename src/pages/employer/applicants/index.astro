---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import ApplicantStatusPill from "@components/employer/ApplicantStatusPill.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import Icon from "@components/ui/Icon.astro";
import { applicants, applicantWithData, pipelineStages } from "@data/employer";

const rows = applicants
  .slice()
  .sort((a, b) => a.daysAgo - b.daysAgo)
  .map(applicantWithData);

const countBy = (s: string) => applicants.filter((a) => a.status === s).length;
---
<EmployerLayout
  title="Applicants"
  subtitle={`${applicants.length} total · ${countBy("Shortlisted")} shortlisted · ${countBy("Interview")} in interview`}
  active="applicants"
>
  <!-- Pipeline strip -->
  <section class="mb-6">
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {pipelineStages.map((stage) => (
        <a href={`?stage=${stage}`} class="rounded-2xl border border-ink-200/70 bg-white p-4 transition-colors hover:border-ink-300 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
          <ApplicantStatusPill status={stage} />
          <p class="mt-3 text-[22px] font-semibold tracking-tight text-ink-900 tabular-nums">{countBy(stage)}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Filter / toolbar -->
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="inline-flex flex-wrap gap-1 rounded-full border border-ink-200 bg-white p-0.5 dark:!border-white/10 dark:!bg-white/[0.04]" role="group">
      <button type="button" data-filter="all" data-active="true" class="app-filter rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-700 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">All</button>
      {pipelineStages.filter((s) => s !== "Rejected").map((stage) => (
        <button type="button" data-filter={stage} data-active="false" class="app-filter rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-500 hover:text-ink-900 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">{stage}</button>
      ))}
    </div>
    <div class="flex items-center gap-2">
      <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        <Icon name="filter" size={12} /> Filter
      </button>
      <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        Sort · Newest
      </button>
    </div>
  </div>

  <!-- Table -->
  <div class="rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035]">
    {rows.length === 0 ? (
      <div class="p-10"><EmptyState icon="users" title="No applicants yet" body="Once someone applies to your open roles, they'll show up here." /></div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full min-w-[900px] text-left text-[13.5px]">
          <thead>
            <tr class="text-[11px] font-bold uppercase tracking-widest text-ink-500">
              <th class="px-6 py-3.5">Candidate</th>
              <th class="px-4 py-3.5">Applied for</th>
              <th class="px-4 py-3.5">Status</th>
              <th class="px-4 py-3.5 text-center">Match</th>
              <th class="px-4 py-3.5">Applied</th>
              <th class="px-6 py-3.5 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="app-rows">
            {rows.map(({ applicant, candidate, job }) => candidate && job && (
              <tr class="app-row border-t border-ink-100 transition-colors hover:bg-ink-50/40 dark:!border-white/[0.06] dark:hover:!bg-white/[0.02]" data-status={applicant.status}>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <img src={candidate.avatar} alt={candidate.name} class="h-9 w-9 shrink-0 rounded-xl bg-ink-100 ring-1 ring-ink-200 dark:ring-white/10" />
                    <div class="min-w-0">
                      <a href={`/employer/applicants/${applicant.id}`} class="line-clamp-1 text-[14px] font-semibold text-ink-900 hover:text-brand-700 transition-colors">{candidate.name}</a>
                      <p class="mt-0.5 text-[12px] text-ink-500 line-clamp-1">{candidate.role} · {candidate.location}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4">
                  <p class="text-[13px] font-medium text-ink-800 line-clamp-1">{job.title}</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-500">{job.type}</p>
                </td>
                <td class="px-4 py-4"><ApplicantStatusPill status={applicant.status} /></td>
                <td class="px-4 py-4 text-center">
                  <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11.5px] font-semibold tabular-nums ${applicant.matchScore >= 85 ? "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:text-emerald-400" : applicant.matchScore >= 70 ? "bg-amber-100 text-amber-800 dark:!bg-amber-500/15 dark:text-amber-400" : "bg-ink-100 text-ink-700 dark:!bg-white/[0.08]"}`}>
                    {applicant.matchScore}%
                  </span>
                </td>
                <td class="px-4 py-4 text-ink-500 tabular-nums">{applicant.appliedOn}</td>
                <td class="px-6 py-4 text-right">
                  <a href={`/employer/applicants/${applicant.id}`} class="inline-flex h-8 items-center gap-1 rounded-full border border-ink-200 bg-white px-3 text-[12px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">
                    Review <Icon name="arrowUpRight" size={11} />
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</EmployerLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".app-filter");
  const rows = document.querySelectorAll<HTMLTableRowElement>(".app-row");
  btns.forEach((b) => {
    b.addEventListener("click", () => {
      btns.forEach((x) => (x.dataset.active = String(x === b)));
      const f = b.dataset.filter;
      rows.forEach((r) => {
        r.hidden = f !== "all" && r.dataset.status !== f;
      });
    });
  });
</script>

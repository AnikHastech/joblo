---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import Icon from "@components/ui/Icon.astro";
import CompanyMark from "@components/common/CompanyMark.astro";
import { currentEmployer } from "@data/employer";
import { getCompany } from "@data/companies";
import { getCompanyContent } from "@data/companyContent";

const company = getCompany(currentEmployer.companyId);
const content = getCompanyContent(company);
---
<EmployerLayout
  title="Company profile"
  subtitle="What candidates see when they view your company page."
  active="company"
>
  <!-- Preview / Publish bar -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-ink-200/70 bg-white p-3 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
    <div class="flex items-center gap-3">
      <CompanyMark slug={company.slug} size="sm" brandColor={company.brandColor} logo={company.logo} />
      <div>
        <p class="text-[13.5px] font-semibold text-ink-900">{company.name}</p>
        <p class="text-[11.5px] text-ink-500">Last published Feb 12, 2026</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <a href={`/companies/${company.slug}`} class="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 text-[13px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        <Icon name="arrowUpRight" size={12} /> View public
      </a>
      <button type="submit" class="inline-flex h-10 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[13px] font-semibold text-ink-50 hover:bg-brand-600">
        Save & publish <Icon name="check" size={12} strokeWidth={2.5} />
      </button>
    </div>
  </div>

  <form class="grid gap-6 lg:grid-cols-12">
    <!-- Left: form -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Basics -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 sm:p-8 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">01 · Basics</p>
        <h2 class="mt-1 text-[20px] font-semibold tracking-tight text-ink-900">Identity</h2>

        <!-- Cover + logo -->
        <div class="mt-6 relative h-32 overflow-hidden rounded-2xl bg-gradient-to-br from-brand-500/60 via-accent-400/50 to-brand-600/60">
          <button type="button" class="absolute right-3 top-3 inline-flex h-9 items-center gap-1.5 rounded-full bg-white/90 px-3 text-[12px] font-semibold text-ink-800 backdrop-blur hover:bg-white">
            <Icon name="plus" size={11} /> Change cover
          </button>
        </div>
        <div class="-mt-8 flex items-end gap-4 px-4">
          <CompanyMark slug={company.slug} size="lg" brandColor={company.brandColor} logo={company.logo} class="ring-4 ring-white dark:!ring-ink-100" />
          <button type="button" class="mb-2 inline-flex h-9 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 text-[12px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
            <Icon name="plus" size={11} /> Upload logo
          </button>
        </div>

        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-[12.5px] font-medium text-ink-700">Company name</span>
            <input type="text" value={company.name} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </label>
          <label class="block">
            <span class="text-[12.5px] font-medium text-ink-700">Website</span>
            <input type="url" value={content.website} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </label>
          <label class="sm:col-span-2 block">
            <span class="text-[12.5px] font-medium text-ink-700">Tagline</span>
            <input type="text" value={content.tagline} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </label>
          <label class="block">
            <span class="text-[12.5px] font-medium text-ink-700">Industry</span>
            <input type="text" value={company.industry} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </label>
          <label class="block">
            <span class="text-[12.5px] font-medium text-ink-700">Team size</span>
            <select class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]">
              {["1-10","11-50","51-200","201-500","501-1000","1001-5000","5000+"].map((s) => (
                <option selected={s === company.size}>{s}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-[12.5px] font-medium text-ink-700">Headquarters</span>
            <input type="text" value={company.location} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </label>
          <label class="block">
            <span class="text-[12.5px] font-medium text-ink-700">Founded</span>
            <input type="text" value={content.founded} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </label>
        </div>
      </section>

      <!-- About -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 sm:p-8 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">02 · About</p>
        <h2 class="mt-1 text-[20px] font-semibold tracking-tight text-ink-900">Story & mission</h2>
        <label class="mt-5 block">
          <span class="text-[12.5px] font-medium text-ink-700">Short description (shown in listings)</span>
          <input type="text" value={company.description} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
        </label>
        <label class="mt-5 block">
          <span class="text-[12.5px] font-medium text-ink-700">About (long form)</span>
          <textarea rows="6" class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white px-3.5 py-2.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]">{content.about.join("\n\n")}</textarea>
        </label>
        <label class="mt-5 block">
          <span class="text-[12.5px] font-medium text-ink-700">Mission statement</span>
          <input type="text" value={content.mission} class="mt-1.5 h-11 w-full rounded-xl border border-ink-200 bg-white px-3.5 text-[14px] text-ink-900 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
        </label>
      </section>

      <!-- Perks -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 sm:p-8 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">03 · Perks</p>
        <h2 class="mt-1 text-[20px] font-semibold tracking-tight text-ink-900">Benefits candidates see</h2>
        <div class="mt-5 grid gap-2.5 sm:grid-cols-2">
          {content.perks.map((p) => (
            <label class="flex items-center gap-3 rounded-xl border border-ink-200 p-3 hover:border-ink-300 dark:!border-white/10">
              <input type="checkbox" checked class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
              <Icon name={p.icon as any} size={14} class="text-brand-600 dark:text-brand-400" />
              <input type="text" value={p.label} class="flex-1 border-0 bg-transparent p-0 text-[13.5px] text-ink-800 focus:outline-none" />
            </label>
          ))}
        </div>
      </section>
    </div>

    <!-- Right: preview + tips -->
    <aside class="lg:col-span-4 space-y-6">
      <div class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035] lg:sticky lg:top-24">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Public preview</p>
        <div class="mt-4 overflow-hidden rounded-2xl border border-ink-200 dark:!border-white/10">
          <div class="relative h-16 bg-gradient-to-br from-brand-500/60 via-accent-400/50 to-brand-600/60"></div>
          <div class="p-4">
            <div class="-mt-8 flex items-end gap-3">
              <CompanyMark slug={company.slug} size="md" brandColor={company.brandColor} logo={company.logo} class="ring-2 ring-white dark:!ring-ink-100" />
            </div>
            <p class="mt-3 text-[14px] font-semibold text-ink-900">{company.name}</p>
            <p class="mt-0.5 text-[11.5px] text-ink-500">{company.industry} · {company.size}</p>
            <p class="mt-3 text-[12px] text-ink-600 line-clamp-3">{company.description}</p>
          </div>
        </div>
        <a href={`/companies/${company.slug}`} class="mt-4 inline-flex w-full items-center justify-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-2.5 text-[13px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10">
          Open full preview <Icon name="arrowUpRight" size={12} />
        </a>
      </div>
    </aside>
  </form>
</EmployerLayout>

---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import Icon from "@components/ui/Icon.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import { candidates } from "@data/candidates";

// Match scores fabricated deterministically per candidate slug
const withMatch = candidates.map((c) => ({
  ...c,
  matchScore: 70 + ((c.id.charCodeAt(5) * 3) % 25),
}));

const availabilityStyle: Record<string, string> = {
  "Open to offers":       "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400",
  "Available in 2 weeks": "bg-amber-100 text-amber-800 dark:!bg-amber-500/15 dark:!text-amber-400",
  "Interviewing":         "bg-violet-100 text-violet-700 dark:!bg-violet-500/15 dark:!text-violet-400",
};

const skillTags = Array.from(new Set(candidates.flatMap((c) => c.skills))).slice(0, 12);
---
<EmployerLayout
  title="Talent search"
  subtitle={`${candidates.length} candidates matched to your open roles at Linear · updated hourly`}
  active="talent"
>
  <div class="grid gap-6 lg:grid-cols-12">
    <!-- Filter sidebar -->
    <aside class="lg:col-span-3 space-y-4">
      <section class="rounded-3xl border border-ink-200/70 bg-white p-5 dark:!border-white/[0.08] dark:!bg-white/[0.035] lg:sticky lg:top-24">
        <div class="flex items-center justify-between">
          <p class="flex items-center gap-1.5 text-[13px] font-bold uppercase tracking-widest text-ink-800">
            <Icon name="filter" size={13} class="text-ink-500" /> Filters
          </p>
          <button type="button" class="text-[11.5px] font-medium text-ink-500 hover:text-ink-900">Reset</button>
        </div>

        <!-- Search -->
        <div class="mt-5">
          <label class="block">
            <span class="text-[11px] font-bold uppercase tracking-widest text-ink-500">Keyword</span>
            <div class="relative mt-2">
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-400"><Icon name="search" size={12} /></span>
              <input id="talent-q" type="search" placeholder="Role, name, or skill" class="h-10 w-full rounded-full border border-ink-200 bg-white pl-9 pr-3 text-[12.5px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
            </div>
          </label>
        </div>

        <!-- Availability -->
        <div class="mt-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ink-500">Availability</p>
          <div class="mt-3 space-y-2 text-[13px]">
            {["Open to offers","Available in 2 weeks","Interviewing"].map((a) => (
              <label class="flex items-center gap-2.5">
                <input type="checkbox" checked class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
                <span class="text-ink-800">{a}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Experience -->
        <div class="mt-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ink-500">Experience</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {["Entry","Mid","Senior","Lead","10y+"].map((e) => (
              <label class="cursor-pointer">
                <input type="checkbox" class="peer sr-only" />
                <span class="inline-flex items-center rounded-full border border-ink-200 bg-white px-2.5 py-1 text-[12px] text-ink-700 peer-checked:!border-brand-600 peer-checked:!bg-brand-50 peer-checked:!text-brand-700 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">{e}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Skills -->
        <div class="mt-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ink-500">Skills</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {skillTags.map((s) => (
              <label class="cursor-pointer">
                <input type="checkbox" class="peer sr-only" />
                <span class="inline-flex items-center rounded-full border border-ink-200 bg-white px-2.5 py-1 text-[12px] text-ink-700 peer-checked:!border-brand-600 peer-checked:!bg-brand-50 peer-checked:!text-brand-700 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">{s}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Min match -->
        <div class="mt-6">
          <div class="flex items-center justify-between">
            <p class="text-[11px] font-bold uppercase tracking-widest text-ink-500">Min match</p>
            <span class="text-[12px] tabular-nums text-ink-700">80%</span>
          </div>
          <input type="range" min="0" max="100" value="80" class="mt-3 w-full accent-brand-600" />
        </div>
      </section>
    </aside>

    <!-- Results -->
    <div class="lg:col-span-9">
      <!-- Toolbar -->
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-[13.5px] text-ink-800">
          <span id="talent-count" class="font-semibold tabular-nums text-ink-900">{withMatch.length}</span>
          <span class="text-ink-500"> matches · sorted by relevance</span>
        </p>
        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
            Save this search
          </button>
          <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
            Sort · Match ↑
          </button>
        </div>
      </div>

      {withMatch.length === 0 ? (
        <EmptyState icon="users" title="No matches yet" body="Broaden your filters or invite specific candidates to apply." />
      ) : (
        <div id="talent-grid" class="grid gap-4 md:grid-cols-2">
          {withMatch.sort((a, b) => b.matchScore - a.matchScore).map((c) => (
            <article class="talent-item group relative flex flex-col rounded-2xl border border-ink-200/70 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-sm dark:!border-white/[0.08] dark:!bg-white/[0.035]" data-name={c.name.toLowerCase()} data-skills={c.skills.join(" ").toLowerCase()}>
              <header class="flex items-start gap-3">
                <img src={c.avatar} alt={c.name} class="h-12 w-12 shrink-0 rounded-xl bg-ink-100 ring-1 ring-ink-200 dark:ring-white/10" />
                <div class="min-w-0 flex-1">
                  <a href={`/candidates/${c.slug}`} class="line-clamp-1 text-[15px] font-semibold text-ink-900 hover:text-brand-700 transition-colors">{c.name}</a>
                  <p class="mt-0.5 line-clamp-1 text-[12px] text-ink-500">{c.role}</p>
                </div>
                <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold tabular-nums ${c.matchScore >= 90 ? "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400" : c.matchScore >= 80 ? "bg-brand-100 text-brand-700 dark:!bg-brand-500/15 dark:!text-brand-400" : "bg-amber-100 text-amber-800 dark:!bg-amber-500/15 dark:!text-amber-400"}`}>
                  {c.matchScore}%
                </span>
              </header>

              <div class="mt-3 flex flex-wrap items-center gap-1.5">
                <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10.5px] font-semibold ${availabilityStyle[c.availability]}`}>
                  <span class="h-1.5 w-1.5 rounded-full bg-current opacity-60"></span>
                  {c.availability}
                </span>
                <span class="text-[11px] text-ink-500">· {c.location.split(",")[0]} · {c.experienceYears}y</span>
              </div>

              <div class="mt-3 flex flex-wrap gap-1.5">
                {c.skills.slice(0, 3).map((s) => (
                  <span class="rounded-full border border-ink-200 bg-white px-2.5 py-0.5 text-[11px] text-ink-700 dark:!border-white/10 dark:!bg-white/[0.03]">{s}</span>
                ))}
              </div>

              <footer class="mt-4 flex items-center gap-2 border-t border-ink-100 pt-4 dark:!border-white/[0.06]">
                <button type="button" class="inline-flex h-9 flex-1 items-center justify-center gap-1.5 rounded-full bg-ink-900 px-3 text-[12.5px] font-semibold text-ink-50 hover:bg-brand-600">
                  <Icon name="send" size={11} /> Reach out
                </button>
                <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-500 hover:border-ink-400 hover:text-ink-900 dark:!border-white/10" aria-label="Save"><Icon name="bookmark" size={12} /></button>
                <a href={`/candidates/${c.slug}`} class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-500 hover:border-ink-400 hover:text-ink-900 dark:!border-white/10" aria-label="View"><Icon name="arrowUpRight" size={12} /></a>
              </footer>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</EmployerLayout>

<script>
  const q = document.getElementById("talent-q") as HTMLInputElement | null;
  const items = document.querySelectorAll<HTMLElement>(".talent-item");
  const count = document.getElementById("talent-count");
  q?.addEventListener("input", () => {
    const s = q.value.toLowerCase().trim();
    let n = 0;
    items.forEach((el) => {
      const hay = `${el.dataset.name} ${el.dataset.skills}`;
      const show = !s || hay.includes(s);
      el.hidden = !show;
      if (show) n++;
    });
    if (count) count.textContent = String(n);
  });
</script>

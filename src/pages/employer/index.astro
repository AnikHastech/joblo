---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import StatCard from "@components/dashboard/StatCard.astro";
import ApplicantStatusPill from "@components/employer/ApplicantStatusPill.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import Icon from "@components/ui/Icon.astro";
import {
  currentEmployer, employerStats, applicants, applicantWithData,
  companyJobs, jobExtras, pipelineStages,
} from "@data/employer";

const funnel = pipelineStages.map((stage) => ({
  stage,
  count: applicants.filter((a) => a.status === stage).length,
}));
const funnelMax = Math.max(...funnel.map((f) => f.count), 1);

const recentApplicants = applicants
  .slice()
  .sort((a, b) => a.daysAgo - b.daysAgo)
  .slice(0, 6)
  .map(applicantWithData);

const activeJobs = companyJobs.slice(0, 3);
---
<EmployerLayout
  title={`Welcome back, ${currentEmployer.firstName}`}
  subtitle={`${employerStats.newThisWeek} new applicants this week across ${employerStats.activeJobs} active roles.`}
  active="home"
>
  <!-- Stats -->
  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard label="Active jobs"      value={employerStats.activeJobs}     icon="briefcase" href="/employer/jobs"       tone="brand"   changeLabel="Live on the marketplace" />
    <StatCard label="Total applicants" value={employerStats.totalApplicants} icon="users"     href="/employer/applicants" tone="accent"  change={+22} changeLabel="vs. last week" />
    <StatCard label="In interview"     value={employerStats.inInterview}    icon="sparkles"  href="/employer/applicants" tone="info"    changeLabel={`${employerStats.shortlisted} shortlisted`} />
    <StatCard label="Time to hire"     value={`${employerStats.timeToHireDays}d`} icon="clock" tone="success" changeLabel="Median · last 90 days" />
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-12">
    <!-- Left column -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Hiring funnel -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Hiring funnel</p>
            <h3 class="mt-1 text-[18px] font-semibold tracking-tight text-ink-900">Where everyone stands</h3>
          </div>
          <a href="/employer/applicants" class="text-[12.5px] font-medium text-brand-700 hover:underline">Open pipeline →</a>
        </div>
        <ul class="mt-5 space-y-3">
          {funnel.map((f) => (
            <li class="flex items-center gap-4">
              <span class="w-28 shrink-0 text-[12.5px] font-medium text-ink-700">{f.stage}</span>
              <div class="flex-1 h-2.5 overflow-hidden rounded-full bg-ink-100 dark:!bg-white/[0.06]">
                <div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-accent-500" style={`width:${(f.count / funnelMax) * 100}%`}></div>
              </div>
              <span class="w-8 shrink-0 text-right text-[13px] font-semibold text-ink-900 tabular-nums">{f.count}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Recent applicants -->
      <section class="rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <div class="flex items-center justify-between border-b border-ink-100 px-6 py-4 dark:!border-white/[0.06]">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Recent applicants</p>
            <h3 class="mt-0.5 text-[16px] font-semibold text-ink-900">Latest to apply</h3>
          </div>
          <a href="/employer/applicants" class="text-[12.5px] font-medium text-brand-700 hover:underline">View all</a>
        </div>
        <ul class="divide-y divide-ink-100 dark:!divide-white/[0.06]">
          {recentApplicants.map(({ applicant, candidate, job }) => candidate && job && (
            <li class="flex items-center gap-4 px-6 py-4">
              <img src={candidate.avatar} alt={candidate.name} class="h-11 w-11 shrink-0 rounded-xl bg-ink-100 ring-1 ring-ink-200 dark:ring-white/10" />
              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-center gap-2">
                  <a href={`/employer/applicants/${applicant.id}`} class="text-[14.5px] font-semibold text-ink-900 hover:text-brand-700 transition-colors">{candidate.name}</a>
                  <ApplicantStatusPill status={applicant.status} />
                </p>
                <p class="mt-0.5 text-[12.5px] text-ink-500 line-clamp-1">{candidate.role} · applied to <span class="font-medium text-ink-700">{job.title}</span></p>
              </div>
              <div class="hidden text-right sm:block">
                <p class="text-[11px] uppercase tracking-widest text-ink-400">Match</p>
                <p class="mt-0.5 text-[16px] font-semibold text-ink-900 tabular-nums">{applicant.matchScore}%</p>
              </div>
              <a href={`/employer/applicants/${applicant.id}`} class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-500 hover:border-ink-400 hover:text-ink-900 dark:!border-white/10">
                <Icon name="arrowUpRight" size={13} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <!-- Right column -->
    <div class="lg:col-span-4 space-y-6">
      <!-- Active jobs -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Active jobs</p>
          <a href="/employer/jobs" class="text-[12.5px] font-medium text-brand-700 hover:underline">Manage</a>
        </div>
        {activeJobs.length === 0 ? (
          <div class="mt-5"><EmptyState compact icon="briefcase" title="No live jobs" body="Post your first role to start receiving applicants." ctaLabel="Post a job" ctaHref="/employer/post-a-job" /></div>
        ) : (
          <ul class="mt-5 space-y-3">
            {activeJobs.map((j) => {
              const x = jobExtras[j.id];
              return (
                <li class="flex items-center justify-between gap-3 rounded-2xl border border-ink-200/70 bg-white p-4 transition-colors hover:border-ink-300 dark:!border-white/[0.08] dark:!bg-white/[0.02]">
                  <div class="min-w-0">
                    <a href={`/jobs/${j.slug}`} class="line-clamp-1 text-[14px] font-semibold text-ink-900 hover:text-brand-700 transition-colors">{j.title}</a>
                    <p class="mt-0.5 text-[11.5px] text-ink-500 tabular-nums">{x?.views ?? 0} views · {x?.applicantCount ?? 0} applicants</p>
                  </div>
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[10.5px] font-semibold text-emerald-700 dark:!bg-emerald-500/15 dark:text-emerald-400">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Live
                  </span>
                </li>
              );
            })}
          </ul>
        )}
        <a href="/employer/post-a-job" class="mt-5 inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-ink-900 px-4 py-2.5 text-[13px] font-semibold text-ink-50 hover:bg-brand-600">
          <Icon name="plus" size={12} strokeWidth={2.2} /> Post a new job
        </a>
      </section>

      <!-- Response rate insight -->
      <section class="rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-6 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
        <div class="flex items-center gap-2 text-brand-700 dark:text-brand-400">
          <Icon name="livePulse" size={13} />
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em]">Response health</p>
        </div>
        <p class="mt-3 text-[13.5px] leading-relaxed text-ink-800">
          Your median response time is <span class="font-semibold text-ink-900">1 day 4h</span> — top 10% of hiring teams on Joblo.
        </p>
        <div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-white/70 dark:!bg-white/10">
          <div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-accent-500" style={`width:${employerStats.responseRatePct}%`}></div>
        </div>
        <p class="mt-2 flex items-center justify-between text-[11.5px] text-ink-500">
          <span>Response rate</span>
          <span class="tabular-nums font-medium text-ink-800">{employerStats.responseRatePct}%</span>
        </p>
      </section>
    </div>
  </div>
</EmployerLayout>

---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import Icon from "@components/ui/Icon.astro";
import StatCard from "@components/dashboard/StatCard.astro";
import { applicants, pipelineStages, employerStats, companyJobs, jobExtras } from "@data/employer";

const funnel = pipelineStages.map((s) => ({ stage: s, count: applicants.filter((a) => a.status === s).length }));
const funnelMax = Math.max(...funnel.map((f) => f.count), 1);

// Fabricated 12-week trend line (deterministic)
const trend = Array.from({ length: 12 }, (_, i) => {
  const base = 6 + Math.round(Math.sin(i / 1.7) * 4 + Math.cos(i / 3.2) * 3);
  return Math.max(2, base + (i % 3));
});
const trendMax = Math.max(...trend);

// Source of hire — fabricated
const sources = [
  { label: "Direct search",  pct: 34, color: "#5b58f5" },
  { label: "Job board",      pct: 28, color: "#ff4d17" },
  { label: "Referral",       pct: 22, color: "#10b981" },
  { label: "LinkedIn",       pct: 11, color: "#0ea5e9" },
  { label: "Other",          pct:  5, color: "#a3a3a3" },
];

// Time-to-hire by role
const timeByRole = companyJobs.map((j) => ({
  title: j.title,
  days: 18 + Math.round(Math.abs(Math.sin(j.id.charCodeAt(1))) * 22),
  applicants: jobExtras[j.id]?.applicantCount ?? 0,
}));
---
<EmployerLayout
  title="Analytics"
  subtitle="Hiring performance over the last 90 days"
  active="analytics"
>
  <!-- Top stat row -->
  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <StatCard label="Total applicants"   value={employerStats.totalApplicants} icon="users"     change={+22} changeLabel="vs. previous 90 days" tone="brand"   />
    <StatCard label="Hires closed"       value={employerStats.offersOut}       icon="award"     change={+50} changeLabel="last quarter"          tone="success" />
    <StatCard label="Median time to hire" value={`${employerStats.timeToHireDays}d`} icon="clock" change={-11} changeLabel="from 26d"          tone="accent" />
    <StatCard label="Interview → offer"  value="42%"                            icon="sparkles"  change={+8}  changeLabel="conversion"            tone="info" />
  </section>

  <div class="mt-8 grid gap-6 lg:grid-cols-12">
    <!-- Applications trend -->
    <section class="lg:col-span-8 rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Applications over time</p>
          <h3 class="mt-1 text-[18px] font-semibold tracking-tight text-ink-900">Last 12 weeks</h3>
        </div>
        <div class="inline-flex rounded-full border border-ink-200 bg-white p-0.5 dark:!border-white/10 dark:!bg-white/[0.04]" role="group">
          {["12w","90d","6m","1y"].map((r, i) => (
            <button type="button" data-active={String(i === 0)} class="rounded-full px-3 py-1 text-[11.5px] font-medium text-ink-700 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">{r}</button>
          ))}
        </div>
      </div>
      <!-- Sparkline / bars -->
      <div class="mt-6 flex items-end gap-2 h-40">
        {trend.map((v, i) => (
          <div class="group/bar relative flex-1 flex flex-col items-center justify-end">
            <span class="pointer-events-none absolute -top-6 rounded bg-ink-900 px-1.5 py-0.5 text-[10px] font-semibold text-ink-50 opacity-0 transition-opacity group-hover/bar:opacity-100">{v}</span>
            <div class="w-full rounded-t-md bg-gradient-to-t from-brand-500 to-accent-500 transition-all group-hover/bar:from-brand-600 group-hover/bar:to-accent-600" style={`height:${(v / trendMax) * 100}%`}></div>
          </div>
        ))}
      </div>
      <div class="mt-2 flex justify-between text-[10px] tabular-nums text-ink-400">
        {Array.from({ length: 12 }).map((_, i) => <span>W{i + 1}</span>)}
      </div>
    </section>

    <!-- Source of applicants -->
    <section class="lg:col-span-4 rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Source of applicants</p>
      <h3 class="mt-1 text-[18px] font-semibold tracking-tight text-ink-900">Where they come from</h3>

      <!-- Stacked bar -->
      <div class="mt-6 flex h-3 overflow-hidden rounded-full">
        {sources.map((s) => (
          <div style={`width:${s.pct}%;background:${s.color}`}></div>
        ))}
      </div>

      <ul class="mt-5 space-y-2.5">
        {sources.map((s) => (
          <li class="flex items-center justify-between text-[13px]">
            <span class="inline-flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full" style={`background:${s.color}`}></span>
              <span class="text-ink-800">{s.label}</span>
            </span>
            <span class="tabular-nums font-semibold text-ink-900">{s.pct}%</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Funnel -->
    <section class="lg:col-span-6 rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Conversion funnel</p>
      <h3 class="mt-1 text-[18px] font-semibold tracking-tight text-ink-900">Stage-by-stage</h3>
      <ul class="mt-6 space-y-3">
        {funnel.map((f) => (
          <li class="flex items-center gap-4">
            <span class="w-24 shrink-0 text-[12.5px] font-medium text-ink-700">{f.stage}</span>
            <div class="flex-1 h-2.5 overflow-hidden rounded-full bg-ink-100 dark:!bg-white/[0.06]">
              <div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-accent-500" style={`width:${(f.count / funnelMax) * 100}%`}></div>
            </div>
            <span class="w-16 shrink-0 text-right text-[13px] font-semibold text-ink-900 tabular-nums">
              {f.count} <span class="text-[10.5px] font-normal text-ink-500">({Math.round((f.count / funnelMax) * 100)}%)</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Time to hire by role -->
    <section class="lg:col-span-6 rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Time to hire · by role</p>
      <h3 class="mt-1 text-[18px] font-semibold tracking-tight text-ink-900">Slower & faster hires</h3>
      <ul class="mt-6 space-y-4">
        {timeByRole.map((r) => (
          <li>
            <div class="flex items-baseline justify-between gap-3">
              <p class="line-clamp-1 text-[13.5px] font-semibold text-ink-800">{r.title}</p>
              <p class="text-[12.5px] tabular-nums text-ink-500"><span class="text-ink-900 font-semibold">{r.days}d</span> · {r.applicants} applicants</p>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-ink-100 dark:!bg-white/[0.06]">
              <div class={`h-full rounded-full ${r.days > 30 ? "bg-rose-500" : r.days > 20 ? "bg-amber-500" : "bg-emerald-500"}`} style={`width:${Math.min(100, (r.days / 45) * 100)}%`}></div>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-[11.5px] text-ink-500">Benchmark: industry median is 30 days for software roles.</p>
    </section>

    <!-- Insight callout -->
    <section class="lg:col-span-12 rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-6 sm:p-8 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
      <div class="grid gap-6 lg:grid-cols-3">
        {[
          { icon: "sparkles", label: "Opportunity",  title: "Speed up shortlist stage", body: "Applicants sitting in Shortlisted average 4.2 days. Reducing to 2 days could cut time-to-hire by 15%." },
          { icon: "trending", label: "Trend",        title: "Referral quality is climbing", body: "Referred candidates are 3.1× more likely to reach interview than the average source." },
          { icon: "shield",   label: "Health check", title: "Response rate is top 10%",     body: "Your team replies to candidates within 1d 4h on average — well above the platform median." },
        ].map((i) => (
          <div class="rounded-2xl bg-white/70 p-5 backdrop-blur-sm dark:!bg-white/[0.04]">
            <div class="flex items-center gap-2 text-brand-700 dark:text-brand-400">
              <Icon name={i.icon as any} size={12} />
              <p class="text-[10.5px] font-bold uppercase tracking-[0.22em]">{i.label}</p>
            </div>
            <p class="mt-3 text-[15px] font-semibold text-ink-900">{i.title}</p>
            <p class="mt-1.5 text-[13px] text-ink-600 leading-relaxed">{i.body}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</EmployerLayout>

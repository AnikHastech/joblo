---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import StatCard from "@components/dashboard/StatCard.astro";
import Icon from "@components/ui/Icon.astro";

interface Assessment {
  id: string;
  title: string;
  category: "Coding" | "Design" | "Written" | "Behavioral";
  duration: string;
  role: string;
  status: "Active" | "Draft" | "Archived";
  assigned: number;
  completed: number;
  avgScore: number;
  updated: string;
}

const assessments: Assessment[] = [
  { id: "as-1", title: "React + TypeScript take-home",  category: "Coding",     duration: "90 min", role: "Frontend",         status: "Active",   assigned: 24, completed: 18, avgScore: 82, updated: "2d ago" },
  { id: "as-2", title: "System design interview",        category: "Coding",     duration: "60 min", role: "Staff Eng",         status: "Active",   assigned: 12, completed: 9,  avgScore: 76, updated: "5d ago" },
  { id: "as-3", title: "Product sense case study",       category: "Written",    duration: "48 hrs", role: "Product Manager",   status: "Active",   assigned: 8,  completed: 6,  avgScore: 88, updated: "1w ago" },
  { id: "as-4", title: "Design portfolio review",        category: "Design",     duration: "45 min", role: "Sr. Designer",      status: "Active",   assigned: 15, completed: 11, avgScore: 91, updated: "3d ago" },
  { id: "as-5", title: "Values & culture-add",           category: "Behavioral", duration: "30 min", role: "Any",                status: "Active",   assigned: 42, completed: 39, avgScore: 84, updated: "1d ago" },
  { id: "as-6", title: "Go microservices refactor",      category: "Coding",     duration: "3 hrs",  role: "Backend Engineer",   status: "Draft",    assigned: 0,  completed: 0,  avgScore: 0,  updated: "4d ago" },
  { id: "as-7", title: "Growth loop analysis",           category: "Written",    duration: "24 hrs", role: "Growth Lead",        status: "Archived", assigned: 6,  completed: 6,  avgScore: 79, updated: "3w ago" },
];

const stats = [
  { label: "Active tests",   value: assessments.filter((a) => a.status === "Active").length, icon: "sparkles", tone: "brand"   as const, change:  8 },
  { label: "In progress",    value: 21,                                                       icon: "clock",    tone: "info"    as const, change: 14 },
  { label: "Avg score",      value: "83%",                                                    icon: "award",    tone: "success" as const, change:  3 },
  { label: "Completion rate",value: "87%",                                                    icon: "trending", tone: "accent"  as const, change: -2 },
];

const categoryChip: Record<string, string> = {
  Coding:     "bg-brand-50 text-brand-700 dark:!bg-brand-500/15 dark:!text-brand-400",
  Design:     "bg-violet-50 text-violet-700 dark:!bg-violet-500/15 dark:!text-violet-400",
  Written:    "bg-amber-50 text-amber-700 dark:!bg-amber-500/15 dark:!text-amber-400",
  Behavioral: "bg-emerald-50 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400",
};
const statusChip: Record<string, string> = {
  Active:   "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400",
  Draft:    "bg-ink-100 text-ink-700 dark:!bg-white/[0.06] dark:!text-ink-800",
  Archived: "bg-ink-100 text-ink-500 dark:!bg-white/[0.04] dark:!text-ink-500",
};
---
<EmployerLayout title="Assessments" active="assessments">
  <!-- Header -->
  <header class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Skill checks</p>
      <h1 class="mt-2 text-[26px] font-semibold leading-tight tracking-tight text-ink-900 sm:text-[32px]">
        Assessments &amp; <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">skill checks</span>
      </h1>
      <p class="mt-2 text-[13.5px] text-ink-500">Assign objective, scored tests. Reduce interview time and hire based on evidence.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3.5 text-[13px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">
        <Icon name="grid" size={13} />
        Templates
      </button>
      <button type="button" class="inline-flex h-10 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[13px] font-semibold text-ink-50 hover:bg-brand-600">
        <Icon name="plus" size={13} />
        New assessment
      </button>
    </div>
  </header>

  <!-- Stats -->
  <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((s) => <StatCard {...s} />)}
  </div>

  <!-- Filters -->
  <div class="mt-8 flex flex-wrap items-center gap-2 rounded-2xl border border-ink-200/70 bg-white p-3 dark:!border-white/[0.08] dark:!bg-white/[0.03]">
    <div class="relative flex-1 min-w-[220px]">
      <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-400"><Icon name="search" size={13} /></span>
      <input type="search" placeholder="Search assessments…" class="h-9 w-full rounded-lg border border-ink-200 bg-white pl-9 pr-3 text-[13px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
    </div>
    {["All", "Coding", "Design", "Written", "Behavioral"].map((c, i) => (
      <button type="button" data-emp-asm-filter={c} data-active={i === 0 ? "true" : "false"} class="emp-asm-tab inline-flex h-9 items-center rounded-lg border border-ink-200 bg-white px-3 text-[12.5px] font-medium text-ink-800 transition-colors hover:border-ink-400 data-[active=true]:!border-ink-900 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50 dark:!border-white/10 dark:!bg-white/[0.03]">
        {c}
      </button>
    ))}
  </div>

  <!-- Assessment list -->
  <div class="mt-6 space-y-3">
    {assessments.map((a) => (
      <article class="emp-asm-card group flex flex-col gap-4 rounded-2xl border border-ink-200/70 bg-white p-5 transition-colors hover:border-ink-300 dark:!border-white/[0.08] dark:!bg-white/[0.03] md:flex-row md:items-center md:justify-between" data-category={a.category}>
        <div class="flex items-start gap-3 min-w-0 flex-1">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-accent-50 text-brand-700 ring-1 ring-brand-100/60 dark:!from-brand-500/12 dark:!to-accent-500/12 dark:!text-brand-400 dark:ring-brand-500/20">
            <Icon name="award" size={17} strokeWidth={1.8} />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-1.5">
              <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest ${categoryChip[a.category]}`}>{a.category}</span>
              <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest ${statusChip[a.status]}`}>
                {a.status === "Active" && <span class="h-1 w-1 rounded-full bg-emerald-500"></span>}
                {a.status}
              </span>
              <span class="text-[11.5px] text-ink-500">for {a.role}</span>
            </div>
            <h3 class="mt-2 text-[15px] font-semibold text-ink-900 group-hover:text-brand-700 transition-colors">{a.title}</h3>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-ink-500">
              <span class="inline-flex items-center gap-1"><Icon name="clock" size={11} /> {a.duration}</span>
              <span class="inline-flex items-center gap-1"><Icon name="users" size={11} /> {a.assigned} assigned</span>
              <span class="inline-flex items-center gap-1"><Icon name="checkCircle" size={11} /> {a.completed} completed</span>
              <span>· Updated {a.updated}</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 md:ml-4">
          <div class="text-center min-w-[68px]">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-ink-500">Avg score</p>
            <p class="mt-0.5 text-[18px] font-semibold tabular-nums text-emerald-600 dark:!text-emerald-400">{a.avgScore > 0 ? `${a.avgScore}%` : "—"}</p>
          </div>
          <button type="button" class="inline-flex h-9 items-center gap-1 rounded-full bg-ink-900 px-3.5 text-[12.5px] font-semibold text-ink-50 hover:bg-brand-600">
            Assign
            <Icon name="arrowRight" size={12} />
          </button>
          <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-600 hover:border-ink-400 dark:!border-white/10" aria-label="More">
            <Icon name="filter" size={13} />
          </button>
        </div>
      </article>
    ))}
  </div>

  <!-- Recent submissions -->
  <div class="mt-10 rounded-2xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.03]">
    <header class="flex items-center justify-between border-b border-ink-200 p-5 dark:!border-white/[0.06]">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-ink-500">Recent submissions</p>
        <h2 class="mt-1 text-[17px] font-semibold text-ink-900">Latest candidate results</h2>
      </div>
      <a href="/employer/applicants" class="text-[12.5px] font-medium text-brand-700 hover:underline">View all applicants</a>
    </header>
    <ul class="divide-y divide-ink-100 dark:!divide-white/[0.06]">
      {[
        { name: "Maya Okonkwo",    role: "Senior Product Designer", test: "Design portfolio review",     score: 94, when: "2h ago" },
        { name: "Rafael Chen",     role: "Staff Engineer",           test: "System design interview",      score: 88, when: "5h ago" },
        { name: "Priya Anand",     role: "Product Manager",           test: "Product sense case study",     score: 92, when: "Yesterday" },
        { name: "Devon Park",      role: "Growth Marketing Lead",     test: "Growth loop analysis",         score: 81, when: "Yesterday" },
      ].map((r) => (
        <li class="flex flex-wrap items-center gap-3 p-4 sm:p-5">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink-900 text-[11px] font-bold text-ink-50 dark:!bg-brand-500 dark:!text-white">
            {r.name.split(" ").map((n) => n[0]).slice(0, 2).join("")}
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-[13.5px] font-semibold text-ink-900">{r.name}</p>
            <p class="mt-0.5 text-[11.5px] text-ink-500">{r.role} · {r.test}</p>
          </div>
          <div class="flex items-center gap-3">
            <span class={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-[11.5px] font-semibold tabular-nums ${r.score >= 90 ? "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400" : r.score >= 80 ? "bg-sky-100 text-sky-700 dark:!bg-sky-500/15 dark:!text-sky-400" : "bg-amber-100 text-amber-700 dark:!bg-amber-500/15 dark:!text-amber-400"}`}>
              <Icon name="award" size={11} />
              {r.score}%
            </span>
            <span class="hidden text-[11.5px] tabular-nums text-ink-500 sm:inline">{r.when}</span>
            <a href="/employer/applicants" class="text-[12px] font-medium text-brand-700 hover:underline">Review</a>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".emp-asm-tab");
    const cards = document.querySelectorAll<HTMLElement>(".emp-asm-card");
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabs.forEach((b) => (b.dataset.active = String(b === btn)));
        const f = btn.dataset.empAsmFilter;
        cards.forEach((c) => { c.hidden = !(f === "All" || c.dataset.category === f); });
      });
    });
  </script>
</EmployerLayout>

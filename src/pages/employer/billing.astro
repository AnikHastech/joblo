---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import Icon from "@components/ui/Icon.astro";
import { invoices } from "@data/employer";

const statusStyle = {
  Paid:    { bg: "bg-emerald-100", text: "text-emerald-800", dot: "bg-emerald-500" },
  Pending: { bg: "bg-amber-100",   text: "text-amber-800",   dot: "bg-amber-500"   },
  Failed:  { bg: "bg-rose-100",    text: "text-rose-700",    dot: "bg-rose-500"    },
} as const;
---
<EmployerLayout
  title="Billing"
  subtitle="Your plan, payment method, and every invoice ever."
  active="billing"
>
  <!-- Plan card -->
  <section class="grid gap-6 lg:grid-cols-12">
    <div class="lg:col-span-8 rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-6 sm:p-8 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-700 dark:text-brand-400">Current plan</p>
          <h2 class="mt-2 text-[28px] font-semibold tracking-tight text-ink-900">Growth · <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">Annual</span></h2>
          <p class="mt-1 text-[13.5px] text-ink-600">$1,428/month billed annually · Renews on <span class="font-medium text-ink-800">March 1, 2026</span>.</p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
          <a href="/pricing" class="inline-flex h-11 items-center gap-1.5 rounded-full bg-ink-900 px-5 text-[13.5px] font-semibold text-ink-50 hover:bg-brand-600">
            Upgrade to Scale <Icon name="arrowRight" size={13} />
          </a>
          <button type="button" class="inline-flex h-11 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-5 text-[13.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">Cancel plan</button>
        </div>
      </div>

      <!-- Usage -->
      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        {[
          { label: "Active postings", value: "2 / 10",  pct: 20 },
          { label: "Team seats",      value: "5 / 5",   pct: 100 },
          { label: "Candidate search", value: "1.2K / 5K", pct: 24 },
        ].map((u) => (
          <div class="rounded-2xl bg-white/70 p-4 backdrop-blur-sm dark:!bg-white/[0.04]">
            <dt class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">{u.label}</dt>
            <dd class="mt-2 text-[18px] font-semibold text-ink-900 tabular-nums">{u.value}</dd>
            <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-white/80 dark:!bg-white/10">
              <div class={`h-full rounded-full ${u.pct >= 90 ? "bg-rose-500" : "bg-gradient-to-r from-brand-500 to-accent-500"}`} style={`width:${u.pct}%`}></div>
            </div>
          </div>
        ))}
      </dl>
    </div>

    <!-- Payment method -->
    <div class="lg:col-span-4 rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Payment method</p>
      <div class="mt-5 rounded-2xl border border-ink-200 bg-gradient-to-br from-ink-900 to-ink-700 p-5 text-ink-50 dark:!border-white/10">
        <div class="flex items-center justify-between">
          <p class="text-[11.5px] uppercase tracking-widest text-ink-400">Visa · debit</p>
          <span class="rounded bg-white/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest">Default</span>
        </div>
        <p class="mt-6 text-[18px] tracking-widest tabular-nums">•••• •••• •••• 4242</p>
        <p class="mt-2 text-[11.5px] text-ink-300">Aisha Chen · Exp 09/28</p>
      </div>
      <div class="mt-4 flex flex-col gap-2">
        <button type="button" class="inline-flex h-10 items-center justify-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
          <Icon name="plus" size={12} /> Add payment method
        </button>
        <button type="button" class="inline-flex h-10 items-center justify-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
          Update billing details
        </button>
      </div>
    </div>
  </section>

  <!-- Invoices -->
  <section class="mt-8 rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035]">
    <div class="flex items-center justify-between border-b border-ink-100 px-6 py-4 dark:!border-white/[0.06]">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Invoices</p>
        <h3 class="mt-0.5 text-[16px] font-semibold text-ink-900">Billing history</h3>
      </div>
      <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        <Icon name="arrowUp" size={11} class="rotate-180" /> Download all
      </button>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[720px] text-left text-[13.5px]">
        <thead>
          <tr class="text-[11px] font-bold uppercase tracking-widest text-ink-500">
            <th class="px-6 py-3.5">Invoice</th>
            <th class="px-4 py-3.5">Date</th>
            <th class="px-4 py-3.5">Plan · period</th>
            <th class="px-4 py-3.5 text-right">Amount</th>
            <th class="px-4 py-3.5">Status</th>
            <th class="px-6 py-3.5 text-right">Action</th>
          </tr>
        </thead>
        <tbody>
          {invoices.map((inv) => {
            const s = statusStyle[inv.status];
            return (
              <tr class="border-t border-ink-100 dark:!border-white/[0.06]">
                <td class="px-6 py-4 font-mono text-[12.5px] tabular-nums text-ink-900">{inv.invoiceNumber}</td>
                <td class="px-4 py-4 text-ink-700 tabular-nums">{inv.date}</td>
                <td class="px-4 py-4 text-ink-700">
                  <p>{inv.plan}</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-500">{inv.period}</p>
                </td>
                <td class="px-4 py-4 text-right font-semibold text-ink-900 tabular-nums">{inv.currency}{inv.amount.toLocaleString()}</td>
                <td class="px-4 py-4">
                  <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11.5px] font-semibold ${s.bg} ${s.text}`}>
                    <span class={`h-1.5 w-1.5 rounded-full ${s.dot}`}></span>
                    {inv.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <button type="button" class="inline-flex h-8 items-center gap-1 rounded-full border border-ink-200 bg-white px-3 text-[12px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">
                    <Icon name="arrowUp" size={10} class="rotate-180" /> PDF
                  </button>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
</EmployerLayout>

---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import Icon from "@components/ui/Icon.astro";
import { scheduledInterviews, applicants, applicantPool, applicantWithData } from "@data/employer";
import { jobs } from "@data/jobs";

// Group interviews by day label
type Group = { title: string; iso: string; items: typeof scheduledInterviews };
const groups: Group[] = [];
scheduledInterviews.forEach((iv) => {
  let g = groups.find((x) => x.iso === iv.isoDate);
  if (!g) { g = { title: iv.dayLabel, iso: iv.isoDate, items: [] }; groups.push(g); }
  g.items.push(iv);
});

const confirmed = scheduledInterviews.filter((i) => i.status === "Confirmed").length;
const pending   = scheduledInterviews.filter((i) => i.status === "Pending").length;
---
<EmployerLayout
  title="Interviews"
  subtitle={`${confirmed} confirmed · ${pending} pending · this week`}
  active="interviews"
>
  <!-- Top action strip -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="inline-flex rounded-full border border-ink-200 bg-white p-0.5 dark:!border-white/10 dark:!bg-white/[0.04]" role="group">
      <button type="button" data-empi-filter="upcoming"  data-active="true"  class="empi-tab rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-700 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">Upcoming</button>
      <button type="button" data-empi-filter="past"       data-active="false" class="empi-tab rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-500 hover:text-ink-900">Past</button>
      <button type="button" data-empi-filter="cancelled"  data-active="false" class="empi-tab rounded-full px-3.5 py-1.5 text-[12.5px] font-medium text-ink-500 hover:text-ink-900">Cancelled</button>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" class="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
        <Icon name="filter" size={12} /> Team calendar
      </button>
      <button type="button" class="inline-flex h-10 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[13px] font-semibold text-ink-50 hover:bg-brand-600">
        <Icon name="plus" size={12} strokeWidth={2.2} /> Schedule
      </button>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-12">
    <!-- LEFT: agenda list -->
    <div class="lg:col-span-8 space-y-6">
      {groups.map((g) => (
        <section class="empi-section" data-tab="upcoming">
          <div class="mb-3 flex items-center justify-between">
            <p class="text-[11px] font-bold uppercase tracking-widest text-ink-500">{g.title}</p>
            <span class="text-[11.5px] tabular-nums text-ink-400">{g.items.length} interview{g.items.length === 1 ? "" : "s"}</span>
          </div>
          <ul class="space-y-3">
            {g.items.map((iv) => {
              const applicant = applicants.find((a) => a.id === iv.applicantId);
              const cand = applicant ? applicantPool.find((c) => c.id === applicant.candidateId) : undefined;
              const job = applicant ? jobs.find((j) => j.id === applicant.jobId) : undefined;
              return (
                <li>
                  <article class="group relative flex flex-wrap items-stretch gap-4 rounded-2xl border border-ink-200/70 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-sm dark:!border-white/[0.08] dark:!bg-white/[0.035]">
                    <!-- Time block -->
                    <div class="flex flex-col justify-center border-r border-ink-100 pr-4 dark:!border-white/[0.06] min-w-[92px]">
                      <p class="text-[18px] font-semibold tracking-tight text-ink-900 tabular-nums">{iv.time}</p>
                      <p class="mt-0.5 text-[11.5px] text-ink-500 tabular-nums">{iv.duration}</p>
                    </div>

                    <!-- Content -->
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="text-[14.5px] font-semibold text-ink-900 line-clamp-1">{iv.round}</p>
                        <span class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-semibold ${iv.status === "Confirmed" ? "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400" : "bg-amber-100 text-amber-800 dark:!bg-amber-500/15 dark:!text-amber-400"}`}>
                          <span class="h-1.5 w-1.5 rounded-full bg-current opacity-60"></span>
                          {iv.status}
                        </span>
                      </div>
                      {cand && job && (
                        <p class="mt-1 text-[12.5px] text-ink-500 line-clamp-1">
                          <a href={`/employer/applicants/${applicant!.id}`} class="font-medium text-ink-800 hover:text-brand-700 transition-colors">{cand.name}</a>
                          <span> · </span>
                          <span>{job.title}</span>
                        </p>
                      )}
                      <div class="mt-3 flex flex-wrap items-center gap-3 text-[11.5px] text-ink-500">
                        <span class="inline-flex items-center gap-1"><Icon name="mapPin" size={11} /> {iv.location}</span>
                        <span class="inline-flex items-center gap-1">
                          <Icon name="users" size={11} />
                          {iv.interviewers.slice(0, 2).join(", ")}
                          {iv.interviewers.length > 2 && ` +${iv.interviewers.length - 2}`}
                        </span>
                      </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2">
                      <button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ink-900 px-3 text-[12px] font-semibold text-ink-50 hover:bg-brand-600">
                        <Icon name="arrowUpRight" size={11} /> Join
                      </button>
                      <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-500 hover:border-ink-400 hover:text-ink-900 dark:!border-white/10" aria-label="Reschedule"><Icon name="clock" size={12} /></button>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <!-- RIGHT: mini calendar + team availability -->
    <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 lg:h-fit">
      <!-- Mini month -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <div class="flex items-center justify-between">
          <p class="text-[13px] font-semibold text-ink-900">February 2026</p>
          <div class="flex items-center gap-1">
            <button type="button" class="flex h-7 w-7 items-center justify-center rounded-full text-ink-500 hover:bg-ink-100 dark:hover:!bg-white/[0.06]"><Icon name="chevronDown" size={11} class="rotate-90" /></button>
            <button type="button" class="flex h-7 w-7 items-center justify-center rounded-full text-ink-500 hover:bg-ink-100 dark:hover:!bg-white/[0.06]"><Icon name="chevronDown" size={11} class="-rotate-90" /></button>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-7 gap-1 text-center text-[10.5px] font-semibold text-ink-500">
          {["S","M","T","W","T","F","S"].map((d) => <span>{d}</span>)}
        </div>
        <div class="mt-2 grid grid-cols-7 gap-1 text-[12px]">
          {Array.from({ length: 28 }).map((_, i) => {
            const day = i + 1;
            const has = scheduledInterviews.some((iv) => Number(iv.isoDate.split("-")[2]) === day);
            const isToday = day === 15;
            return (
              <button type="button" class={`relative flex h-9 items-center justify-center rounded-lg tabular-nums transition-colors ${isToday ? "bg-ink-900 text-ink-50 font-semibold" : has ? "bg-brand-50 text-brand-800 font-semibold hover:bg-brand-100 dark:!bg-brand-500/15 dark:!text-brand-400" : "text-ink-700 hover:bg-ink-100 dark:hover:!bg-white/[0.06]"}`}>
                {day}
                {has && !isToday && <span class="absolute bottom-1 h-1 w-1 rounded-full bg-brand-500"></span>}
                {has && isToday && <span class="absolute bottom-1 h-1 w-1 rounded-full bg-accent-400"></span>}
              </button>
            );
          })}
        </div>
      </section>

      <!-- Team availability -->
      <section class="rounded-3xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Team availability</p>
        <ul class="mt-4 space-y-3">
          {[
            { name: "Aisha Chen",       role: "Head of Talent",      hours: "8h this week",  color: "#5b58f5" },
            { name: "Sofía Álvarez",    role: "Design Lead",          hours: "4h this week", color: "#10b981" },
            { name: "Marcus Bergström", role: "Head of Product",      hours: "2h this week", color: "#f97316" },
            { name: "Rafael Chen",      role: "Engineering Manager",  hours: "6h this week", color: "#ec4899" },
          ].map((m) => (
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-bold text-white" style={`background:${m.color}`}>{m.name[0]}</span>
              <div class="min-w-0 flex-1">
                <p class="text-[13px] font-semibold text-ink-900 line-clamp-1">{m.name}</p>
                <p class="mt-0.5 text-[11.5px] text-ink-500 line-clamp-1">{m.role}</p>
              </div>
              <span class="text-[11.5px] tabular-nums text-ink-500">{m.hours}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Prep tip -->
      <section class="rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-5 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
        <p class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-700 dark:text-brand-400">
          <Icon name="sparkles" size={11} /> Prep suggestion
        </p>
        <p class="mt-3 text-[13px] leading-relaxed text-ink-800">
          Send your interviewers the applicant's portfolio + last activity 24h before each round.
        </p>
      </section>
    </aside>
  </div>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>(".empi-tab");
    const sections = document.querySelectorAll<HTMLElement>(".empi-section");
    tabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabs.forEach((b) => (b.dataset.active = String(b === btn)));
        const f = btn.dataset.empiFilter;
        sections.forEach((s) => { s.hidden = !(s.dataset.tab === f); });
      });
    });
  </script>
</EmployerLayout>

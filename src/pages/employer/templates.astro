---
import EmployerLayout from "@layouts/EmployerLayout.astro";
import Icon from "@components/ui/Icon.astro";
import { templates, type TemplateKind } from "@data/employer";

const kinds: TemplateKind[] = ["Email", "Message", "Scorecard", "Offer letter", "Rejection"];
const countByKind = (k: TemplateKind) => templates.filter((t) => t.kind === k).length;

const kindStyle: Record<TemplateKind, string> = {
  "Email":        "bg-brand-100 text-brand-700 dark:!bg-brand-500/15 dark:!text-brand-400",
  "Message":      "bg-sky-100 text-sky-800 dark:!bg-sky-500/15 dark:!text-sky-400",
  "Scorecard":    "bg-violet-100 text-violet-700 dark:!bg-violet-500/15 dark:!text-violet-400",
  "Offer letter": "bg-emerald-100 text-emerald-800 dark:!bg-emerald-500/15 dark:!text-emerald-400",
  "Rejection":    "bg-rose-100 text-rose-700 dark:!bg-rose-500/15 dark:!text-rose-400",
};

const active = templates[0];
---
<EmployerLayout
  title="Templates"
  subtitle={`${templates.length} reusable templates · saved your team ~${templates.reduce((s, t) => s + t.usedCount, 0)} manual messages`}
  active="templates"
>
  <div class="grid gap-6 lg:grid-cols-12">
    <!-- LEFT: list -->
    <div class="lg:col-span-5 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="inline-flex flex-wrap gap-1 rounded-full border border-ink-200 bg-white p-0.5 dark:!border-white/10 dark:!bg-white/[0.04]" role="group">
          <button type="button" data-kind="All" data-active="true" class="tpl-filter rounded-full px-3 py-1.5 text-[12px] font-medium text-ink-700 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">All ({templates.length})</button>
          {kinds.map((k) => (
            <button type="button" data-kind={k} data-active="false" class="tpl-filter rounded-full px-3 py-1.5 text-[12px] font-medium text-ink-500 hover:text-ink-900 data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50">{k} ({countByKind(k)})</button>
          ))}
        </div>
        <button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ink-900 px-3.5 text-[12.5px] font-semibold text-ink-50 hover:bg-brand-600">
          <Icon name="plus" size={11} strokeWidth={2.2} /> New template
        </button>
      </div>

      <ul id="tpl-list" class="space-y-2">
        {templates.map((t, i) => (
          <li>
            <button type="button" data-kind={t.kind} class={`tpl-item group flex w-full items-start gap-3 rounded-2xl border p-4 text-left transition-all ${i === 0 ? "border-ink-900 shadow-sm dark:!border-brand-500" : "border-ink-200/70 hover:border-ink-300 dark:!border-white/[0.08]"} bg-white dark:!bg-white/[0.035]`}>
              <span class={`shrink-0 rounded-full px-2 py-0.5 text-[10.5px] font-semibold ${kindStyle[t.kind]}`}>{t.kind}</span>
              <div class="min-w-0 flex-1">
                <p class="line-clamp-1 text-[13.5px] font-semibold text-ink-900">{t.name}</p>
                <p class="mt-1 line-clamp-2 text-[12px] text-ink-500">{t.description}</p>
                <div class="mt-2 flex items-center gap-3 text-[10.5px] text-ink-400">
                  <span class="tabular-nums">Used {t.usedCount}×</span>
                  <span>·</span>
                  <span>Updated {t.updatedOn}</span>
                </div>
              </div>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <!-- RIGHT: editor / preview -->
    <div class="lg:col-span-7 lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035]">
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-100 p-5 dark:!border-white/[0.06]">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class={`rounded-full px-2 py-0.5 text-[10.5px] font-semibold ${kindStyle[active.kind]}`}>{active.kind}</span>
              <span class="text-[11.5px] text-ink-500 tabular-nums">Used {active.usedCount}× · last {active.updatedOn}</span>
            </div>
            <h2 class="mt-2 text-[20px] font-semibold tracking-tight text-ink-900">{active.name}</h2>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 text-[12.5px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">
              <Icon name="plus" size={11} /> Duplicate
            </button>
            <button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-full bg-ink-900 px-3.5 text-[12.5px] font-semibold text-ink-50 hover:bg-brand-600">
              <Icon name="send" size={11} /> Use template
            </button>
          </div>
        </header>

        <div class="p-6">
          <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Description</p>
          <p class="mt-2 text-[13.5px] text-ink-700">{active.description}</p>

          <div class="mt-6">
            <div class="flex items-center justify-between">
              <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Body</p>
              <div class="flex items-center gap-1 text-[10.5px] text-ink-400">
                <span>Placeholders:</span>
                <code class="rounded bg-ink-100 px-1.5 py-0.5 font-mono text-ink-700 dark:!bg-white/[0.06]">{"{NAME}"}</code>
                <code class="rounded bg-ink-100 px-1.5 py-0.5 font-mono text-ink-700 dark:!bg-white/[0.06]">{"{ROLE}"}</code>
                <code class="rounded bg-ink-100 px-1.5 py-0.5 font-mono text-ink-700 dark:!bg-white/[0.06]">{"{COMPANY}"}</code>
              </div>
            </div>
            <textarea rows="12" class="mt-3 w-full rounded-2xl border border-ink-200 bg-white px-4 py-3.5 font-mono text-[12.5px] leading-relaxed text-ink-800 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]">{active.body}</textarea>
          </div>

          <!-- Placeholder tokens -->
          <div class="mt-6 rounded-2xl bg-ink-50/60 p-4 dark:!bg-white/[0.03]">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">Available variables</p>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {[
                { token: "{NAME}",        desc: "Candidate first name" },
                { token: "{ROLE}",        desc: "Job title" },
                { token: "{COMPANY}",     desc: "Your company name" },
                { token: "{SENDER}",      desc: "Your name" },
                { token: "{INTERVIEWERS}", desc: "Comma-separated names" },
                { token: "{DATE}",        desc: "Today's date" },
              ].map((v) => (
                <div class="flex items-center gap-2 text-[12px]">
                  <code class="rounded bg-white px-1.5 py-0.5 font-mono text-ink-800 ring-1 ring-ink-200 dark:!bg-white/[0.06] dark:!ring-white/10">{v.token}</code>
                  <span class="text-ink-500">{v.desc}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
            <label class="inline-flex items-center gap-2 text-[12.5px] text-ink-500">
              <input type="checkbox" checked class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
              Auto-suggest this template on matching threads
            </label>
            <div class="flex items-center gap-2">
              <button type="button" class="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 text-[13px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">Discard</button>
              <button type="submit" class="inline-flex h-10 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[13px] font-semibold text-ink-50 hover:bg-brand-600">
                Save changes <Icon name="check" size={12} strokeWidth={2.5} />
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</EmployerLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".tpl-filter");
  const items = document.querySelectorAll<HTMLElement>(".tpl-item");
  btns.forEach((b) => {
    b.addEventListener("click", () => {
      btns.forEach((x) => (x.dataset.active = String(x === b)));
      const k = b.dataset.kind;
      items.forEach((el) => {
        (el.parentElement as HTMLElement).hidden = !!k && k !== "All" && el.dataset.kind !== k;
      });
    });
  });
</script>

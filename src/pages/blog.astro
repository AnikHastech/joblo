---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import { blogPosts, featuredBlogPosts, blogCategories } from "@data/blog";
import { site } from "@data/site";

const featured = featuredBlogPosts[0] ?? blogPosts[0];
const secondary = featuredBlogPosts.slice(1, 3);
const rest = blogPosts.filter((p) => p.slug !== featured.slug && !secondary.some((s) => s.slug === p.slug));
---
<BaseLayout
  title={`Insights & guides · ${site.name}`}
  description="Research, playbooks, and stories from the front lines of hiring and career growth in 2026."
>
  <!-- Hero + magazine featured -->
  <section class="section-blog-hero relative isolate pt-14 pb-10 sm:pt-20">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-30 mask-radial"></div>
      <div class="absolute -top-40 right-0 h-[520px] w-[820px] rounded-full bg-gradient-to-bl from-brand-200/40 via-accent-200/25 to-transparent blur-3xl dark:!from-brand-500/15 dark:!via-accent-500/10"></div>
    </div>
    <Container size="xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[12.5px] text-ink-500">
        <a href="/" class="hover:text-ink-900 transition-colors">Home</a>
        <Icon name="chevronDown" size={10} class="-rotate-90 text-ink-300" />
        <span class="font-medium text-ink-800">Insights</span>
      </nav>

      <div class="mt-6 grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <SectionEyebrow number="01" label="Insights" />
          <h1 class="mt-4 text-[30px] font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-4xl md:text-5xl lg:text-6xl">
            Notes from <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">the field</span>.
          </h1>
          <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-ink-600">
            Research, playbooks, and honest stories from the front lines of hiring and career growth. Published when we have something to say.
          </p>
        </div>
        <div class="lg:col-span-5">
          <div class="relative">
            <span class="pointer-events-none absolute left-5 top-1/2 -translate-y-1/2 text-ink-400">
              <Icon name="search" size={15} />
            </span>
            <input id="blog-search" type="search" placeholder="Search articles…" class="h-12 w-full rounded-full border border-ink-200 bg-white pl-12 pr-4 text-[14px] text-ink-900 placeholder:text-ink-400 shadow-sm focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]" />
          </div>
        </div>
      </div>

      <!-- Category chips -->
      <div class="mt-8 flex flex-wrap items-center gap-2">
        <button type="button" data-cat="all" data-active="true" class="chip inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-1.5 text-[13px] font-medium text-ink-800 transition-all data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50 data-[active=true]:!border-ink-900 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
          All posts
          <span class="text-[10.5px] tabular-nums text-ink-400 data-[active=true]:!text-ink-300">{blogPosts.length}</span>
        </button>
        {blogCategories.map((c) => (
          <button type="button" data-cat={c} data-active="false" class="chip inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-1.5 text-[13px] font-medium text-ink-800 transition-all data-[active=true]:!bg-ink-900 data-[active=true]:!text-ink-50 data-[active=true]:!border-ink-900 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
            {c}
            <span class="text-[10.5px] tabular-nums text-ink-400">{blogPosts.filter((p) => p.category === c).length}</span>
          </button>
        ))}
      </div>
    </Container>
  </section>

  <!-- Featured hero + secondary -->
  <section class="pb-16 sm:pb-20">
    <Container size="xl">
      <div class="grid gap-6 lg:grid-cols-12">
        <!-- Big featured -->
        <a href={`/blog/${featured.slug}`} class="blog-item group relative col-span-full flex flex-col overflow-hidden rounded-3xl border border-ink-200/70 bg-white transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-xl dark:!border-white/[0.08] dark:!bg-white/[0.035] lg:col-span-8" data-cat={featured.category} data-title={featured.title.toLowerCase()}>
          <div class="relative aspect-[16/9] overflow-hidden">
            <img src={featured.coverUrl} alt="" width="1600" height="900" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900/60 via-transparent to-transparent"></div>
            <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-ink-900 backdrop-blur">
              <Icon name="star" size={11} class="text-amber-500" />
              Featured
            </span>
          </div>
          <div class="p-5 sm:p-7 lg:p-9">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-ink-500">
              <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-[11px] font-semibold text-brand-700 dark:!bg-brand-500/15 dark:text-brand-400">{featured.category}</span>
              <span>·</span>
              <span>{featured.readMinutes} min read</span>
              <span>·</span>
              <span>{featured.date}</span>
            </div>
            <h2 class="mt-4 text-[22px] font-semibold leading-[1.15] tracking-tight text-ink-900 group-hover:text-brand-700 transition-colors sm:text-[26px] lg:text-[32px]">
              {featured.title}
            </h2>
            <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-600">{featured.excerpt}</p>
            <div class="mt-6 flex items-center gap-3">
              <img src={featured.authorAvatar} alt={featured.author} class="h-9 w-9 rounded-full bg-ink-100 ring-1 ring-ink-200 dark:ring-white/10" />
              <div>
                <p class="text-[13px] font-semibold text-ink-900">{featured.author}</p>
                {featured.authorRole && <p class="text-[11.5px] text-ink-500">{featured.authorRole}</p>}
              </div>
            </div>
          </div>
        </a>

        <!-- Two secondary -->
        <div class="col-span-full grid gap-6 lg:col-span-4">
          {secondary.map((p) => (
            <a href={`/blog/${p.slug}`} class="blog-item group flex flex-col overflow-hidden rounded-3xl border border-ink-200/70 bg-white transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:!border-white/[0.08] dark:!bg-white/[0.035]" data-cat={p.category} data-title={p.title.toLowerCase()}>
              <div class="relative aspect-[16/9] overflow-hidden">
                <img src={p.coverUrl} alt="" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center gap-2 text-[11.5px] text-ink-500">
                  <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10.5px] font-semibold text-brand-700 dark:!bg-brand-500/15 dark:text-brand-400">{p.category}</span>
                  <span>·</span>
                  <span>{p.readMinutes} min</span>
                </div>
                <h3 class="mt-3 text-[16px] font-semibold leading-snug text-ink-900 group-hover:text-brand-700 transition-colors">{p.title}</h3>
                <p class="mt-auto pt-4 text-[11.5px] text-ink-500">{p.date}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- Rest of posts grid -->
  <section class="pb-24 sm:pb-32">
    <Container size="xl">
      <div class="flex items-end justify-between">
        <div>
          <SectionEyebrow number="02" label="All posts" />
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl md:text-4xl">More insights</h2>
        </div>
      </div>
      <div id="blog-grid" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p) => (
          <a href={`/blog/${p.slug}`} class="blog-item group flex flex-col overflow-hidden rounded-3xl border border-ink-200/70 bg-white transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:!border-white/[0.08] dark:!bg-white/[0.035]" data-cat={p.category} data-title={p.title.toLowerCase()}>
            <div class="relative aspect-[16/9] overflow-hidden">
              <img src={p.coverUrl} alt="" width="800" height="500" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center gap-2 text-[11.5px] text-ink-500">
                <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10.5px] font-semibold text-brand-700 dark:!bg-brand-500/15 dark:text-brand-400">{p.category}</span>
                <span>·</span>
                <span>{p.readMinutes} min</span>
              </div>
              <h3 class="mt-3 text-[16px] font-semibold leading-snug text-ink-900 group-hover:text-brand-700 transition-colors sm:text-[17px]">{p.title}</h3>
              <p class="mt-2 text-[13.5px] leading-relaxed text-ink-600 line-clamp-2">{p.excerpt}</p>
              <div class="mt-auto flex items-center gap-2 pt-5 text-[11.5px] text-ink-500">
                <img src={p.authorAvatar} alt="" class="h-6 w-6 rounded-full bg-ink-100" />
                <span>{p.author}</span>
                <span>·</span>
                <span>{p.date}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div id="blog-empty" hidden class="mt-10 rounded-2xl border border-dashed border-ink-200 bg-ink-50/50 p-12 text-center dark:!border-white/10 dark:!bg-white/[0.02]">
        <p class="text-[15.5px] font-semibold text-ink-900">No posts match your filter</p>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const items = document.querySelectorAll<HTMLElement>(".blog-item");
  const search = document.getElementById("blog-search") as HTMLInputElement | null;
  const empty = document.getElementById("blog-empty");

  let activeCat = "all";

  const filter = () => {
    const q = (search?.value ?? "").toLowerCase().trim();
    let matched = 0;
    items.forEach((el) => {
      const catOk = activeCat === "all" || el.dataset.cat === activeCat;
      const qOk = !q || (el.dataset.title ?? "").includes(q);
      const show = catOk && qOk;
      el.hidden = !show;
      if (show) matched++;
    });
    if (empty) empty.hidden = matched !== 0;
  };

  chips.forEach((c) => {
    c.addEventListener("click", () => {
      chips.forEach((x) => (x.dataset.active = String(x === c)));
      activeCat = c.dataset.cat ?? "all";
      filter();
    });
  });
  search?.addEventListener("input", filter);
</script>

  <script>
    (function () {
      const modal = document.getElementById("founder-video-modal");
      const iframe = document.getElementById("founder-video-iframe");
      if (!modal || !iframe) return;
      const openers = document.querySelectorAll("[data-founder-video-open]");
      const closers = modal.querySelectorAll("[data-founder-video-close]");
      // Placeholder — swap for your founder video. Currently uses Linda
      // Raynier's "Tell me about yourself" — a highly-viewed career video.
      const videoId = "PCWVi5pAa30";
      const open = () => {
        iframe.setAttribute("src", "https://www.youtube.com/embed/" + videoId + "?autoplay=1&rel=0");
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      };
      const close = () => {
        iframe.setAttribute("src", "");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
      };
      openers.forEach((b) => b.addEventListener("click", open));
      closers.forEach((b) => b.addEventListener("click", close));
      modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.classList.contains("hidden")) close(); });
    })();
  </script>


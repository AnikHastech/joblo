---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import Badge from "@components/ui/Badge.astro";
import BrandLogo from "@components/common/BrandLogo.astro";
import { site } from "@data/site";
import { companies } from "@data/companies";
import { liveHireAvatars } from "@data/testimonials";
import { team } from "@data/team";

const heroAvatars = [
  liveHireAvatars.Maya,
  liveHireAvatars.Devon,
  liveHireAvatars.Priya,
  liveHireAvatars.Kenji,
  liveHireAvatars.Elena,
];

// Doubled row for logo marquee
const marqueeRow = [...companies, ...companies];

const stats = [
  { number: site.stats.candidates, label: "Active candidates", change: "+12% this quarter", icon: "users",     tone: "brand"   },
  { number: site.stats.jobs,       label: "Curated jobs",      change: "1,240 posted this week", icon: "briefcase", tone: "accent"  },
  { number: site.stats.companies,  label: "Hiring companies",  change: "84 new this month", icon: "building",  tone: "info"    },
  { number: site.stats.hires,      label: "Successful hires",  change: "3.1× industry avg", icon: "award",     tone: "success" },
];

const values = [
  { icon: "sparkles", tone: "brand",   title: "Craft over volume",   body: "One curated match beats a hundred spammy ones. Every listing is human-reviewed before it goes live." },
  { icon: "shield",   tone: "success", title: "Respect for time",    body: "Your time is the scarce resource. We optimize for signal, not scroll depth." },
  { icon: "users",    tone: "violet",  title: "Two-sided fairness",  body: "We work for candidates and employers equally. Neither wins unless both do." },
  { icon: "bolt",     tone: "warning", title: "Ship, then iterate",  body: "We'd rather ship a rough version and learn than plan forever. The product improves weekly." },
];

const timeline = [
  { year: "2021", tag: "Founded",     title: "Two designers and a data scientist",   body: "Tired of the same old job boards, we started building on weekends out of a shared studio in Oakland." },
  { year: "2022", tag: "Beta",        title: "First 1,000 candidates",               body: "A small beta went unexpectedly well. Word spread through Slack groups — we didn't spend a dollar on ads." },
  { year: "2023", tag: "Seed",        title: "30 early companies · $3M raised",      body: "Raised from operators, not funds. Onboarded thirty adopters who shaped what we became." },
  { year: "2024", tag: "Series A",    title: "Marketplace at scale · $18M",          body: "Crossed 100K active candidates. Launched employer suite. Team of twelve, still mostly senior ICs." },
  { year: "2025", tag: "Global",      title: "Opened to worldwide remote roles",     body: "Doubled our candidate base every quarter. Expanded to London, Singapore, and Berlin." },
  { year: "2026", tag: "Today",       title: "Where we are now",                     body: `${site.stats.jobs} jobs, ${site.stats.companies} companies, ${site.stats.candidates} candidates. Team of 34 across 4 offices.`, live: true },
];

// Team roster imported from @data/team (also powers /team/[slug] details pages)

const offices = [
  {
    city: "San Francisco", country: "USA", role: "Global HQ", people: 18, tz: "PT · UTC-8",
    image: "https://images.unsplash.com/photo-1449034446853-66c86144b0ad?auto=format&fit=crop&w=800&q=80",
    alt: "Golden Gate Bridge, San Francisco",
    href: "/jobs?location=san-francisco",
  },
  {
    city: "London", country: "UK", role: "EMEA", people: 8, tz: "GMT · UTC+0",
    image: "https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?auto=format&fit=crop&w=800&q=80",
    alt: "London skyline with Big Ben",
    href: "/jobs?location=london",
  },
  {
    city: "Singapore", country: "Singapore", role: "APAC", people: 5, tz: "SGT · UTC+8",
    image: "https://images.unsplash.com/photo-1525625293386-3f8f99389edd?auto=format&fit=crop&w=800&q=80",
    alt: "Marina Bay Sands, Singapore",
    href: "/jobs?location=singapore",
  },
  {
    city: "Distributed", country: "Worldwide", role: "Remote-first", people: 3, tz: "Any timezone",
    image: "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80",
    alt: "Earth from space — distributed team",
    href: "/jobs?remote=true",
  },
];

const openRoles = [
  { title: "Senior Full-stack Engineer", location: "Remote — Americas",  team: "Engineering" },
  { title: "Marketplace Analyst",         location: "San Francisco",     team: "Data" },
  { title: "Content Marketing Manager",   location: "London",            team: "Growth" },
];

const toneChip: Record<string, string> = {
  brand:   "bg-brand-50 text-brand-700 ring-brand-100/60 dark:!bg-brand-500/15 dark:!text-brand-400 dark:!ring-white/10",
  accent:  "bg-accent-50 text-accent-700 ring-accent-100/60 dark:!bg-accent-500/15 dark:!text-accent-400 dark:!ring-white/10",
  info:    "bg-sky-50 text-sky-700 ring-sky-100/60 dark:!bg-sky-500/15 dark:!text-sky-400 dark:!ring-white/10",
  success: "bg-emerald-50 text-emerald-700 ring-emerald-100/60 dark:!bg-emerald-500/15 dark:!text-emerald-400 dark:!ring-white/10",
  violet:  "bg-violet-50 text-violet-700 ring-violet-100/60 dark:!bg-violet-500/15 dark:!text-violet-400 dark:!ring-white/10",
  warning: "bg-amber-50 text-amber-700 ring-amber-100/60 dark:!bg-amber-500/15 dark:!text-amber-400 dark:!ring-white/10",
};
---
<BaseLayout
  title={`About · ${site.name}`}
  description={`We're a small team building the job marketplace the industry actually deserves — craft over volume, respect for time, and two-sided fairness aren't marketing slogans.`}
>
  <!-- ═════ HERO — editorial with side avatar cluster + live indicator ═════ -->
  <section class="section-about-hero relative isolate overflow-hidden pt-14 pb-20 sm:pt-20 sm:pb-24">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-grid opacity-60 mask-radial"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[640px] w-[960px] -translate-x-1/2 rounded-full bg-gradient-to-br from-brand-200/50 via-accent-200/30 to-transparent blur-3xl dark:!from-brand-500/20 dark:!via-accent-500/15"></div>
    <div class="pointer-events-none absolute top-24 -right-40 -z-10 h-[420px] w-[420px] rounded-full bg-accent-300/25 blur-3xl dark:!bg-accent-500/20"></div>

    <Container size="xl">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[12.5px] text-ink-500">
        <a href="/" class="hover:text-ink-900 transition-colors">Home</a>
        <Icon name="chevronDown" size={10} class="-rotate-90 text-ink-300" />
        <span class="font-medium text-ink-800">About</span>
      </nav>

      <div class="mt-8 grid gap-12 lg:grid-cols-12 lg:items-center">
        <!-- Left: Big editorial title -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/60 px-3 py-1.5 backdrop-blur dark:!border-white/10 dark:!bg-white/[0.04]">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            </span>
            <span class="text-[11px] font-semibold uppercase tracking-widest text-ink-700">Since 2021 · Team of 34 · Four cities</span>
          </div>

          <h1 class="mt-6 text-[36px] font-semibold leading-[1.02] tracking-tight text-ink-900 xs:text-[42px] sm:text-[56px] md:text-[64px] lg:text-[80px] xl:text-[88px] sm:leading-[0.98]">
            The marketplace the industry
            <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 via-brand-500 to-accent-500 bg-clip-text text-transparent">actually deserves</span>.
          </h1>

          <p class="mt-5 max-w-2xl text-[15px] leading-[1.6] text-ink-600 sm:mt-6 sm:text-[17px] lg:text-[18px]">
            We're a small team of designers, engineers, and researchers building the job marketplace we always wished existed — one that respects your time, treats both sides fairly, and only shows you work worth doing.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-6">
            <!-- Avatar cluster -->
            <div class="flex -space-x-2.5">
              {heroAvatars.map((src) => (
                <img src={src} alt="" class="h-11 w-11 rounded-full bg-ink-100 ring-2 ring-white dark:!ring-ink-100" />
              ))}
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink-900 text-[11.5px] font-bold text-ink-50 ring-2 ring-white dark:!ring-ink-100 dark:!bg-brand-500">+29</span>
            </div>
            <p class="text-[13px] text-ink-600">
              <span class="font-semibold text-ink-900">34 humans</span> across engineering, design, ops, and research — hiring 6 more this quarter.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#story" class="group inline-flex h-12 items-center gap-2 rounded-full bg-ink-900 px-6 text-[14.5px] font-semibold text-ink-50 shadow-sm transition-all hover:bg-brand-600 hover:shadow-md">
              Read our story
              <Icon name="arrowRight" size={13} class="transition-transform group-hover:translate-x-0.5" />
            </a>
            <a href="#join" class="inline-flex h-12 items-center gap-2 rounded-full border border-ink-200 bg-white px-6 text-[14px] font-medium text-ink-800 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.04]">
              Join the team
            </a>
          </div>
        </div>

        <!-- Right: Floating polaroid stack of team -->
        <div class="relative lg:col-span-5">
          <div class="relative mx-auto h-[380px] max-w-md sm:h-[460px] lg:h-[500px]">
            <!-- Back polaroid -->
            <figure class="absolute left-2 top-4 w-44 rotate-[-6deg] rounded-2xl border border-ink-200/70 bg-white p-2.5 shadow-lg transition-transform hover:rotate-[-3deg] dark:!border-white/[0.08] dark:!bg-white/[0.06] sm:left-4 sm:w-52 sm:p-3 lg:w-56">
              <div class="aspect-square overflow-hidden rounded-xl bg-gradient-to-br from-brand-500/60 to-accent-500/60 p-5 sm:p-6">
                <img src={team[0].avatar} alt={team[0].name} class="h-full w-full object-contain" />
              </div>
              <figcaption class="mt-2.5 px-1 sm:mt-3">
                <p class="text-[12.5px] font-semibold text-ink-900 sm:text-[13.5px]">{team[0].name}</p>
                <p class="mt-0.5 text-[11px] text-ink-500 sm:text-[11.5px]">{team[0].role}</p>
              </figcaption>
            </figure>

            <!-- Front polaroid -->
            <figure class="absolute right-2 top-14 w-44 rotate-[4deg] rounded-2xl border border-ink-200/70 bg-white p-2.5 shadow-xl transition-transform hover:rotate-[2deg] dark:!border-white/[0.08] dark:!bg-white/[0.06] sm:right-8 sm:top-16 sm:w-52 sm:p-3 lg:w-56">
              <div class="aspect-square overflow-hidden rounded-xl bg-gradient-to-br from-violet-500/60 to-brand-500/60 p-5 sm:p-6">
                <img src={team[1].avatar} alt={team[1].name} class="h-full w-full object-contain" />
              </div>
              <figcaption class="mt-2.5 px-1 sm:mt-3">
                <p class="text-[12.5px] font-semibold text-ink-900 sm:text-[13.5px]">{team[1].name}</p>
                <p class="mt-0.5 text-[11px] text-ink-500 sm:text-[11.5px]">{team[1].role}</p>
              </figcaption>
            </figure>

            <!-- Bottom polaroid -->
            <figure class="absolute bottom-0 left-1/2 w-44 -translate-x-1/2 rotate-[-2deg] rounded-2xl border border-ink-200/70 bg-white p-2.5 shadow-lg transition-transform hover:rotate-0 dark:!border-white/[0.08] dark:!bg-white/[0.06] sm:w-52 sm:p-3 lg:w-56">
              <div class="aspect-square overflow-hidden rounded-xl bg-gradient-to-br from-accent-500/60 to-rose-500/60 p-5 sm:p-6">
                <img src={team[3].avatar} alt={team[3].name} class="h-full w-full object-contain" />
              </div>
              <figcaption class="mt-2.5 px-1 sm:mt-3">
                <p class="text-[12.5px] font-semibold text-ink-900 sm:text-[13.5px]">{team[3].name}</p>
                <p class="mt-0.5 text-[11px] text-ink-500 sm:text-[11.5px]">{team[3].role}</p>
              </figcaption>
            </figure>

            <!-- Floating meta chip -->
            <span class="absolute -top-1 right-0 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 text-[10.5px] font-semibold text-ink-800 shadow-md ring-1 ring-ink-200 backdrop-blur dark:!bg-ink-100 dark:!ring-white/10 sm:-top-2 sm:px-3 sm:py-1.5 sm:text-[11px]">
              <Icon name="star" size={10} class="text-amber-500" />
              4.9 team rating
            </span>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ═════ TRUSTED — logo marquee (matches Home) ═════ -->
  <section class="section-about-trusted relative isolate overflow-hidden border-y border-ink-200/60 bg-gradient-to-r from-brand-50/50 via-white to-accent-50/40 py-12 dark:!border-white/10 dark:!from-brand-950/30 dark:!via-ink-100 dark:!to-accent-900/25">
    <Container size="xl">
      <p class="text-center text-[13px] font-medium uppercase tracking-[0.22em] text-ink-500">
        Teams we've helped hire for
      </p>
      <div class="relative mt-8 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
        <div class="flex w-max animate-marquee gap-10 sm:gap-14">
          {marqueeRow.map((c) => (
            <a href={`/companies/${c.slug}`} class="group flex shrink-0 items-center gap-3 opacity-80 transition-all hover:opacity-100" aria-label={c.name}>
              <BrandLogo slug={c.slug} size="sm" fallbackColor={c.brandColor} fallbackLetter={c.logo} class="transition-transform group-hover:scale-110" />
              <span class="text-lg font-semibold tracking-tight text-ink-700 group-hover:text-ink-900 dark:text-ink-800">{c.name}</span>
            </a>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ═════ STATS — rich bento with sparklines, avatars, live ticker ═════ -->
  <section class="section-about-stats py-16 sm:py-20 lg:py-28">
    <Container size="xl">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <SectionEyebrow number="02" label="By the numbers" />
          <h2 class="mt-4 text-[32px] font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-4xl lg:text-5xl">
            The <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">shape</span> of what we've built.
          </h2>
        </div>
        <p class="lg:col-span-6 lg:col-start-7 text-[15.5px] leading-relaxed text-ink-600">
          Every number here is updated in real time from the marketplace. No inflated vanity metrics — just the actual pulse of the platform this quarter.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:auto-rows-[1fr]">
        <!-- ═══ Hero stat — 1.8M candidates ═══ (col-span-6, row-span-2) -->
        <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-ink-200/70 bg-white p-6 transition-all hover:border-ink-300 hover:shadow-lg dark:!border-white/[0.08] dark:!bg-white/[0.035] sm:col-span-2 sm:p-8 lg:col-span-6 lg:row-span-2 lg:p-10">
          <!-- Ambient gradient bloom -->
          <span aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 h-64 w-64 rounded-full bg-gradient-to-br from-brand-300/25 to-accent-300/20 blur-3xl dark:!from-brand-500/20 dark:!to-accent-500/15"></span>

          <div class="relative flex items-start justify-between">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl ring-1 bg-brand-50 text-brand-700 ring-brand-100/60 dark:!bg-brand-500/15 dark:!text-brand-400 dark:!ring-white/10">
              <Icon name="users" size={22} />
            </span>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400">
                <Icon name="arrowUp" size={9} strokeWidth={2.5} />
                +12% this quarter
              </span>
              <span class="text-[10.5px] font-semibold uppercase tabular-nums tracking-widest text-ink-400">01</span>
            </div>
          </div>

          <p class="relative mt-6 text-[56px] font-semibold leading-none tracking-tight text-ink-900 tabular-nums sm:mt-8 sm:text-[80px] lg:text-[104px]">
            1.8M
          </p>
          <p class="relative mt-4 text-[14.5px] font-semibold text-ink-800">Active candidates</p>
          <p class="relative mt-1 max-w-md text-[13.5px] text-ink-500">The largest curated pool of engineers, designers, PMs, and operators — all human-reviewed.</p>

          <!-- Sparkline (12-week trend) -->
          <div class="relative mt-8">
            <div class="flex items-baseline justify-between">
              <p class="text-[10.5px] font-semibold uppercase tracking-widest text-ink-500">Last 12 weeks</p>
              <p class="text-[10.5px] tabular-nums text-ink-400">1.42M → 1.80M</p>
            </div>
            <div class="mt-3 flex items-end gap-1.5 h-16">
              {[8, 11, 9, 13, 12, 15, 17, 14, 19, 21, 22, 26].map((v, i, arr) => {
                const max = Math.max(...arr);
                return (
                  <div class="group/bar flex-1 flex flex-col items-center justify-end">
                    <div class="w-full rounded-t bg-gradient-to-t from-brand-200 to-brand-500 transition-all group-hover/bar:from-brand-300 group-hover/bar:to-accent-500 dark:!from-brand-500/40 dark:!to-brand-400" style={`height:${(v / max) * 100}%`}></div>
                  </div>
                );
              })}
            </div>
          </div>

          <!-- Category distribution stripe -->
          <div class="relative mt-8">
            <div class="flex items-baseline justify-between">
              <p class="text-[10.5px] font-semibold uppercase tracking-widest text-ink-500">By discipline</p>
              <p class="text-[10.5px] text-ink-400">6 disciplines</p>
            </div>
            <div class="mt-3 flex h-2 overflow-hidden rounded-full">
              <div class="bg-brand-500" style="width:38%" title="Engineering 38%"></div>
              <div class="bg-accent-500" style="width:24%" title="Design 24%"></div>
              <div class="bg-violet-500" style="width:18%" title="Product 18%"></div>
              <div class="bg-emerald-500" style="width:12%" title="Data 12%"></div>
              <div class="bg-sky-500" style="width:5%" title="Sales 5%"></div>
              <div class="bg-amber-500" style="width:3%" title="Other 3%"></div>
            </div>
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-[11.5px]">
              {[
                { c: "bg-brand-500", n: "Engineering", v: "38%" },
                { c: "bg-accent-500", n: "Design", v: "24%" },
                { c: "bg-violet-500", n: "Product", v: "18%" },
                { c: "bg-emerald-500", n: "Data", v: "12%" },
              ].map((d) => (
                <li class="inline-flex items-center gap-1.5 text-ink-700">
                  <span class={`h-2 w-2 rounded-full ${d.c}`}></span>
                  {d.n}
                  <span class="tabular-nums text-ink-400">{d.v}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Recent activity chip -->
          <div class="relative mt-auto pt-8">
            <div class="flex items-center gap-3 rounded-2xl border border-ink-200/70 bg-ink-50/60 p-3 dark:!border-white/[0.08] dark:!bg-white/[0.04]">
              <div class="flex -space-x-2">
                {heroAvatars.slice(0, 3).map((a) => <img src={a} alt="" class="h-8 w-8 rounded-full ring-2 ring-white dark:!ring-ink-100" />)}
              </div>
              <p class="flex-1 text-[12px] text-ink-600"><span class="font-semibold text-ink-900">7 candidates</span> got hired via Joblo just this week</p>
              <a href="/candidates" class="flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 text-ink-500 transition-colors hover:border-ink-400 hover:text-ink-900 dark:!border-white/10" aria-label="Meet the candidates">
                <Icon name="arrowUpRight" size={11} />
              </a>
            </div>
          </div>
        </article>

        <!-- ═══ 02 · Curated jobs — 128K ═══ (col-span-3, row 1) -->
        <article class="group relative flex flex-col rounded-3xl border border-ink-200/70 bg-white p-6 transition-all hover:-translate-y-1 hover:border-ink-300 hover:shadow-md dark:!border-white/[0.08] dark:!bg-white/[0.035] lg:col-span-3">
          <div class="flex items-start justify-between">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl ring-1 bg-accent-50 text-accent-700 ring-accent-100/60 dark:!bg-accent-500/15 dark:!text-accent-400 dark:!ring-white/10">
              <Icon name="briefcase" size={17} />
            </span>
            <span class="text-[10.5px] font-semibold uppercase tabular-nums tracking-widest text-ink-400">02</span>
          </div>
          <p class="mt-6 text-[40px] font-semibold leading-none tracking-tight text-ink-900 tabular-nums">128,540</p>
          <p class="mt-3 text-[13.5px] font-semibold text-ink-800">Curated jobs</p>
          <p class="mt-1 text-[12px] text-ink-500">1,240 posted this week</p>

          <!-- Weekly posting sparkline -->
          <div class="mt-auto pt-5">
            <div class="flex items-end gap-1 h-10">
              {[6, 8, 5, 9, 12, 11, 14].map((v, i, arr) => (
                <div class="flex-1 rounded-sm bg-accent-500/70 transition-all group-hover:bg-accent-500 dark:!bg-accent-500/50" style={`height:${(v / Math.max(...arr)) * 100}%`}></div>
              ))}
            </div>
            <p class="mt-2 flex items-center justify-between text-[10px] uppercase tracking-widest text-ink-400">
              <span>Mon</span><span>Wed</span><span>Fri</span><span>Sun</span>
            </p>
          </div>
        </article>

        <!-- ═══ 03 · Successful hires — 312K ═══ (col-span-3, row 1) -->
        <article class="group relative flex flex-col rounded-3xl border border-ink-200/70 bg-white p-6 transition-all hover:-translate-y-1 hover:border-ink-300 hover:shadow-md dark:!border-white/[0.08] dark:!bg-white/[0.035] lg:col-span-3">
          <div class="flex items-start justify-between">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl ring-1 bg-emerald-50 text-emerald-700 ring-emerald-100/60 dark:!bg-emerald-500/15 dark:!text-emerald-400 dark:!ring-white/10">
              <Icon name="award" size={17} />
            </span>
            <span class="text-[10.5px] font-semibold uppercase tabular-nums tracking-widest text-ink-400">03</span>
          </div>

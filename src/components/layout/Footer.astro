---
import { footerNav } from "@data/navigation";
import { site } from "@data/site";
import Container from "@components/ui/Container.astro";
import Logo from "@components/common/Logo.astro";
import Icon from "@components/ui/Icon.astro";

const trustBadges = [
  { icon: "shield" as const, label: "SOC 2 Type II" },
  { icon: "checkCircle" as const, label: "GDPR Compliant" },
  { icon: "award" as const, label: "SaaS of the Year '25" },
  { icon: "users" as const, label: "1.8M candidates" },
];

const socials = [
  { href: site.social.twitter,  label: "Twitter",  icon: "twitter"  as const },
  { href: site.social.linkedin, label: "LinkedIn", icon: "linkedin" as const },
  { href: site.social.github,   label: "GitHub",   icon: "github"   as const },
  { href: site.social.dribbble, label: "Dribbble", icon: "dribbble" as const },
];
---
<footer class="site-footer relative isolate overflow-hidden bg-gradient-to-b from-white via-brand-50/30 to-accent-50/30 dark:from-ink-100 dark:via-brand-950/25 dark:to-accent-900/20 text-ink-800 border-t border-ink-200/70 dark:border-white/10">
  <!-- Ambient background layers -->
  <div class="pointer-events-none absolute inset-0 opacity-40 dark:opacity-20 bg-grid mask-radial"></div>
  <div class="pointer-events-none absolute -left-40 -top-40 h-[600px] w-[600px] rounded-full bg-brand-200/40 dark:bg-brand-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-40 top-1/3 h-[500px] w-[500px] rounded-full bg-accent-200/40 dark:bg-accent-500/15 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-60 left-1/3 h-[500px] w-[500px] rounded-full bg-brand-100/50 dark:bg-brand-500/10 blur-3xl"></div>

  <!-- ═══════════════════════════════════════════════════════
       TOP: Big statement + dual CTA
       ═══════════════════════════════════════════════════════ -->
  <div class="border-b border-ink-200/60 py-20 sm:py-28">
    <Container size="xl">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/80 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-widest text-ink-800 backdrop-blur">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            </span>
            Hiring is live
          </span>
          <h2 class="mt-6 text-[38px] font-semibold leading-[0.98] tracking-[-0.03em] text-ink-950 sm:text-6xl lg:text-[80px]">
            The way<br/>
            <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 via-brand-500 to-accent-500 bg-clip-text text-transparent">work should feel.</span>
          </h2>
        </div>

        <div class="lg:col-span-5 lg:pl-8">
          <p class="max-w-md text-lg leading-relaxed text-ink-700">
            Whether you're looking for your next chapter or hiring the team that ships it — Joblo is where it happens.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/signup"
              class="group inline-flex h-12 items-center gap-2 rounded-full bg-ink-900 px-5 text-[14.5px] font-semibold text-ink-50 transition-all hover:bg-brand-600 hover:shadow-[0_10px_30px_-8px_rgb(74_63_230/0.4)]"
            >
              I'm looking for work
              <Icon name="arrowRight" size={14} strokeWidth={2} class="transition-transform group-hover:translate-x-0.5" />
            </a>
            <a
              href="/post-a-job"
              class="group inline-flex h-12 items-center gap-2 rounded-full border border-ink-300 bg-white px-5 text-[14.5px] font-semibold text-ink-900 backdrop-blur transition-all hover:border-ink-900 hover:bg-ink-50"
            >
              I'm hiring
              <Icon name="arrowRight" size={14} strokeWidth={2} class="transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       MIDDLE: Brand + newsletter + link columns
       ═══════════════════════════════════════════════════════ -->
  <div class="py-16 sm:py-20">
    <Container size="xl">
      <div class="grid gap-12 lg:grid-cols-12">
        <!-- Brand column -->
        <div class="lg:col-span-4">
          <Logo />
          <p class="mt-6 max-w-sm text-[15px] leading-relaxed text-ink-700">
            {site.description}
          </p>

          <!-- Newsletter -->
          <form class="mt-8 max-w-sm" onsubmit="event.preventDefault();">
            <label for="footer-email" class="block text-[11px] font-semibold uppercase tracking-widest text-ink-700">
              Weekly job digest
            </label>
            <div class="mt-3 flex items-center gap-1 rounded-full border border-ink-200 bg-white p-1 pl-5 shadow-sm transition-colors focus-within:border-ink-900">
              <input
                id="footer-email"
                type="email"
                required
                placeholder="you@company.com"
                class="min-w-0 flex-1 bg-transparent py-2 text-[14px] text-ink-900 placeholder:text-ink-400 focus:outline-none"
              />
              <button
                type="submit"
                class="group inline-flex h-9 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[13px] font-semibold text-ink-50 transition-colors hover:bg-brand-600"
              >
                Subscribe
                <Icon name="arrowRight" size={12} strokeWidth={2} class="transition-transform group-hover:translate-x-0.5" />
              </button>
            </div>
            <p class="mt-2.5 text-[11.5px] text-ink-600">Join 84,000+ pros. No spam, unsubscribe anytime.</p>
          </form>

        </div>

        <!-- Link columns -->
        <div class="grid grid-cols-2 gap-8 lg:col-span-8 lg:grid-cols-4">
          {Object.entries(footerNav).map(([heading, links]) => (
            <div>
              <h4 class="text-[12px] font-bold uppercase tracking-widest text-ink-900">{heading}</h4>
              <ul class="mt-5 space-y-3.5">
                {links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="group inline-flex items-center gap-1 text-[14.5px] text-ink-600 transition-colors hover:text-ink-950"
                    >
                      {l.label}
                      <Icon name="arrowUpRight" size={11} strokeWidth={2} class="translate-y-px opacity-0 -translate-x-1 transition-all group-hover:translate-x-0 group-hover:opacity-100 text-brand-600" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       Trust badges + region/language selectors
       ═══════════════════════════════════════════════════════ -->
  <div class="border-t border-ink-200/60 py-8">
    <Container size="xl" class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
      <div class="flex flex-wrap items-center gap-2.5">
        {trustBadges.map((b) => (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white/70 px-3 py-1.5 text-[12px] font-medium text-ink-800 backdrop-blur">
            <Icon name={b.icon} size={12} strokeWidth={2} class="text-emerald-600" />
            {b.label}
          </span>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- Region selector -->
        <div class="relative" data-selector="region">
          <button
            type="button"
            class="selector-trigger inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/70 px-3 py-2 text-[13px] font-medium text-ink-800 backdrop-blur transition-colors hover:border-ink-400 hover:bg-white"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Change region"
          >
            <Icon name="globe" size={13} strokeWidth={1.8} />
            <span class="selector-label">United States</span>
            <Icon name="chevronDown" size={10} class="selector-chevron text-ink-400 transition-transform" />
          </button>
          <ul
            hidden
            role="listbox"
            class="selector-menu absolute right-0 bottom-full z-30 mb-2 max-h-72 min-w-[220px] overflow-y-auto rounded-xl border border-ink-200 bg-white p-1.5 shadow-2xl shadow-ink-900/15"
          >
            {[
              { value: "United States",  flag: "🇺🇸" },
              { value: "United Kingdom", flag: "🇬🇧" },
              { value: "Canada",         flag: "🇨🇦" },
              { value: "Germany",        flag: "🇩🇪" },
              { value: "France",         flag: "🇫🇷" },
              { value: "Japan",          flag: "🇯🇵" },
              { value: "Singapore",      flag: "🇸🇬" },
              { value: "Australia",      flag: "🇦🇺" },
              { value: "India",          flag: "🇮🇳" },
              { value: "Global",         flag: "🌍" },
            ].map((r) => (
              <li>
                <button
                  type="button"
                  role="option"
                  data-value={r.value}
                  class="selector-option flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-[13.5px] font-medium text-ink-800 transition-colors hover:bg-ink-50 aria-selected:bg-brand-50 aria-selected:text-brand-700"
                >
                  <span class="text-base">{r.flag}</span>
                  <span class="flex-1">{r.value}</span>
                  <Icon name="check" size={12} strokeWidth={2.2} class="selector-check hidden text-brand-600" />
                </button>
              </li>
            ))}
          </ul>
        </div>

        <!-- Language selector -->
        <div class="relative" data-selector="language">
          <button
            type="button"
            class="selector-trigger inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/70 px-3 py-2 text-[13px] font-medium text-ink-800 backdrop-blur transition-colors hover:border-ink-400 hover:bg-white"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label="Change language"
          >
            <Icon name="globe" size={13} strokeWidth={1.8} />
            <span class="selector-label">English</span>
            <Icon name="chevronDown" size={10} class="selector-chevron text-ink-400 transition-transform" />
          </button>
          <ul
            hidden
            role="listbox"
            class="selector-menu absolute right-0 bottom-full z-30 mb-2 max-h-72 min-w-[200px] overflow-y-auto rounded-2xl border border-ink-200 bg-white p-1.5 shadow-2xl shadow-ink-900/15"
          >
            {[
              { value: "English",    sub: "EN" },
              { value: "Español",    sub: "ES" },
              { value: "Deutsch",    sub: "DE" },
              { value: "Français",   sub: "FR" },
              { value: "Português",  sub: "PT" },
              { value: "日本語",      sub: "JA" },
              { value: "中文",        sub: "ZH" },
              { value: "हिन्दी",       sub: "HI" },
              { value: "العربية",     sub: "AR" },
            ].map((l) => (
              <li>
                <button
                  type="button"
                  role="option"
                  data-value={l.value}
                  class="selector-option flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-[13.5px] font-medium text-ink-800 transition-colors hover:bg-ink-50 aria-selected:bg-brand-50 aria-selected:text-brand-700"
                >
                  <span class="flex h-6 w-6 items-center justify-center rounded-md bg-ink-100 text-[10px] font-bold text-ink-700">{l.sub}</span>
                  <span class="flex-1">{l.value}</span>
                  <Icon name="check" size={12} strokeWidth={2.2} class="selector-check hidden text-brand-600" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </div>

  <script>
    (function () {
      const selectors = document.querySelectorAll<HTMLElement>("[data-selector]");

      const closeAll = (except?: HTMLElement) => {
        selectors.forEach((sel) => {
          if (sel === except) return;
          const menu    = sel.querySelector<HTMLElement>(".selector-menu");
          const trigger = sel.querySelector<HTMLButtonElement>(".selector-trigger");
          const chevron = sel.querySelector<HTMLElement>(".selector-chevron");
          menu?.setAttribute("hidden", "");
          trigger?.setAttribute("aria-expanded", "false");
          chevron?.classList.remove("rotate-180");
        });
      };

      selectors.forEach((sel) => {
        const kind    = sel.dataset.selector!;
        const trigger = sel.querySelector<HTMLButtonElement>(".selector-trigger")!;
        const menu    = sel.querySelector<HTMLElement>(".selector-menu")!;
        const label   = sel.querySelector<HTMLElement>(".selector-label")!;
        const chevron = sel.querySelector<HTMLElement>(".selector-chevron")!;
        const options = sel.querySelectorAll<HTMLButtonElement>(".selector-option");

        const storeKey = `joblo:${kind}`;
        const saved = (() => { try { return localStorage.getItem(storeKey); } catch { return null; } })();

        const setActive = (value: string) => {
          label.textContent = value;
          options.forEach((opt) => {
            const active = opt.dataset.value === value;
            opt.setAttribute("aria-selected", String(active));
            opt.querySelector<HTMLElement>(".selector-check")?.classList.toggle("hidden", !active);
          });
        };

        if (saved) setActive(saved);
        else setActive(label.textContent?.trim() || "");

        trigger.addEventListener("click", (e) => {
          e.stopPropagation();
          const willOpen = menu.hasAttribute("hidden");
          closeAll(sel);
          if (willOpen) {
            menu.removeAttribute("hidden");
            trigger.setAttribute("aria-expanded", "true");
            chevron.classList.add("rotate-180");
          } else {
            menu.setAttribute("hidden", "");
            trigger.setAttribute("aria-expanded", "false");
            chevron.classList.remove("rotate-180");
          }
        });

        options.forEach((opt) => {
          opt.addEventListener("click", () => {
            const val = opt.dataset.value!;
            setActive(val);
            try { localStorage.setItem(storeKey, val); } catch {}
            closeAll();
          });
        });
      });

      document.addEventListener("click", () => closeAll());
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll(); });
    })();
  </script>

  <!-- ═══════════════════════════════════════════════════════
       Bottom bar
       ═══════════════════════════════════════════════════════ -->
  <div class="border-t border-ink-200/60 py-6">
    <Container size="xl" class="flex flex-col items-center justify-between gap-5 text-[13px] text-ink-700 md:flex-row">
      <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="text-ink-300">·</span>
        <span>
          Designed by
          <a href="https://hasthemes.com/" target="_blank" rel="noopener" class="font-medium text-ink-900 hover:text-brand-700 transition-colors">HasThemes</a>
        </span>
        <span class="text-ink-300">·</span>
        <span>
          Powered by
          <a href="https://astro.build/" target="_blank" rel="noopener" class="font-medium text-ink-900 hover:text-brand-700 transition-colors">Astro</a>
        </span>
      </p>

      <div class="flex items-center gap-1.5">
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            class="group flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800 transition-all hover:-translate-y-0.5 hover:border-brand-400 hover:text-brand-600 hover:shadow-sm"
          >
            <Icon name={s.icon} size={14} label={s.label} />
          </a>
        ))}
      </div>
    </Container>
  </div>

</footer>

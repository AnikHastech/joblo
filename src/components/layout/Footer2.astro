---
/**
 * Footer v2 — Dark editorial closer with left brand column + right link stack
 * Signature giant italic wordmark, minimal chrome, focused conversion strip.
 */
import { footerNav } from "@data/navigation";
import { site } from "@data/site";
import Container from "@components/ui/Container.astro";
import Logo from "@components/common/Logo.astro";
import Icon from "@components/ui/Icon.astro";

const socials = [
  { href: site.social.twitter,  label: "Twitter",  icon: "twitter"  as const },
  { href: site.social.linkedin, label: "LinkedIn", icon: "linkedin" as const },
  { href: site.social.github,   label: "GitHub",   icon: "github"   as const },
  { href: site.social.dribbble, label: "Dribbble", icon: "dribbble" as const },
];
---
<footer class="site-footer-v2 relative isolate overflow-hidden bg-[#0c0a09] text-stone-300">
  <div class="pointer-events-none absolute inset-0 opacity-25 bg-grid mask-radial"></div>
  <div class="pointer-events-none absolute -left-40 -top-40 h-[500px] w-[500px] rounded-full bg-brand-600/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-40 top-1/2 h-[500px] w-[500px] rounded-full bg-accent-500/15 blur-3xl"></div>

  <!-- Signup strip -->
  <div class="border-b border-white/10 py-14 sm:py-16">
    <Container size="xl">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-widest text-stone-500">Get hired sooner</p>
          <h3 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            10 best roles, delivered every <span class="font-display italic font-normal text-accent-400">Tuesday</span>.
          </h3>
        </div>
        <form onsubmit="event.preventDefault();" class="flex items-center gap-1 rounded-full border border-white/15 bg-white/5 p-1 pl-5">
          <input type="email" required placeholder="you@company.com" class="min-w-0 flex-1 bg-transparent py-3 text-[14px] text-white placeholder:text-stone-500 focus:outline-none" />
          <button type="submit" class="inline-flex h-11 shrink-0 items-center gap-1.5 rounded-full bg-white px-5 text-[13.5px] font-semibold text-ink-950 transition-colors hover:bg-stone-100">
            Subscribe
            <Icon name="arrowRight" size={12} strokeWidth={2} />
          </button>
        </form>
      </div>
    </Container>
  </div>

  <!-- Main: brand block + links -->
  <div class="py-16 sm:py-20">
    <Container size="xl">
      <div class="grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Logo variant="light" />
          <p class="mt-6 max-w-md text-[15.5px] leading-relaxed text-stone-400">
            {site.description}
          </p>

          <div class="mt-10 flex flex-col gap-6 sm:flex-row sm:items-center">
            <div class="flex items-center gap-2">
              {socials.map((s) => (
                <a href={s.href} aria-label={s.label} class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/[0.03] text-stone-300 transition-all hover:-translate-y-0.5 hover:border-accent-500/60 hover:text-accent-400">
                  <Icon name={s.icon} size={16} label={s.label} />
                </a>
              ))}
            </div>
            <div class="hidden h-8 w-px bg-white/10 sm:block"></div>
            <a href={`mailto:${site.email}`} class="text-[14px] text-stone-300 hover:text-white transition-colors">{site.email}</a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-x-8 gap-y-10 lg:col-span-7 lg:grid-cols-4">
          {Object.entries(footerNav).map(([heading, links]) => (
            <div>
              <h4 class="text-[12px] font-bold uppercase tracking-widest text-white">{heading}</h4>
              <ul class="mt-5 space-y-3.5">
                {links.map((l) => (
                  <li><a href={l.href} class="text-[14.5px] text-stone-400 hover:text-white transition-colors">{l.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10 py-6">
    <Container size="xl" class="flex flex-col items-center justify-between gap-3 text-[13px] text-stone-500 md:flex-row">
      <p>© {new Date().getFullYear()} {site.name} · <a href="https://hasthemes.com/" target="_blank" rel="noopener" class="text-stone-300 hover:text-white">HasThemes</a> · <a href="https://astro.build/" target="_blank" rel="noopener" class="text-stone-300 hover:text-white">Astro</a></p>
      <p class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms</a>
        <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
      </p>
    </Container>
  </div>
</footer>

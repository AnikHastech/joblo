---
import { primaryNav } from "@data/navigation";
import { categories } from "@data/categories";
import { locations } from "@data/locations";
import Container from "@components/ui/Container.astro";
import Logo from "@components/common/Logo.astro";
import Icon from "@components/ui/Icon.astro";

// Semantic icon → color tone (used in dropdowns + mega menu + mobile menu).
// Meaning-based, not decorative: money = green, alerts = amber, comms = sky, etc.
const iconTone: Record<string, string> = {
  home:        "brand",
  briefcase:   "accent",
  users:       "violet",
  user:        "brand",
  award:       "success",
  send:        "info",
  bell:        "warning",
  filter:      "ink",
  shield:      "info",
  trending:    "violet",
  wallet:      "success",
  sparkles:    "violet",
  search:      "info",
  bookmark:    "accent",
  building:    "brand",
  plus:        "accent",
  quote:       "violet",
  globe:       "info",
  checkCircle: "success",
  grid:        "brand",
  clock:       "ink",
  star:        "warning",
  bolt:        "warning",
  mapPin:      "accent",
  close:       "ink",
};

const toneChip: Record<string, string> = {
  brand:   "bg-brand-50 text-brand-700 group-hover/item:bg-brand-100 dark:!bg-brand-500/15 dark:!text-brand-400 dark:group-hover/item:!bg-brand-500/25",
  accent:  "bg-accent-50 text-accent-700 group-hover/item:bg-accent-100 dark:!bg-accent-500/15 dark:!text-accent-400 dark:group-hover/item:!bg-accent-500/25",
  success: "bg-emerald-50 text-emerald-700 group-hover/item:bg-emerald-100 dark:!bg-emerald-500/15 dark:!text-emerald-400 dark:group-hover/item:!bg-emerald-500/25",
  info:    "bg-sky-50 text-sky-700 group-hover/item:bg-sky-100 dark:!bg-sky-500/15 dark:!text-sky-400 dark:group-hover/item:!bg-sky-500/25",
  warning: "bg-amber-50 text-amber-700 group-hover/item:bg-amber-100 dark:!bg-amber-500/15 dark:!text-amber-400 dark:group-hover/item:!bg-amber-500/25",
  violet:  "bg-violet-50 text-violet-700 group-hover/item:bg-violet-100 dark:!bg-violet-500/15 dark:!text-violet-400 dark:group-hover/item:!bg-violet-500/25",
  ink:     "bg-ink-100 text-ink-700 group-hover/item:bg-ink-200 dark:!bg-white/[0.06] dark:!text-ink-800 dark:group-hover/item:!bg-white/[0.12]",
};

const chipFor = (name?: string) => toneChip[iconTone[name ?? ""] ?? "ink"];
---

<!-- ═══════════════════════════════════════════════════════════════
     JOBLO — Marketplace Header (2026)
     Full-width, sticky. Logo + Categories mega-menu (left),
     centre nav with rich dropdowns, notification + auth + CTA (right).
     ═══════════════════════════════════════════════════════════════ -->
<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-white/85 backdrop-blur-xl transition-all duration-300
         data-[scrolled=true]:border-ink-200/70 data-[scrolled=true]:bg-white/95 data-[scrolled=true]:shadow-[0_1px_20px_-8px_rgb(28_25_23/0.12)]"
>
  <Container size="xl" class="flex h-18 items-center gap-4 sm:gap-6">
    <!-- ── LEFT: Logo + Categories ─────────────────────── -->
    <div class="flex items-center gap-3 sm:gap-5">
      <Logo />

      <span class="hidden h-7 w-px bg-ink-200 md:block" aria-hidden="true"></span>

      <!-- Categories mega button -->
      <div class="group/cat relative hidden md:block">
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/70 px-3.5 py-2 text-[14px] font-medium text-ink-800 transition-all hover:border-ink-300 hover:bg-ink-50"
          aria-haspopup="true"
        >
          <span class="flex h-5 w-5 items-center justify-center text-brand-600">
            <Icon name="grid" size={15} strokeWidth={1.8} />
          </span>
          Categories
          <Icon name="chevronDown" size={11} class="text-ink-400 transition-transform duration-200 group-hover/cat:rotate-180" />
        </button>

        <!-- Categories mega dropdown -->
        <div class="pointer-events-none absolute left-0 top-full w-[min(520px,calc(100vw-2rem))] translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/cat:pointer-events-auto group-hover/cat:translate-y-0 group-hover/cat:opacity-100">
          <div class="rounded-xl border border-ink-200/70 bg-white p-3 shadow-2xl shadow-ink-900/15">
            <div class="grid grid-cols-2 gap-1.5">
              {categories.map((c) => (
                <a
                  href={`/categories/${c.slug}`}
                  class="group/citem flex items-center gap-3 rounded-lg p-2.5 transition-colors hover:bg-ink-50"
                >
                  <span
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-lg text-white shadow-sm transition-transform group-hover/citem:scale-105"
                    style={`background:${c.gradient}`}
                    aria-hidden="true"
                  >{c.icon}</span>
                  <div class="min-w-0 flex-1">
                    <p class="text-[13.5px] font-semibold text-ink-900">{c.name}</p>
                    <p class="text-[11.5px] text-ink-500 tabular-nums">{c.openings.toLocaleString()} openings</p>
                  </div>
                </a>
              ))}
            </div>
            <div class="mt-2 border-t border-ink-100 pt-2">
              <a href="/categories" class="flex items-center justify-between rounded-lg px-3 py-2 text-[13px] font-medium text-brand-700 hover:bg-brand-50">
                Browse all categories
                <Icon name="arrowRight" size={12} strokeWidth={2} />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── CENTER: Primary nav (desktop) ─────────────── -->
    <nav class="hidden flex-1 items-center justify-center gap-0.5 lg:flex" aria-label="Primary">
      {primaryNav.map((item) => (
        <div class="group/nav relative">
          <a
            href={item.href}
            class="relative inline-flex items-center gap-1 rounded-full px-3.5 py-2.5 text-[14px] font-medium text-ink-700 transition-colors hover:text-ink-950"
          >
            {item.label}
            {item.children && (
              <Icon name="chevronDown" size={10} class="text-ink-400 transition-transform duration-200 group-hover/nav:rotate-180" />
            )}
            <!-- underline indicator -->
            <span class="pointer-events-none absolute inset-x-3.5 -bottom-0.5 h-[2px] scale-x-0 rounded-full bg-ink-900 transition-transform duration-300 group-hover/nav:scale-x-100"></span>
          </a>

          {item.label === "Find work" ? (
            <div class="pointer-events-none absolute left-1/2 top-full w-[880px] max-w-[92vw] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 group-hover/nav:opacity-100">
              <div class="rounded-xl border border-ink-200/70 bg-white p-5 shadow-2xl shadow-ink-900/15">
                <div class="grid grid-cols-12 gap-5">
                  {/* Col 1: Explore */}
                  <div class="col-span-3 border-r border-ink-100 pr-4">
                    <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-ink-500">Explore</p>
                    <ul class="space-y-0.5">
                      {item.children!.map((c) => (
                        <li>
                          <a href={c.href} class="group/item flex items-center gap-2.5 rounded-lg px-2 py-2 transition-colors hover:bg-ink-50">
                            {c.icon && (
                              <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-md transition-colors ${chipFor(c.icon)}`}>
                                <Icon name={c.icon as any} size={13} strokeWidth={1.8} />
                              </span>
                            )}
                            <span class="flex items-center gap-1.5 text-[13.5px] font-medium text-ink-800">
                              {c.label}
                              {c.badge && (
                                <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-accent-700">
                                  {c.badge}
                                </span>
                              )}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Col 2: Categories */}
                  <div class="col-span-3">
                    <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-ink-500">By category</p>
                    <ul class="space-y-0.5">
                      {categories.slice(0, 6).map((c) => (
                        <li>
                          <a href={`/categories/${c.slug}`} class="flex items-center gap-2.5 rounded-lg px-2 py-2 hover:bg-ink-50">
                            <span
                              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-sm text-white shadow-sm"
                              style={`background:${c.gradient}`}
                              aria-hidden="true"
                            >{c.icon}</span>
                            <span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink-800">{c.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Col 3: Locations */}
                  <div class="col-span-3">
                    <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-ink-500">By location</p>
                    <ul class="space-y-0.5">
                      {locations.slice(0, 6).map((l) => (
                        <li>
                          <a href={`/jobs?location=${l.slug}`} class="flex items-center justify-between gap-2 rounded-lg px-2 py-2 hover:bg-ink-50">
                            <span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink-800">{l.city}</span>
                            <span class="shrink-0 text-[11px] tabular-nums text-ink-400">{(l.jobs / 1000).toFixed(1)}k</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Col 4: Featured card */}
                  <div class="col-span-3">
                    <a
                      href="/jobs"
                      class="group/card relative flex h-full flex-col overflow-hidden rounded-xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/60 p-5 shadow-sm transition-all hover:border-ink-300 hover:shadow-md
                             dark:from-brand-950/40 dark:via-ink-100 dark:to-accent-900/30"
                    >
                      <span aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full bg-brand-300/40 blur-2xl dark:bg-brand-500/25"></span>
                      <span aria-hidden="true" class="pointer-events-none absolute -bottom-8 -left-8 h-24 w-24 rounded-full bg-accent-300/40 blur-2xl dark:bg-accent-500/25"></span>

                      <p class="relative text-[11px] font-bold uppercase tracking-widest text-ink-500">Explore</p>
                      <p class="relative mt-2 font-display text-[34px] italic leading-none tracking-tight bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent tabular-nums">
                        128,540
                      </p>
                      <p class="relative mt-1.5 text-[12.5px] leading-snug text-ink-600">
                        open positions across 120+ countries.
                      </p>

                      <div class="relative mt-auto flex items-center justify-between pt-4">
                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-widest text-emerald-700">
                          <span class="relative flex h-1.5 w-1.5">
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                          </span>
                          Live
                        </span>
                        <span class="inline-flex items-center gap-1 rounded-full bg-ink-900 px-3 py-1.5 text-[12px] font-semibold text-ink-50 transition-transform group-hover/card:translate-x-0.5">
                          Browse all
                          <Icon name="arrowRight" size={11} strokeWidth={2.2} />
                        </span>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ) : item.children && (
            <div class={`pointer-events-none absolute left-1/2 top-full ${item.children.some((c) => c.type === "section") ? "w-[1120px] max-w-[94vw]" : "min-w-[340px]"} -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 group-hover/nav:opacity-100`}>
              <div class={`rounded-2xl border border-ink-200/70 bg-white shadow-2xl shadow-ink-900/15 ${item.children.some((c) => c.type === "section") ? "p-6" : "p-3"}`}>
                {(() => {
                  // Group children into sections when a "section" marker is present
                  const hasSections = item.children!.some((c) => c.type === "section");
                  if (!hasSections) {
                    return (
                      <div class="space-y-0.5">
                        {item.children!.map((c) => (
                          <a href={c.href} class="group/item flex items-start gap-3 rounded-lg p-3 transition-colors hover:bg-ink-50">
                            {c.icon && (
                              <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg transition-all duration-300 ${chipFor(c.icon)}`}>
                                <Icon name={c.icon as any} size={16} strokeWidth={1.8} />
                              </span>
                            )}
                            <div class="min-w-0 flex-1">
                              <p class="flex items-center gap-2 text-[14px] font-semibold text-ink-900">
                                {c.label}
                                {c.badge && (
                                  <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent-700">
                                    {c.badge}
                                  </span>
                                )}
                              </p>
                              {c.description && <p class="mt-0.5 text-[12.5px] leading-snug text-ink-500">{c.description}</p>}
                            </div>
                          </a>
                        ))}
                      </div>
                    );
                  }
                  // Build sections
                  const sections: { title: string; items: typeof item.children }[] = [];
                  item.children!.forEach((c) => {
                    if (c.type === "section") sections.push({ title: c.label, items: [] });
                    else if (sections.length) sections[sections.length - 1].items.push(c);
                  });
                  return (
                    <div class="grid grid-cols-2 gap-x-10 gap-y-6">
                      {sections.map((sec) => (
                        <div>
                          <p class="mb-4 flex items-center gap-2 px-2 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">
                            {sec.title}
                            <span class="h-px flex-1 bg-ink-200 dark:bg-white/10"></span>
                            <span class="tabular-nums text-ink-400">{sec.items.length}</span>
                          </p>
                          <div class="grid grid-cols-2 gap-x-2 gap-y-1">
                            {sec.items.map((c) => (
                              <a href={c.href} class="group/item flex items-start gap-3 rounded-lg p-3 transition-colors hover:bg-ink-50">
                                {c.icon && (
                                  <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg transition-all duration-300 ${chipFor(c.icon)}`}>
                                    <Icon name={c.icon as any} size={13} strokeWidth={1.8} />
                                  </span>
                                )}
                                <div class="min-w-0 flex-1">
                                  <p class="flex items-center gap-1.5 text-[13px] font-semibold text-ink-900">
                                    {c.label}
                                    {c.badge && (
                                      <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-accent-700">{c.badge}</span>
                                    )}
                                  </p>
                                  {c.description && <p class="mt-0.5 text-[11.5px] leading-snug text-ink-500 line-clamp-1">{c.description}</p>}
                                </div>
                              </a>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  );
                })()}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- ── RIGHT: Actions ─────────────────────────────── -->
    <div class="ml-auto flex items-center gap-1.5">
      <!-- Search — inline expand -->
      <div class="relative hidden sm:block" id="header-search-wrap">
        <button
          id="header-search-toggle"
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-full text-ink-700 transition-colors hover:bg-ink-100 hover:text-ink-950"
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="header-search-menu"
        >
          <Icon name="search" size={17} strokeWidth={1.6} />
        </button>
        <form
          id="header-search-menu"
          action="/search"
          method="get"
          role="search"
          hidden
          class="absolute right-0 top-full z-50 mt-2 w-[min(420px,calc(100vw-2rem))] rounded-2xl border border-ink-200/70 bg-white p-2 shadow-2xl shadow-ink-900/15 dark:!border-white/10 dark:!bg-ink-100"
        >
          <label class="relative block">
            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-400">
              <Icon name="search" size={15} />
            </span>
            <input
              id="header-search-input"
              name="q"
              type="search"
              placeholder="Search jobs, companies, people, articles…"
              class="h-11 w-full rounded-full border border-ink-200 bg-white pl-11 pr-24 text-[13.5px] text-ink-900 placeholder:text-ink-400 focus:border-ink-400 focus:outline-none dark:!border-white/10 dark:!bg-white/[0.04]"
            />
            <button type="submit" class="absolute right-1 top-1 inline-flex h-9 items-center gap-1 rounded-full bg-ink-900 px-3.5 text-[12.5px] font-semibold text-ink-50 hover:bg-brand-600">
              Search <span class="text-[10.5px] text-ink-400">↵</span>
            </button>
          </label>
          <div class="mt-2 flex flex-wrap items-center gap-1.5 px-1 pb-1 pt-1.5">
            <span class="text-[10.5px] uppercase tracking-widest text-ink-400">Try</span>
            {["Designer", "Remote", "Stripe", "Senior", "Salary"].map((q) => (
              <a href={`/search?q=${encodeURIComponent(q)}`} class="rounded-full border border-ink-200 bg-white px-2.5 py-0.5 text-[11.5px] text-ink-700 hover:border-ink-400 dark:!border-white/10 dark:!bg-white/[0.03]">{q}</a>
            ))}
          </div>
        </form>
      </div>

      <!-- Notification bell -->
      <button
        type="button"
        class="relative hidden h-10 w-10 items-center justify-center rounded-full text-ink-700 transition-colors hover:bg-ink-100 hover:text-ink-950 sm:flex"
        aria-label="Notifications"
      >
        <Icon name="bell" size={18} strokeWidth={1.6} />
        <span class="absolute right-2 top-2 flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500 ring-2 ring-white"></span>
        </span>
      </button>

      <!-- Login / Register -->
      <a
        href="/login"
        class="hidden items-center gap-2 rounded-full px-3.5 py-2 text-[14px] font-medium text-ink-800 transition-colors hover:bg-ink-100 md:inline-flex"
      >
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-ink-100 text-ink-700">
          <Icon name="user" size={13} strokeWidth={1.8} />
        </span>
        Login <span class="text-ink-300">/</span> Register
      </a>

      <!-- Post a job — outlined pill with gradient hover fill -->
      <a
        href="/post-a-job"
        class="group/cta relative inline-flex h-10 items-center gap-1.5 overflow-hidden rounded-full border border-ink-900 bg-transparent px-3 sm:px-4 text-[13px] sm:text-[14px] font-medium text-ink-900 transition-all hover:border-transparent hover:text-ink-50 hover:shadow-[0_8px_24px_-6px_rgb(28_25_23/0.4)]"
      >
        <span class="pointer-events-none absolute inset-0 -z-10 bg-ink-900 opacity-0 transition-opacity duration-300 group-hover/cta:opacity-100"></span>
        <span class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-brand-600 via-brand-500 to-accent-500 opacity-0 transition-opacity duration-500 group-hover/cta:opacity-100"></span>
        <Icon name="plus" size={13} strokeWidth={2.2} />
        <span class="hidden sm:inline">Post a job</span>
        <span class="sm:hidden">Post</span>
      </a>

      <!-- Mobile menu -->
      <button
        id="menu-toggle"
        type="button"
        class="ml-1 flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-800 transition-colors hover:bg-ink-100 lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={18} class="menu-icon" />
        <Icon name="close" size={18} class="close-icon hidden" />
      </button>
    </div>
  </Container>
</header>

<!-- ═══════════════════════════════════════════════════════════════
     Mobile drawer
     ═══════════════════════════════════════════════════════════════ -->
<div id="mobile-menu" hidden class="fixed inset-0 z-40 lg:hidden">
  <div id="menu-backdrop" class="absolute inset-0 bg-ink-900/40 backdrop-blur-sm"></div>
  <div class="absolute right-2 top-2 flex h-[calc(100vh-1rem)] w-[calc(100vw-1rem)] max-w-sm flex-col overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-2xl">
    <div class="flex items-center justify-between border-b border-ink-100 px-5 py-4">
      <Logo />
      <button
        type="button"
        class="menu-close flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition-colors hover:bg-ink-100"
        aria-label="Close menu"
      >
        <Icon name="close" size={16} />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto p-4" aria-label="Mobile primary">
      <!-- Categories accordion-like block -->
      <div class="mb-2 rounded-lg bg-ink-50/70 p-3">
        <p class="mb-2 px-1 text-[11px] font-semibold uppercase tracking-wider text-ink-500">Categories</p>
        <div class="grid grid-cols-2 gap-1.5">
          {categories.slice(0, 6).map((c) => (
            <a href={`/categories/${c.slug}`} class="flex items-center gap-2 rounded-lg bg-white p-2 hover:bg-ink-100">
              <span class="flex h-7 w-7 items-center justify-center rounded-md text-sm text-white" style={`background:${c.gradient}`}>{c.icon}</span>
              <span class="min-w-0 truncate text-[12.5px] font-medium text-ink-800">{c.name}</span>
            </a>
          ))}
        </div>
      </div>

      {primaryNav.map((item) => (
        <div class="mb-2">
          <a href={item.href} class="block rounded-lg px-4 py-3 text-[15px] font-semibold text-ink-900 hover:bg-ink-50">
            {item.label}
          </a>
          {item.children && (
            <div class="mt-1 space-y-0.5 pl-2">
              {item.children.map((c) => (
                c.type === "section" ? (
                  <p class="mt-3 mb-1 px-4 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">{c.label}</p>
                ) : (
                  <a href={c.href} class="group/item flex items-center gap-3 rounded-lg px-4 py-2.5 hover:bg-ink-50">
                    {c.icon && (
                      <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg ${chipFor(c.icon)}`}>
                        <Icon name={c.icon as any} size={14} strokeWidth={1.8} />
                      </span>
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="flex items-center gap-2 text-[13.5px] font-medium text-ink-800">
                        {c.label}
                        {c.badge && (
                          <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-accent-700">
                            {c.badge}
                          </span>
                        )}
                      </p>
                      {c.description && <p class="text-[11.5px] text-ink-500">{c.description}</p>}
                    </div>
                  </a>
                )
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="border-t border-ink-100 p-4">
      <a href="/login" class="flex items-center gap-2 rounded-lg px-4 py-3 text-[14.5px] font-medium text-ink-700 hover:bg-ink-50">
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-ink-100 text-ink-700">
          <Icon name="user" size={13} strokeWidth={1.8} />
        </span>
        Login / Register
      </a>
      <a
        href="/post-a-job"
        class="mt-2 inline-flex h-11 w-full items-center justify-center gap-2 rounded-full border border-ink-900 bg-transparent text-[14px] font-medium text-ink-900 transition-colors hover:bg-ink-900 hover:text-ink-50"
      >
        <Icon name="plus" size={13} strokeWidth={2.2} />
        Post a job
      </a>
    </div>
  </div>
</div>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => header?.setAttribute("data-scrolled", String(window.scrollY > 8));
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("menu-backdrop");
  const closeBtns = document.querySelectorAll(".menu-close");
  const menuIcon = toggle?.querySelector(".menu-icon");
  const closeIcon = toggle?.querySelector(".close-icon");

  const openMenu = () => {
    menu?.removeAttribute("hidden");
    toggle?.setAttribute("aria-expanded", "true");
    menuIcon?.classList.add("hidden");
    closeIcon?.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  };
  const closeMenu = () => {
    menu?.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    menuIcon?.classList.remove("hidden");
    closeIcon?.classList.add("hidden");
    document.body.style.overflow = "";
  };
  toggle?.addEventListener("click", () => {
    if (menu?.hasAttribute("hidden")) openMenu();
    else closeMenu();
  });
  backdrop?.addEventListener("click", closeMenu);
  closeBtns.forEach((b) => b.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu?.hasAttribute("hidden")) closeMenu();
  });

  // ─── Header inline search ───────────────────────────────────────
  const hsToggle = document.getElementById("header-search-toggle");
  const hsMenu   = document.getElementById("header-search-menu");
  const hsInput  = document.getElementById("header-search-input") as HTMLInputElement | null;
  const openSearch = () => {
    hsMenu?.removeAttribute("hidden");
    hsToggle?.setAttribute("aria-expanded", "true");
    setTimeout(() => hsInput?.focus(), 20);
  };
  const closeSearch = () => {
    hsMenu?.setAttribute("hidden", "");
    hsToggle?.setAttribute("aria-expanded", "false");
  };
  hsToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    hsMenu?.hasAttribute("hidden") ? openSearch() : closeSearch();
  });
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest("#header-search-wrap")) closeSearch();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSearch();
    // Cmd/Ctrl+K to open
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      openSearch();
    }
  });
</script>

---
/**
 * Header v2 — Minimal top-bar with mega search + text nav underline hover
 * No floating pill. Full-width solid, clean sharp lines.
 */
import { primaryNav } from "@data/navigation";
import { categories } from "@data/categories";
import { locations } from "@data/locations";
import { jobs } from "@data/jobs";
import { companies, getCompany } from "@data/companies";
import Container from "@components/ui/Container.astro";
import Logo from "@components/common/Logo.astro";
import Icon from "@components/ui/Icon.astro";

// Semantic icon → color tone (parity w/ Header v1)
const iconTone: Record<string, string> = {
  home: "brand", briefcase: "accent", users: "violet", user: "brand",
  award: "success", send: "info", bell: "warning", filter: "ink",
  shield: "ink", trending: "violet", wallet: "success", sparkles: "violet",
  search: "info", bookmark: "accent", building: "brand", plus: "accent",
  quote: "violet", globe: "info", checkCircle: "success", grid: "brand",
  clock: "ink", star: "warning", bolt: "warning", mapPin: "accent", close: "ink",
};
const toneChip: Record<string, string> = {
  brand:   "bg-brand-50 text-brand-700 group-hover/item:bg-brand-100 dark:!bg-brand-500/15 dark:!text-brand-400 dark:group-hover/item:!bg-brand-500/25",
  accent:  "bg-accent-50 text-accent-700 group-hover/item:bg-accent-100 dark:!bg-accent-500/15 dark:!text-accent-400 dark:group-hover/item:!bg-accent-500/25",
  success: "bg-emerald-50 text-emerald-700 group-hover/item:bg-emerald-100 dark:!bg-emerald-500/15 dark:!text-emerald-400 dark:group-hover/item:!bg-emerald-500/25",
  info:    "bg-sky-50 text-sky-700 group-hover/item:bg-sky-100 dark:!bg-sky-500/15 dark:!text-sky-400 dark:group-hover/item:!bg-sky-500/25",
  warning: "bg-amber-50 text-amber-700 group-hover/item:bg-amber-100 dark:!bg-amber-500/15 dark:!text-amber-400 dark:group-hover/item:!bg-amber-500/25",
  violet:  "bg-violet-50 text-violet-700 group-hover/item:bg-violet-100 dark:!bg-violet-500/15 dark:!text-violet-400 dark:group-hover/item:!bg-violet-500/25",
  ink:     "bg-ink-100 text-ink-700 group-hover/item:bg-ink-200 dark:!bg-white/[0.06] dark:!text-ink-800 dark:group-hover/item:!bg-white/[0.12]",
};
const chipFor = (name?: string) => toneChip[iconTone[name ?? ""] ?? "ink"];
---
<header
  id="site-header-2"
  class="sticky top-0 z-50 border-b border-ink-200/60 bg-white/95 backdrop-blur-xl dark:border-white/10 dark:!bg-ink-100/95"
>
  <!-- Top announcement strip -->
  <div class="border-b border-ink-100 bg-ink-50/60 dark:border-white/[0.06] dark:!bg-white/[0.02]">
    <Container size="xl" class="flex h-9 items-center justify-between text-[12px] text-ink-600">
      <p class="flex items-center gap-2">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        </span>
        <span class="hidden sm:inline">
          <span class="text-ink-500">128,540 open roles updated</span>
          <span class="font-semibold text-ink-900"> just now</span>
        </span>
        <span class="sm:hidden text-ink-500">128K+ roles live</span>
      </p>
      <div class="flex items-center gap-4">
        <a href="/employer" class="hidden md:inline text-ink-700 hover:text-ink-950 transition-colors">For employers →</a>
        <a href="/help" class="text-ink-700 hover:text-ink-950 transition-colors">Help</a>
      </div>
    </Container>
  </div>

  <!-- Main header row -->
  <Container size="xl" class="flex h-18 items-center gap-6">
    <Logo />

    <!-- Center: text nav with underline hover + dropdowns + mega-menu (desktop) -->
    <nav class="hidden flex-1 items-center justify-center gap-6 lg:flex" aria-label="Primary">
      {primaryNav.map((item) => (
        <div class="group/nav relative">
          <a
            href={item.href}
            class="group relative inline-flex items-center gap-1 py-2 text-[14.5px] font-medium text-ink-700 transition-colors hover:text-ink-950"
          >
            {item.label}
            {item.children && (
              <Icon name="chevronDown" size={11} class="text-ink-400 transition-transform duration-200 group-hover/nav:rotate-180" />
            )}
            <span class="pointer-events-none absolute inset-x-0 -bottom-px h-[2px] scale-x-0 rounded-full bg-gradient-to-r from-brand-500 to-accent-500 transition-transform duration-300 group-hover:scale-x-100"></span>
          </a>

          {item.label === "Find work" ? (
            <div class="pointer-events-none absolute left-1/2 top-full w-[880px] max-w-[92vw] -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 group-hover/nav:opacity-100">
              <div class="rounded-xl border border-ink-200/70 bg-white p-5 shadow-2xl shadow-ink-900/15 dark:border-white/10 dark:!bg-ink-100">
                <div class="grid grid-cols-12 gap-5">
                  {/* Col 1: Explore */}
                  <div class="col-span-3 border-r border-ink-100 pr-4 dark:!border-white/10">
                    <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-ink-500">Explore</p>
                    <ul class="space-y-0.5">
                      {item.children!.map((c) => (
                        <li>
                          <a href={c.href} class="group/item flex items-center gap-2.5 rounded-lg px-2 py-2 transition-colors hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                            {c.icon && (
                              <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-md transition-colors ${chipFor(c.icon)}`}>
                                <Icon name={c.icon as any} size={13} strokeWidth={1.8} />
                              </span>
                            )}
                            <span class="flex items-center gap-1.5 text-[13.5px] font-medium text-ink-800">
                              {c.label}
                              {c.badge && (
                                <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-accent-700">
                                  {c.badge}
                                </span>
                              )}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Col 2: Categories */}
                  <div class="col-span-3">
                    <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-ink-500">By category</p>
                    <ul class="space-y-0.5">
                      {categories.slice(0, 6).map((c) => (
                        <li>
                          <a href={`/categories/${c.slug}`} class="flex items-center gap-2.5 rounded-lg px-2 py-2 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                            <span
                              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md text-sm text-white shadow-sm"
                              style={`background:${c.gradient}`}
                              aria-hidden="true"
                            >{c.icon}</span>
                            <span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink-800">{c.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Col 3: Locations */}
                  <div class="col-span-3">
                    <p class="mb-3 text-[11px] font-bold uppercase tracking-widest text-ink-500">By location</p>
                    <ul class="space-y-0.5">
                      {locations.slice(0, 6).map((l) => (
                        <li>
                          <a href={`/jobs?location=${l.slug}`} class="flex items-center justify-between gap-2 rounded-lg px-2 py-2 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                            <span class="min-w-0 flex-1 truncate text-[13.5px] font-medium text-ink-800">{l.city}</span>
                            <span class="shrink-0 text-[11px] tabular-nums text-ink-400">{(l.jobs / 1000).toFixed(1)}k</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Col 4: Featured card */}
                  <div class="col-span-3">
                    <a
                      href="/jobs"
                      class="group/card relative flex h-full flex-col overflow-hidden rounded-xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/60 p-5 shadow-sm transition-all hover:border-ink-300 hover:shadow-md dark:!border-white/10 dark:!from-brand-950/40 dark:!via-ink-100 dark:!to-accent-900/30"
                    >
                      <span aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full bg-brand-300/40 blur-2xl dark:!bg-brand-500/25"></span>
                      <span aria-hidden="true" class="pointer-events-none absolute -bottom-8 -left-8 h-24 w-24 rounded-full bg-accent-300/40 blur-2xl dark:!bg-accent-500/25"></span>

                      <p class="relative text-[11px] font-bold uppercase tracking-widest text-ink-500">Explore</p>
                      <p class="relative mt-2 font-display text-[34px] italic leading-none tracking-tight bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent tabular-nums">
                        128,540
                      </p>
                      <p class="relative mt-1.5 text-[12.5px] leading-snug text-ink-600">
                        open positions across 120+ countries.
                      </p>

                      <div class="relative mt-auto flex items-center justify-between pt-4">
                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-widest text-emerald-700 dark:!text-emerald-400">
                          <span class="relative flex h-1.5 w-1.5">
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                          </span>
                          Live
                        </span>
                        <span class="inline-flex items-center gap-1 rounded-full bg-ink-900 px-3 py-1.5 text-[12px] font-semibold text-ink-50 transition-transform group-hover/card:translate-x-0.5">
                          Browse all
                          <Icon name="arrowRight" size={11} strokeWidth={2.2} />
                        </span>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ) : item.children && (
            <div class={`pointer-events-none absolute left-1/2 top-full ${item.children.some((c) => c.type === "section") ? "w-[1040px] max-w-[94vw]" : "min-w-[340px]"} -translate-x-1/2 translate-y-2 pt-3 opacity-0 transition-all duration-200 group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 group-hover/nav:opacity-100`}>
              <div class="rounded-xl border border-ink-200/70 bg-white p-3 shadow-2xl shadow-ink-900/15 dark:border-white/10 dark:!bg-ink-100">
                {(() => {
                  const hasSections = item.children!.some((c) => c.type === "section");
                  if (!hasSections) {
                    return (
                      <div class="space-y-0.5">
                        {item.children!.map((c) => (
                          <a href={c.href} class="group/item flex items-start gap-3 rounded-lg p-3 transition-colors hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                            {c.icon && (
                              <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-lg transition-all duration-300 ${chipFor(c.icon)}`}>
                                <Icon name={c.icon as any} size={16} strokeWidth={1.8} />
                              </span>
                            )}
                            <div class="min-w-0 flex-1">
                              <p class="flex items-center gap-2 text-[14px] font-semibold text-ink-900">
                                {c.label}
                                {c.badge && (
                                  <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent-700">{c.badge}</span>
                                )}
                              </p>
                              {c.description && <p class="mt-0.5 text-[12.5px] leading-snug text-ink-500">{c.description}</p>}
                            </div>
                          </a>
                        ))}
                      </div>
                    );
                  }
                  // Sectioned layout — 2 sections, each with 2-column item grid
                  const sections: { title: string; items: typeof item.children }[] = [];
                  item.children!.forEach((c) => {
                    if (c.type === "section") sections.push({ title: c.label, items: [] });
                    else if (sections.length) sections[sections.length - 1].items.push(c);
                  });
                  return (
                    <div class="grid grid-cols-2 gap-x-6 gap-y-4">
                      {sections.map((sec) => (
                        <div>
                          <p class="mb-3 flex items-center gap-2 px-2 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">
                            {sec.title}
                            <span class="h-px flex-1 bg-ink-200 dark:bg-white/10"></span>
                            <span class="tabular-nums text-ink-400">{sec.items.length}</span>
                          </p>
                          <div class="grid grid-cols-2 gap-x-1 gap-y-0.5">
                            {sec.items.map((c) => (
                              <a href={c.href} class="group/item flex items-start gap-2.5 rounded-lg p-2.5 transition-colors hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                                {c.icon && (
                                  <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg transition-all duration-300 ${chipFor(c.icon)}`}>
                                    <Icon name={c.icon as any} size={13} strokeWidth={1.8} />
                                  </span>
                                )}
                                <div class="min-w-0 flex-1">
                                  <p class="flex items-center gap-1.5 text-[13px] font-semibold text-ink-900">
                                    {c.label}
                                    {c.badge && (
                                      <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-accent-700">{c.badge}</span>
                                    )}
                                  </p>
                                  {c.description && <p class="mt-0.5 text-[11.5px] leading-snug text-ink-500 line-clamp-1">{c.description}</p>}
                                </div>
                              </a>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  );
                })()}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <!-- Search trigger — desktop pill / mobile icon -->
      <button
        type="button"
        id="hdr2-search-open"
        class="group hidden h-10 items-center gap-2 rounded-full border border-ink-200 bg-white pl-3 pr-2 text-[13.5px] text-ink-500 transition-all hover:border-ink-300 hover:text-ink-800 md:inline-flex dark:border-white/10 dark:!bg-white/[0.04] dark:hover:!bg-white/[0.07]"
        aria-label="Open search"
      >
        <Icon name="search" size={15} />
        <span class="w-40 text-left">Search jobs, companies…</span>
        <kbd class="pointer-events-none rounded border border-ink-200 bg-ink-50 px-1.5 py-0.5 text-[10px] font-medium text-ink-500 dark:border-white/10 dark:!bg-white/[0.05]">⌘K</kbd>
      </button>

      <!-- Mobile search icon (below md) -->
      <button
        type="button"
        id="hdr2-search-open-mobile"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition-colors hover:bg-ink-100 md:hidden dark:border-white/15"
        aria-label="Open search"
      >
        <Icon name="search" size={16} />
      </button>

      <a href="/login" class="hidden text-[14px] font-medium text-ink-700 transition-colors hover:text-ink-950 md:inline">Sign in</a>

      <a
        href="/signup"
        class="inline-flex h-10 items-center gap-1.5 rounded-full bg-gradient-to-r from-brand-600 to-accent-500 px-4 text-[14px] font-semibold text-white shadow-sm transition-all hover:shadow-[0_8px_24px_-6px_rgb(74_63_230/0.5)]"
      >
        Get started
        <Icon name="arrowRight" size={13} strokeWidth={2} />
      </a>

      <button
        id="menu-toggle-2"
        type="button"
        class="ml-1 flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-800 transition-colors hover:bg-ink-100 lg:hidden dark:border-white/15"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="menu" size={18} class="menu-icon" />
        <Icon name="close" size={18} class="close-icon hidden" />
      </button>
    </div>
  </Container>
</header>

<!-- Mobile drawer -->
<div id="mobile-menu-2" hidden class="fixed inset-0 z-[70] lg:hidden">
  <div class="menu-backdrop absolute inset-0 bg-ink-900/40 backdrop-blur-sm"></div>
  <div class="absolute inset-y-0 right-0 flex w-full max-w-sm flex-col border-l border-ink-200 bg-white shadow-2xl dark:border-white/10 dark:!bg-ink-100">
    <div class="flex items-center justify-between border-b border-ink-100 px-5 py-4 dark:border-white/10">
      <Logo />
      <button type="button" class="menu-close flex h-10 w-10 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition-colors hover:bg-ink-100 dark:border-white/15" aria-label="Close menu">
        <Icon name="close" size={16} />
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto p-4" aria-label="Mobile primary">
      <!-- Categories mini-grid -->
      <div class="mb-3 rounded-lg bg-ink-50/70 p-3 dark:!bg-white/[0.03]">
        <p class="mb-2 px-1 text-[11px] font-bold uppercase tracking-widest text-ink-500">Categories</p>
        <div class="grid grid-cols-2 gap-1.5">
          {categories.slice(0, 6).map((c) => (
            <a href={`/categories/${c.slug}`} class="flex items-center gap-2 rounded-md bg-white p-2 hover:bg-ink-100 dark:!bg-white/[0.04] dark:hover:!bg-white/[0.08]">
              <span class="flex h-7 w-7 items-center justify-center rounded-md text-sm text-white" style={`background:${c.gradient}`}>{c.icon}</span>
              <span class="min-w-0 truncate text-[12.5px] font-medium text-ink-800">{c.name}</span>
            </a>
          ))}
        </div>
      </div>

      {primaryNav.map((item) => (
        <div class="mb-2">
          <a href={item.href} class="block rounded-lg px-4 py-3 text-[15px] font-semibold text-ink-900 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
            {item.label}
          </a>
          {item.children && (
            <div class="mt-1 space-y-0.5 pl-2">
              {item.children.map((c) => (
                c.type === "section" ? (
                  <p class="mt-3 mb-1 px-4 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">{c.label}</p>
                ) : (
                  <a href={c.href} class="group/item flex items-center gap-3 rounded-lg px-4 py-2.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                    {c.icon && (
                      <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-md ${chipFor(c.icon)}`}>
                        <Icon name={c.icon as any} size={14} strokeWidth={1.8} />
                      </span>
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="flex items-center gap-2 text-[13.5px] font-medium text-ink-800">
                        {c.label}
                        {c.badge && (
                          <span class="rounded-full bg-accent-100 px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wider text-accent-700">
                            {c.badge}
                          </span>
                        )}
                      </p>
                      {c.description && <p class="text-[11.5px] text-ink-500">{c.description}</p>}
                    </div>
                  </a>
                )
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    <div class="border-t border-ink-100 p-4 dark:border-white/10">
      <a href="/login" class="block rounded-lg px-4 py-3 text-[14.5px] font-medium text-ink-700 hover:bg-ink-50">Sign in</a>
      <a href="/signup" class="mt-2 inline-flex h-11 w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-brand-600 to-accent-500 px-4 text-[14px] font-semibold text-white">Get started</a>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Search command palette (modal)
     ═══════════════════════════════════════════════════════════════ -->
<div id="search-modal" hidden class="fixed inset-0 z-[80]">
  <div id="search-backdrop" class="absolute inset-0 bg-ink-900/50 backdrop-blur-md"></div>
  <div class="relative mx-auto mt-24 w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-2xl dark:border-white/15 dark:!bg-ink-100 sm:mt-28">
    <!-- Search input -->
    <!-- Search form (Enter submits to /search) -->
    <form
      id="search-form"
      action="/search"
      method="get"
      role="search"
      class="flex items-center gap-3 border-b border-ink-100 px-5 py-4 dark:border-white/10"
    >
      <Icon name="search" size={18} class="shrink-0 text-ink-400" />
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="Search jobs, companies, categories…"
        class="w-full bg-transparent text-[16px] text-ink-900 placeholder:text-ink-400 focus:outline-none"
        autocomplete="off"
      />
      <button type="button" id="search-close" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink-200 text-ink-500 transition-colors hover:bg-ink-100 dark:border-white/15" aria-label="Close">
        <Icon name="close" size={14} />
      </button>
      <kbd class="pointer-events-none hidden rounded border border-ink-200 bg-ink-50 px-1.5 py-0.5 text-[10px] font-medium text-ink-500 sm:inline-block dark:border-white/10 dark:!bg-white/[0.05]">ESC</kbd>
    </form>

    <div class="max-h-[60vh] overflow-y-auto p-3">
      <!-- ═══ Default view (no query) — trending + quick links ═══ -->
      <div id="search-default">
        <p class="mb-2 px-3 pt-1 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">Trending searches</p>
        <ul class="mb-4 space-y-0.5">
          {["Senior Product Designer", "Staff Engineer", "Growth Marketing Lead", "ML Research Engineer", "Brand Designer"].map((q) => (
            <li>
              <a href={`/search?q=${encodeURIComponent(q)}`} class="group flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-ink-100 text-ink-600 dark:!bg-white/[0.06]">
                  <Icon name="search" size={13} />
                </span>
                <span class="flex-1 text-[14px] text-ink-800">{q}</span>
                <Icon name="arrowUpRight" size={12} class="text-ink-400 opacity-0 transition-opacity group-hover:opacity-100" />
              </a>
            </li>
          ))}
        </ul>

        <p class="mb-2 px-3 pt-1 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">Quick links</p>
        <div class="grid grid-cols-2 gap-1.5">
          {[
            { label: "Browse all jobs",  href: "/jobs",             icon: "briefcase" as const, tone: "text-brand-600 bg-brand-50" },
            { label: "Remote roles",     href: "/jobs?remote=true", icon: "globe"     as const, tone: "text-emerald-700 bg-emerald-50" },
            { label: "Top companies",    href: "/companies",        icon: "building"  as const, tone: "text-ink-700 bg-ink-100" },
            { label: "Categories",       href: "/categories",       icon: "grid"      as const, tone: "text-accent-700 bg-accent-50" },
          ].map((l) => (
            <a href={l.href} class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
              <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-md ${l.tone}`}>
                <Icon name={l.icon} size={13} strokeWidth={1.8} />
              </span>
              <span class="text-[13.5px] font-medium text-ink-800">{l.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- ═══ Live results (hidden by default, shown when query > 0) ═══ -->
      <div id="search-results" hidden>
        <!-- Jobs group -->
        <div class="search-group" data-group="jobs">
          <p class="mb-2 flex items-center justify-between px-3 pt-1 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">
            <span class="inline-flex items-center gap-1.5"><Icon name="briefcase" size={10} /> Jobs</span>
            <span class="search-count tabular-nums text-ink-400">0</span>
          </p>
          <ul class="mb-4 space-y-0.5">
            {jobs.map((j) => {
              const c = getCompany(j.companyId);
              return (
                <li
                  class="search-item"
                  data-hay={`${j.title} ${j.tags.join(" ")} ${c.name} ${j.location} ${j.type} ${j.experience}`.toLowerCase()}
                  hidden
                >
                  <a href={`/jobs/${j.slug}`} class="group flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-[11px] font-bold text-white" style={`background:${c.brandColor}`}>
                      {c.name[0]}
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="line-clamp-1 text-[13.5px] font-medium text-ink-900">{j.title}</p>
                      <p class="mt-0.5 text-[11.5px] text-ink-500 line-clamp-1">{c.name} · {j.location}</p>
                    </div>
                    <Icon name="arrowUpRight" size={11} class="shrink-0 text-ink-400 opacity-0 transition-opacity group-hover:opacity-100" />
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Companies group -->
        <div class="search-group" data-group="companies">
          <p class="mb-2 flex items-center justify-between px-3 pt-1 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">
            <span class="inline-flex items-center gap-1.5"><Icon name="building" size={10} /> Companies</span>
            <span class="search-count tabular-nums text-ink-400">0</span>
          </p>
          <ul class="mb-4 space-y-0.5">
            {companies.map((c) => (
              <li
                class="search-item"
                data-hay={`${c.name} ${c.industry} ${c.location}`.toLowerCase()}
                hidden
              >
                <a href={`/companies/${c.slug}`} class="group flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-[11px] font-bold text-white" style={`background:${c.brandColor}`}>
                    {c.name[0]}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="line-clamp-1 text-[13.5px] font-medium text-ink-900">{c.name}</p>
                    <p class="mt-0.5 text-[11.5px] text-ink-500 line-clamp-1">{c.industry} · {c.location}</p>
                  </div>
                  <Icon name="arrowUpRight" size={11} class="shrink-0 text-ink-400 opacity-0 transition-opacity group-hover:opacity-100" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Categories group -->
        <div class="search-group" data-group="categories">
          <p class="mb-2 flex items-center justify-between px-3 pt-1 text-[10.5px] font-bold uppercase tracking-widest text-ink-500">
            <span class="inline-flex items-center gap-1.5"><Icon name="grid" size={10} /> Categories</span>
            <span class="search-count tabular-nums text-ink-400">0</span>
          </p>
          <ul class="mb-4 space-y-0.5">
            {categories.map((c) => (
              <li
                class="search-item"
                data-hay={`${c.name} ${c.slug}`.toLowerCase()}
                hidden
              >
                <a href={`/categories/${c.slug}`} class="group flex items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-lg text-white shadow-sm" style={`background:${c.gradient}`} aria-hidden="true">
                    {c.icon}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="line-clamp-1 text-[13.5px] font-medium text-ink-900">{c.name}</p>
                    <p class="mt-0.5 text-[11.5px] text-ink-500 tabular-nums">{c.openings.toLocaleString()} openings</p>
                  </div>
                  <Icon name="arrowUpRight" size={11} class="shrink-0 text-ink-400 opacity-0 transition-opacity group-hover:opacity-100" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- "See all results" jump -->
        <a id="search-see-all" href="/search" class="group flex items-center justify-center gap-2 rounded-lg border border-dashed border-ink-200 px-3 py-3 text-[13px] font-medium text-ink-700 transition-colors hover:border-ink-400 hover:bg-ink-50 dark:!border-white/10 dark:hover:!bg-white/[0.04]">
          See all results
          <Icon name="arrowRight" size={12} class="transition-transform group-hover:translate-x-0.5" />
        </a>

        <!-- No results -->
        <div id="search-empty" hidden class="mt-2 rounded-lg border border-dashed border-ink-200 bg-ink-50/40 p-6 text-center dark:!border-white/10 dark:!bg-white/[0.02]">
          <p class="text-[13px] font-medium text-ink-800">No matches for "<span id="search-empty-q"></span>"</p>
          <p class="mt-1 text-[11.5px] text-ink-500">Try a shorter or different keyword.</p>
        </div>
      </div>
    </div>

    <!-- Footer with kbd hints -->
    <div class="flex items-center justify-between border-t border-ink-100 bg-ink-50/60 px-5 py-3 text-[11.5px] text-ink-500 dark:border-white/10 dark:!bg-white/[0.02]">
      <span class="flex items-center gap-2">
        <kbd class="rounded border border-ink-200 bg-white px-1.5 py-0.5 text-[10px] font-medium dark:border-white/10 dark:!bg-white/[0.06]">↵</kbd>
        Open · full results
      </span>
      <span class="flex items-center gap-2">
        <kbd class="rounded border border-ink-200 bg-white px-1.5 py-0.5 text-[10px] font-medium dark:border-white/10 dark:!bg-white/[0.06]">esc</kbd>
        Close
      </span>
      <span class="hidden sm:inline">Powered by <span class="font-semibold text-ink-700">Joblo Search</span></span>
    </div>
  </div>
</div>

<script>
  const searchOpen       = document.getElementById("hdr2-search-open");
  const searchOpenMobile = document.getElementById("hdr2-search-open-mobile");
  const searchModal      = document.getElementById("search-modal");
  const searchInput      = document.getElementById("search-input") as HTMLInputElement | null;
  const searchClose      = document.getElementById("search-close");
  const searchBackdrop   = document.getElementById("search-backdrop");

  // Live results controls
  const searchDefault = document.getElementById("search-default");
  const searchResults = document.getElementById("search-results");
  const searchEmpty   = document.getElementById("search-empty");
  const searchEmptyQ  = document.getElementById("search-empty-q");
  const searchSeeAll  = document.getElementById("search-see-all") as HTMLAnchorElement | null;
  const searchItems   = document.querySelectorAll<HTMLElement>(".search-item");
  const searchGroups  = document.querySelectorAll<HTMLElement>(".search-group");

  const openSearch = () => {
    searchModal?.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
    setTimeout(() => searchInput?.focus(), 60);
  };
  const closeSearch = () => {
    searchModal?.setAttribute("hidden", "");
    document.body.style.overflow = "";
  };
  searchOpen?.addEventListener("click", openSearch);
  searchOpenMobile?.addEventListener("click", openSearch);
  searchClose?.addEventListener("click", closeSearch);
  searchBackdrop?.addEventListener("click", closeSearch);
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      searchModal?.hasAttribute("hidden") ? openSearch() : closeSearch();
    }
    if (e.key === "Escape" && !searchModal?.hasAttribute("hidden")) closeSearch();
  });

  // ═══ Live filtering as user types ═══
  const applyFilter = () => {
    const q = (searchInput?.value ?? "").trim().toLowerCase();

    // Empty query → show default view (trending + quick links)
    if (!q) {
      if (searchDefault) searchDefault.hidden = false;
      if (searchResults) searchResults.hidden = true;
      return;
    }

    // Query mode → hide default, show results
    if (searchDefault) searchDefault.hidden = true;
    if (searchResults) searchResults.hidden = false;

    let totalMatched = 0;
    const perGroupLimit = 4;

    searchGroups.forEach((group) => {
      let matched = 0;
      const items = group.querySelectorAll<HTMLElement>(".search-item");
      items.forEach((item) => {
        const hay = item.dataset.hay ?? "";
        const isMatch = hay.includes(q);
        // Only show up to perGroupLimit per group
        if (isMatch && matched < perGroupLimit) {
          item.hidden = false;
          matched++;
        } else {
          item.hidden = true;
        }
      });
      // Group visibility + count
      const countEl = group.querySelector<HTMLElement>(".search-count");
      if (countEl) countEl.textContent = String(matched);
      group.hidden = matched === 0;
      totalMatched += matched;
    });

    // Empty state
    if (searchEmpty) searchEmpty.hidden = totalMatched > 0;
    if (searchEmptyQ) searchEmptyQ.textContent = q;

    // Update "See all results" href to include q
    if (searchSeeAll) {
      searchSeeAll.href = `/search?q=${encodeURIComponent(q)}`;
      searchSeeAll.hidden = totalMatched === 0;
    }
  };

  let debounceTimer: number | undefined;
  searchInput?.addEventListener("input", () => {
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(applyFilter, 80);
  });
</script>

<script>
  const toggle = document.getElementById("menu-toggle-2");
  const menu = document.getElementById("mobile-menu-2");
  const backdrop = menu?.querySelector(".menu-backdrop");
  const closeBtns = menu?.querySelectorAll(".menu-close");
  const menuIcon = toggle?.querySelector(".menu-icon");
  const closeIcon = toggle?.querySelector(".close-icon");
  const open = () => { menu?.removeAttribute("hidden"); menuIcon?.classList.add("hidden"); closeIcon?.classList.remove("hidden"); document.body.style.overflow = "hidden"; toggle?.setAttribute("aria-expanded","true"); };
  const close = () => { menu?.setAttribute("hidden",""); menuIcon?.classList.remove("hidden"); closeIcon?.classList.add("hidden"); document.body.style.overflow = ""; toggle?.setAttribute("aria-expanded","false"); };
  toggle?.addEventListener("click", () => menu?.hasAttribute("hidden") ? open() : close());
  backdrop?.addEventListener("click", close);
  closeBtns?.forEach((b) => b.addEventListener("click", close));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !menu?.hasAttribute("hidden")) close(); });
</script>

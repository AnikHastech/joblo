---
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import { locations } from "@data/locations";

const [featured, ...cities] = locations;
const topRow = cities.slice(0, 2);    // SF, NYC (col-6 each on the right of featured)
const bottomRow = cities.slice(2);    // London, Berlin, Tokyo, Singapore (col-3 each)
---
<section class="section-jobs-by-location py-20 sm:py-28 bg-white">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={8} label="Where teams hire" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          Find work in the world's
          <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">creative hubs</span>.
        </h2>
        <p class="mt-4 max-w-xl text-lg text-ink-600">
          From San Francisco to Singapore — thousands of open roles in the cities where the best teams are building.
        </p>
      </div>
      <a href="/jobs" class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3 text-[14.5px] font-medium text-ink-900 transition-all hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50">
        Browse all locations
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <!-- Bento grid -->
    <div class="mt-14 grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-12 lg:auto-rows-[220px]">
      <!-- Featured: Remote — spans 2 rows on lg -->
      <a
        href={`/jobs?location=${featured.slug}`}
        class="group relative overflow-hidden rounded-3xl border border-ink-200/70 aspect-[4/5] sm:col-span-2 sm:aspect-[4/3] lg:col-span-5 lg:row-span-2 lg:aspect-auto"
      >
        <img
          src={featured.imageUrl}
          alt=""
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[900ms] group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/45"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-brand-600/25 via-transparent to-accent-500/25 mix-blend-overlay"></div>

        <div class="relative flex h-full flex-col justify-between p-7 sm:p-9">
          <!-- Top badges -->
          <div class="flex items-start justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-md ring-1 ring-white/20">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-80"></span>
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              </span>
              Featured
            </span>
            <Icon name="globe" size={22} class="text-white/80" />
          </div>

          <!-- Bottom content -->
          <div>
            <p class="text-[13px] font-medium uppercase tracking-[0.2em] text-white/70">{featured.country}</p>
            <h3 class="mt-2 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
              {featured.city}
            </h3>
            <p class="mt-3 max-w-md text-[15px] leading-relaxed text-white/80">
              Hiring across every timezone. Work from anywhere the internet reaches.
            </p>

            <!-- Stats strip -->
            <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-white/15 pt-5">
              <div>
                <dt class="text-[11px] uppercase tracking-wider text-white/60">Open roles</dt>
                <dd class="mt-0.5 text-lg font-semibold text-white tabular-nums">{featured.jobs.toLocaleString()}</dd>
              </div>
              <div>
                <dt class="text-[11px] uppercase tracking-wider text-white/60">Companies</dt>
                <dd class="mt-0.5 text-lg font-semibold text-white tabular-nums">{featured.companies?.toLocaleString()}</dd>
              </div>
              <div>
                <dt class="text-[11px] uppercase tracking-wider text-white/60">Avg salary</dt>
                <dd class="mt-0.5 text-lg font-semibold text-white tabular-nums">{featured.avgSalary}</dd>
              </div>
            </dl>

            <div class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-[14px] font-semibold text-ink-900 transition-all group-hover:gap-3 group-hover:bg-accent-500 group-hover:text-white">
              Explore remote roles
              <Icon name="arrowRight" size={14} strokeWidth={2} />
            </div>
          </div>
        </div>
      </a>

      <!-- Top row: SF + NYC -->
      {topRow.map((loc) => (
        <a
          href={`/jobs?location=${loc.slug}`}
          class="group relative overflow-hidden rounded-3xl border border-ink-200/70 aspect-[4/3] lg:col-span-7 lg:aspect-auto"
        >
          <img
            src={loc.imageUrl}
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/55"></div>

          <div class="relative flex h-full flex-col justify-end p-6">
            <p class="text-[11px] font-medium uppercase tracking-widest text-white/70">{loc.country}</p>
            <h3 class="mt-1 text-2xl font-semibold tracking-tight text-white sm:text-[26px]">
              {loc.city}
            </h3>

            <div class="mt-4 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-[12px] font-medium text-white backdrop-blur-md ring-1 ring-white/15">
                  <Icon name="briefcase" size={11} strokeWidth={2} />
                  <span class="tabular-nums">{loc.jobs.toLocaleString()}</span> jobs
                </span>
                {loc.avgSalary && (
                  <span class="hidden rounded-full bg-white/15 px-3 py-1 text-[12px] font-medium text-white backdrop-blur-md ring-1 ring-white/15 sm:inline-flex tabular-nums">
                    {loc.avgSalary} avg
                  </span>
                )}
              </div>
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 text-white ring-1 ring-white/20 backdrop-blur-md transition-all group-hover:bg-white group-hover:text-ink-900">
                <Icon name="arrowUpRight" size={13} strokeWidth={2} />
              </span>
            </div>
          </div>
        </a>
      ))}

      <!-- Bottom row: 4 small cities -->
      {bottomRow.map((loc) => (
        <a
          href={`/jobs?location=${loc.slug}`}
          class="group relative overflow-hidden rounded-3xl border border-ink-200/70 aspect-[4/3] sm:aspect-auto sm:h-[220px] lg:col-span-3 lg:aspect-auto"
        >
          <img
            src={loc.imageUrl}
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/50"></div>

          <div class="relative flex h-full flex-col justify-end p-5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-white/70">{loc.country}</p>
            <h3 class="mt-1 text-lg font-semibold tracking-tight text-white">
              {loc.city}
            </h3>
            <div class="mt-3 flex items-center justify-between">
              <span class="text-[12px] font-medium text-white/85 tabular-nums">
                {loc.jobs.toLocaleString()} jobs
              </span>
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/15 text-white ring-1 ring-white/20 backdrop-blur-md transition-all group-hover:bg-white group-hover:text-ink-900">
                <Icon name="arrowUpRight" size={11} strokeWidth={2} />
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>

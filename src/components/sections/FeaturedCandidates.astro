---
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import BrandLogo from "@components/common/BrandLogo.astro";
import { featuredCandidates } from "@data/candidates";

const availabilityStyles: Record<string, string> = {
  "Open to offers":         "bg-emerald-100 text-emerald-700",
  "Available in 2 weeks":   "bg-amber-100 text-amber-800",
  "Interviewing":           "bg-brand-100 text-brand-700",
};
const availabilityDot: Record<string, string> = {
  "Open to offers":         "bg-emerald-500",
  "Available in 2 weeks":   "bg-amber-500",
  "Interviewing":           "bg-brand-500",
};
---
<section class="section-featured-candidates pt-20 pb-0 sm:pt-28 sm:pb-0 bg-white">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={7} label="Featured candidates" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          The talent
          <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">everyone's after.</span>
        </h2>
        <p class="mt-4 max-w-xl text-lg text-ink-600">
          Hand-picked professionals, verified portfolios, real availability. Reach out directly — no gatekeepers.
        </p>
      </div>
      <a href="/candidates" class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3 text-[14.5px] font-medium text-ink-900 transition-all hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50">
        Browse all candidates
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featuredCandidates.map((c) => (
        <article class="group relative flex flex-col rounded-xl border border-ink-200/70 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:border-white/[0.08] dark:!bg-white/[0.035] dark:hover:border-white/20 dark:hover:!bg-white/[0.055]">
          <!-- Availability badge (top-right) -->
          <div class="absolute right-5 top-5">
            <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold ${availabilityStyles[c.availability]}`}>
              <span class={`h-1.5 w-1.5 rounded-full ${availabilityDot[c.availability]}`}></span>
              {c.availability}
            </span>
          </div>

          <!-- Header -->
          <header class="flex items-start gap-4 pr-2">
            <div class="relative shrink-0">
              <img
                src={c.avatar}
                alt={c.name}
                width="60"
                height="60"
                loading="lazy"
                class="h-15 w-15 rounded-full bg-ink-100 ring-2 ring-white shadow-sm"
              />
              {c.verified && (
                <span class="absolute -bottom-1 -right-1 flex h-6 w-6 items-center justify-center rounded-full bg-brand-600 text-white ring-2 ring-white" title="Verified profile" aria-label="Verified">
                  <Icon name="check" size={12} strokeWidth={2.5} />
                </span>
              )}
            </div>
            <div class="min-w-0 flex-1 pt-1">
              <h3 class="text-[17px] font-semibold tracking-tight text-ink-900 group-hover:text-brand-700 transition-colors">
                <a href={`/candidates/${c.slug}`} class="after:absolute after:inset-0">{c.name}</a>
              </h3>
              <p class="mt-0.5 text-[13.5px] text-ink-600">{c.role}</p>
            </div>
          </header>

          <!-- Meta row -->
          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[13px] text-ink-600">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="mapPin" size={12} />
              {c.location}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="clock" size={12} />
              {c.experienceYears} yrs
            </span>
          </div>

          <!-- Skills -->
          <div class="mt-4 flex flex-wrap gap-1.5">
            {c.skills.map((s) => <Badge variant="outline" size="sm">{s}</Badge>)}
          </div>

          <!-- Footer -->
          <footer class="mt-5 flex items-end justify-between border-t border-ink-100 pt-4">
            <div>
              <p class="text-[10.5px] uppercase tracking-wider text-ink-400">Rate</p>
              <p class="font-semibold tracking-tight text-ink-900 tabular-nums">{c.rate}</p>
            </div>
            {c.workedAtSlug && (
              <div class="flex items-center gap-2">
                <div class="text-right">
                  <p class="text-[10.5px] uppercase tracking-wider text-ink-400">Last at</p>
                  <p class="text-[13px] font-medium text-ink-800">{c.workedAtName}</p>
                </div>
                <BrandLogo slug={c.workedAtSlug} size="xs" />
              </div>
            )}
          </footer>
        </article>
      ))}
    </div>
  </Container>
</section>

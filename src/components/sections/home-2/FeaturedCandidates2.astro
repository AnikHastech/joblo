---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import Badge from "@components/ui/Badge.astro";
import BrandLogo from "@components/common/BrandLogo.astro";
import { featuredCandidates } from "@data/candidates";

const availTone: Record<string, string> = {
  "Open to offers":         "text-emerald-700 bg-emerald-100",
  "Available in 2 weeks":   "text-amber-800   bg-amber-100",
  "Interviewing":           "text-brand-700   bg-brand-100",
};
---
<section class="section-featured-candidates-2 py-20 sm:py-28 bg-white dark:!bg-white/[0.02]">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={7} label="Featured candidates" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          The talent everyone's after.
        </h2>
      </div>
      <a href="/candidates" class="inline-flex items-center gap-2 text-[14.5px] font-semibold text-brand-700 hover:gap-3 transition-all">
        Browse all
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <!-- Horizontal list rows -->
    <ul class="mt-10 space-y-3">
      {featuredCandidates.map((c) => (
        <li>
          <a href={`/candidates/${c.slug}`} class="group grid grid-cols-12 items-center gap-4 rounded-xl border border-ink-200/70 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-md sm:p-5 dark:border-white/[0.08] dark:!bg-white/[0.035]">
            <!-- Avatar + name -->
            <div class="col-span-12 flex items-center gap-4 sm:col-span-4">
              <div class="relative shrink-0">
                <img src={c.avatar} alt="" width="52" height="52" loading="lazy" class="h-13 w-13 rounded-full bg-ink-100 ring-2 ring-white shadow-sm" />
                {c.verified && (
                  <span class="absolute -bottom-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-white ring-2 ring-white">
                    <Icon name="check" size={10} strokeWidth={2.5} />
                  </span>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate text-[16px] font-semibold text-ink-900 group-hover:text-brand-700 transition-colors">{c.name}</p>
                <p class="truncate text-[12.5px] text-ink-500">{c.role}</p>
              </div>
            </div>
            <!-- Skills -->
            <div class="col-span-12 flex flex-wrap gap-1.5 sm:col-span-4">
              {c.skills.slice(0,3).map((s) => <Badge variant="outline" size="sm">{s}</Badge>)}
            </div>
            <!-- Availability -->
            <div class="col-span-6 sm:col-span-2">
              <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold ${availTone[c.availability]}`}>
                <span class="h-1.5 w-1.5 rounded-full bg-current opacity-60"></span>
                {c.availability}
              </span>
            </div>
            <!-- Rate + last -->
            <div class="col-span-6 flex items-center justify-end gap-3 sm:col-span-2">
              <div class="text-right">
                <p class="text-[10.5px] uppercase tracking-widest text-ink-400">Rate</p>
                <p class="text-[15px] font-semibold text-ink-900 tabular-nums">{c.rate}</p>
              </div>
              {c.workedAtSlug && <BrandLogo slug={c.workedAtSlug} size="xs" />}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>

---
import Container from "@components/ui/Container.astro";
import Icon from "@components/ui/Icon.astro";
import BrandLogo from "@components/common/BrandLogo.astro";
import { site } from "@data/site";
import { companies } from "@data/companies";

const popular = ["AI/ML", "Product Design", "Growth", "Rust", "Staff Engineer"];
// Doubled row so the marquee loops seamlessly (matches Home 1's TrustedCompanies)
const marqueeRow = [...companies, ...companies];
---
<section class="section-hero-2 relative isolate overflow-x-clip pt-14 pb-20 sm:pt-20 md:pt-24 lg:pt-28">
  <!-- Backdrop -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-grid opacity-40 mask-radial"></div>
  <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[680px] w-[1100px] -translate-x-1/2 rounded-[50%] bg-gradient-to-b from-brand-200/40 via-accent-200/30 to-transparent blur-3xl dark:from-brand-500/20 dark:via-accent-500/15"></div>

  <!-- ═══════════════════════════════════════════════
       LEFT side — 4 spread elements
       ═══════════════════════════════════════════════ -->
  <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-[24%] xl:block" aria-hidden="true">
    <!-- Ambient blobs -->
    <div class="absolute left-12 top-24 h-56 w-56 rounded-full bg-gradient-to-br from-brand-400/35 to-brand-600/15 blur-3xl hero-blob dark:from-brand-500/20 dark:to-brand-700/10"></div>
    <div class="absolute right-8 bottom-24 h-44 w-44 rounded-full bg-gradient-to-br from-accent-400/25 to-brand-500/15 blur-3xl hero-blob-2 dark:from-accent-500/15"></div>

    <!-- 1. TOP-LEFT: Job card sticking out from corner -->
    <div class="absolute left-12 top-16 w-60 rounded-xl border border-ink-200/70 bg-white/90 p-3.5 shadow-lg backdrop-blur-xl hero-float-slow dark:border-white/[0.08] dark:!bg-white/[0.06]">
      <div class="flex items-center gap-2.5">
        <span class="flex h-9 w-9 items-center justify-center rounded-md bg-[#5e6ad2] text-sm font-bold text-white">L</span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-[13px] font-semibold text-ink-900">Sr. Designer</p>
          <p class="truncate text-[11px] text-ink-500">Linear · Remote</p>
        </div>
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-100 text-[11px] font-bold text-brand-700">98</span>
      </div>
    </div>

    <!-- 2. INSIDE column, middle-ish -->
    <div class="absolute right-24 top-[50%] hero-spin">
      <svg width="46" height="46" viewBox="0 0 52 52" fill="none">
        <path d="M26 6v10M26 36v10M6 26h10M36 26h10M12 12l7 7M33 33l7 7M12 40l7-7M33 19l7-7" stroke="url(#hero-sparkle-L)" stroke-width="2" stroke-linecap="round"/>
        <circle cx="26" cy="26" r="4" fill="url(#hero-sparkle-L)"/>
        <defs><linearGradient id="hero-sparkle-L" x1="0" y1="0" x2="52" y2="52"><stop stop-color="var(--color-brand-500)"/><stop offset="1" stop-color="var(--color-accent-500)"/></linearGradient></defs>
      </svg>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════
       RIGHT side — 4 spread elements
       ═══════════════════════════════════════════════ -->
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[24%] xl:block" aria-hidden="true">
    <!-- Ambient blobs -->
    <div class="absolute right-8 top-24 h-56 w-56 rounded-full bg-gradient-to-br from-accent-400/35 to-accent-600/15 blur-3xl hero-blob-2 dark:from-accent-500/20 dark:to-accent-700/10"></div>
    <div class="absolute left-8 bottom-24 h-44 w-44 rounded-full bg-gradient-to-br from-brand-300/25 to-accent-400/15 blur-3xl hero-blob dark:from-brand-500/15"></div>

    <!-- Dashed ring accent (top-right corner) -->
    <svg class="absolute -top-6 -right-4 hero-spin-slow" width="100" height="100" viewBox="0 0 120 120" fill="none" aria-hidden="true">
      <circle cx="60" cy="60" r="55" stroke="currentColor" class="text-accent-400/40 dark:text-accent-500/30" stroke-width="1.5" stroke-dasharray="4 8"/>
    </svg>

    <!-- 1. TOP-RIGHT: AI/ML +128% chip -->
    <div class="absolute right-44 top-32 flex items-center gap-2.5 rounded-xl border border-ink-200/70 bg-white/90 px-3.5 py-2.5 shadow-lg backdrop-blur-xl hero-float-fast dark:border-white/[0.08] dark:!bg-white/[0.06]">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-emerald-100 to-emerald-50 text-emerald-600 ring-1 ring-emerald-200/50 dark:!bg-emerald-500/20 dark:text-emerald-400">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8m0 0h-6m6 0v6"/></svg>
      </span>
      <div>
        <p class="text-[10px] font-bold uppercase tracking-widest text-ink-500">AI/ML</p>
        <p class="text-[14px] font-semibold text-ink-900 tabular-nums">+128%</p>
      </div>
    </div>

    <!-- 2. MID-RIGHT: Verified pill -->
    <div class="absolute right-72 top-[46%] flex items-center gap-2 rounded-full border border-ink-200/70 bg-white px-3.5 py-2 shadow-md hero-float-slow dark:border-white/10 dark:!bg-white/[0.06]" style="animation-delay: 1.2s">
      <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500 text-white">
        <svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="text-[12px] font-medium text-ink-800">Verified</span>
    </div>

<!-- 3. INSIDE column, middle-ish -->
    <div class="absolute right-24 top-[52%] hero-spin" style="animation-delay: 1s">
      <svg width="44" height="44" viewBox="0 0 24 24" fill="url(#hero-star-R)" aria-hidden="true">
        <path d="M12 2l3 6.5 7 .8-5.2 4.7 1.5 7L12 17.5 5.7 21l1.5-7L2 9.3l7-.8z"/>
        <defs><linearGradient id="hero-star-R" x1="0" y1="0" x2="24" y2="24"><stop stop-color="var(--color-accent-500)"/><stop offset="1" stop-color="var(--color-brand-500)"/></linearGradient></defs>
      </svg>
    </div>

  </div>

  <style>
    @keyframes hero-float-slow {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50%      { transform: translateY(-16px) rotate(-2deg); }
    }
    @keyframes hero-float-fast {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50%      { transform: translateY(-10px) rotate(2deg); }
    }
    @keyframes hero-blob-drift {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33%      { transform: translate(20px, -20px) scale(1.08); }
      66%      { transform: translate(-15px, 10px) scale(0.95); }
    }
    @keyframes hero-blob-drift-2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50%      { transform: translate(-25px, 15px) scale(1.12); }
    }
    @keyframes hero-spin-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes hero-spin      { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(180deg); } }

    .hero-float-slow { animation: hero-float-slow 6s ease-in-out infinite; }
    .hero-float-fast { animation: hero-float-fast 4s ease-in-out infinite; }
    .hero-blob       { animation: hero-blob-drift 12s ease-in-out infinite; }
    .hero-blob-2     { animation: hero-blob-drift-2 14s ease-in-out infinite; }
    .hero-spin-slow  { animation: hero-spin-slow 30s linear infinite; }
    .hero-spin       { animation: hero-spin 10s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
      .hero-float-slow, .hero-float-fast, .hero-blob, .hero-blob-2, .hero-spin-slow, .hero-spin {
        animation: none;
      }
    }
  </style>

  <Container size="xl">
    <!-- Editorial center-aligned hero -->
    <div class="mx-auto max-w-5xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white/70 px-3 py-1.5 text-[10.5px] font-semibold uppercase tracking-widest text-ink-800 backdrop-blur sm:px-4 sm:text-[11.5px] dark:border-white/15 dark:!bg-white/[0.04]">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        </span>
        2026 · New AI matching v3 is live
      </span>

      <h1 class="mt-6 text-[34px] font-semibold leading-[1] tracking-[-0.03em] text-ink-950 sm:mt-8 sm:text-[54px] md:text-6xl lg:text-[80px] xl:text-[92px] xl:leading-[0.98]">
        The <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 via-brand-500 to-accent-500 bg-clip-text text-transparent">work</span> you were meant to do.
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-[15px] leading-relaxed text-ink-600 sm:mt-7 sm:text-lg lg:text-xl">
        The marketplace that pairs {site.stats.candidates} verified professionals with the teams building what's next — in weeks, not quarters.
      </p>

      <!-- Dual CTA -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:mt-10 sm:flex-row">
        <a href="/register" class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-ink-900 px-6 text-[14px] font-semibold text-ink-50 transition-all hover:bg-brand-600 hover:shadow-[0_14px_32px_-8px_rgb(74_63_230/0.45)] sm:h-13 sm:w-auto sm:text-[15px]">
          Find your next role
          <Icon name="arrowRight" size={14} strokeWidth={2} class="transition-transform group-hover:translate-x-0.5" />
        </a>
        <a href="/post-a-job" class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-ink-300 bg-white px-6 text-[14px] font-semibold text-ink-900 backdrop-blur transition-all hover:border-ink-900 hover:bg-ink-50 sm:h-13 sm:w-auto sm:text-[15px] dark:border-white/15 dark:!bg-white/[0.04] dark:text-white">
          <Icon name="plus" size={13} strokeWidth={2.2} />
          Post a job — free
        </a>
      </div>

      <!-- Trending searches -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-1.5 sm:mt-8 sm:gap-2">
        <span class="w-full text-center text-[11.5px] uppercase tracking-widest text-ink-500 sm:w-auto sm:text-[12.5px]">Trending</span>
        {popular.map((p) => (
          <a href={`/jobs?q=${encodeURIComponent(p)}`} class="rounded-full border border-ink-200 bg-white/70 px-3 py-1 text-[13px] text-ink-700 backdrop-blur transition-colors hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50 dark:border-white/10 dark:!bg-white/[0.04] dark:text-ink-800 dark:hover:!bg-white/[0.1]">
            {p}
          </a>
        ))}
      </div>
    </div>

    <!-- Trusted logos marquee (parity w/ Home 1's TrustedCompanies) -->
    <div class="mt-14 border-t border-ink-200/60 pt-8 sm:mt-20 sm:pt-10 dark:border-white/10">
      <p class="text-center text-[11.5px] font-medium uppercase tracking-[0.22em] text-ink-500 sm:text-[13px]">
        Talent already hired at
      </p>
      <div class="relative mt-8 -mx-4 sm:mt-10 sm:-mx-6 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
        <div class="flex w-max animate-marquee gap-8 sm:gap-14 px-4 sm:px-6">
          {marqueeRow.map((c) => (
            <a
              href={`/companies/${c.slug}`}
              class="group flex shrink-0 items-center gap-3 opacity-80 transition-all hover:opacity-100"
              aria-label={c.name}
            >
              <BrandLogo
                slug={c.slug}
                size="sm"
                fallbackColor={c.brandColor}
                fallbackLetter={c.logo}
                class="transition-transform group-hover:scale-110"
              />
              <span class="text-[15px] font-semibold tracking-tight text-ink-700 group-hover:text-ink-900 sm:text-lg dark:text-ink-800">{c.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

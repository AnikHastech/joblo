---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
---
<section class="section-remote-jobs-2 relative isolate overflow-hidden py-20 sm:py-28 bg-white dark:!bg-white/[0.02]">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-grid opacity-30 mask-radial"></div>
  <div class="pointer-events-none absolute -top-20 right-1/3 -z-10 h-[400px] w-[400px] rounded-full bg-emerald-200/40 blur-3xl dark:bg-emerald-500/15"></div>

  <Container size="xl">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionEyebrow number={9} label="Remote-first" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          Work from <span class="font-display italic font-normal text-emerald-600">anywhere</span> — everywhere.
        </h2>
        <p class="mt-4 max-w-md text-[16px] leading-relaxed text-ink-600">
          42K+ fully-remote roles across every timezone. Filter by region, hours, and comp model.
        </p>
        <a href="/jobs?remote=true" class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink-900 px-6 py-3 text-[14.5px] font-semibold text-ink-50 transition-all hover:bg-brand-600 hover:shadow-[0_10px_30px_-8px_rgb(74_63_230/0.4)]">
          Browse remote jobs
          <Icon name="arrowRight" size={14} strokeWidth={2} />
        </a>
      </div>

      <!-- Big stat grid -->
      <div class="grid grid-cols-2 gap-3">
        {[
          { k: "42,180", v: "Remote roles",       tone: "bg-emerald-50 text-emerald-800" },
          { k: "120+",   v: "Countries hiring",   tone: "bg-brand-50 text-brand-800" },
          { k: "$142K",  v: "Avg. remote salary", tone: "bg-accent-50 text-accent-800" },
          { k: "3.8×",   v: "More applications",  tone: "bg-ink-100 text-ink-900" },
        ].map((s) => (
          <div class={`rounded-2xl border border-ink-200/70 p-6 dark:border-white/[0.08] dark:!bg-white/[0.035]`}>
            <p class="font-display text-[42px] italic font-normal leading-none tracking-tight text-ink-900 tabular-nums sm:text-[52px]">
              {s.k}
            </p>
            <p class="mt-3 text-[13px] text-ink-500">{s.v}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

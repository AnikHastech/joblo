---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";

const steps = [
  { n: "01", title: "Build a profile in minutes", body: "Upload a résumé or connect LinkedIn. Our AI structures your experience — and highlights what stands out.", icon: "users"       as const, color: "brand"   },
  { n: "02", title: "Get matched to real roles",   body: "We pair you with verified openings from teams that fit your skills, values, and salary range — not more spam.", icon: "sparkles"    as const, color: "accent"  },
  { n: "03", title: "Apply and hear back — fast",  body: "One-click applications, transparent hiring status, and messages straight from hiring managers. No black holes.", icon: "checkCircle" as const, color: "success" },
];

const colors: Record<string,{bg:string; text:string; ring:string; dot:string;}> = {
  brand:   { bg: "bg-brand-50",   text: "text-brand-700",   ring: "ring-brand-200",   dot: "bg-brand-500"   },
  accent:  { bg: "bg-accent-50",  text: "text-accent-700",  ring: "ring-accent-200",  dot: "bg-accent-500"  },
  success: { bg: "bg-emerald-50", text: "text-emerald-700", ring: "ring-emerald-200", dot: "bg-emerald-500" },
};
---
<section class="section-how-it-works-2 relative isolate overflow-hidden py-20 sm:py-28 bg-gradient-to-br from-brand-50/60 via-white to-accent-50/50 dark:!from-brand-950/25 dark:!via-ink-100 dark:!to-accent-900/25">
  <div class="pointer-events-none absolute -left-32 -top-20 h-[500px] w-[500px] rounded-full bg-brand-300/30 blur-3xl dark:!bg-brand-500/20"></div>
  <div class="pointer-events-none absolute -right-32 bottom-0 h-[500px] w-[500px] rounded-full bg-accent-300/30 blur-3xl dark:!bg-accent-500/20"></div>
  <Container size="xl">
    <div class="mx-auto max-w-6xl text-center">
      <SectionEyebrow number={3} label="How it works" class="justify-center" />
      <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
        Three steps between you and your <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">next role.</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-[16px] leading-relaxed text-ink-600">
        No résumé black holes. No spammy job feeds. Just a straight line from your skills to the teams that need them.
      </p>
    </div>

    <!-- Progress stepper -->
    <div class="mx-auto mt-14 hidden max-w-2xl items-center md:flex" aria-hidden="true">
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-500 text-[13px] font-bold text-white shadow-sm ring-4 ring-brand-100 dark:ring-brand-500/20">1</span>
        <span class="text-[13.5px] font-semibold text-ink-900">Profile</span>
      </div>
      <div class="mx-3 h-px flex-1 bg-gradient-to-r from-brand-400 to-accent-400"></div>
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-accent-500 text-[13px] font-bold text-white shadow-sm ring-4 ring-accent-100 dark:ring-accent-500/20">2</span>
        <span class="text-[13.5px] font-semibold text-ink-900">Match</span>
      </div>
      <div class="mx-3 h-px flex-1 bg-gradient-to-r from-accent-400 to-emerald-400"></div>
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-[13px] font-bold text-white shadow-sm ring-4 ring-emerald-100 dark:ring-emerald-500/20">3</span>
        <span class="text-[13.5px] font-semibold text-ink-900">Apply</span>
      </div>
    </div>

    <!-- Vertical timeline -->
    <ol class="relative mx-auto mt-10 max-w-6xl">
      {steps.map((s) => {
        const c = colors[s.color];
        return (
          <li class="relative mb-6 flex gap-5 rounded-2xl border border-ink-200/70 bg-white p-6 shadow-sm transition-all last:mb-0 hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-md sm:gap-7 sm:p-8 dark:border-white/[0.08] dark:!bg-white/[0.035]">
            <div class="shrink-0">
              <span class={`relative z-10 flex h-11 w-11 items-center justify-center rounded-full ring-4 sm:h-13 sm:w-13 ${c.bg} ${c.text} ${c.ring}`}>
                <Icon name={s.icon} size={18} strokeWidth={1.8} />
              </span>
            </div>
            <div class="min-w-0 flex-1 pt-1">
              <div class="flex items-baseline gap-3">
                <span class={`font-display text-[26px] italic font-normal leading-none text-ink-300`}>{s.n}</span>
                <h3 class="text-lg font-semibold tracking-tight text-ink-900 sm:text-xl">{s.title}</h3>
              </div>
              <p class="mt-2 max-w-2xl text-[15px] leading-relaxed text-ink-600">{s.body}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </Container>
</section>

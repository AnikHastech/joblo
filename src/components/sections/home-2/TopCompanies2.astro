---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import BrandLogo from "@components/common/BrandLogo.astro";
import Badge from "@components/ui/Badge.astro";
import { companies } from "@data/companies";

const top = companies.slice(0, 9);
---
<section class="section-top-companies-2 py-20 sm:py-28">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={6} label="Top companies" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          Teams building <span class="font-display italic font-normal">what's next.</span>
        </h2>
      </div>
      <a href="/companies" class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3 text-[14.5px] font-medium text-ink-900 transition-all hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50 dark:border-white/15 dark:!bg-white/[0.04]">
        Explore companies
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <!-- Compact horizontal cards grid -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {top.map((c) => (
        <a
          href={`/companies/${c.slug}`}
          class="group flex items-center gap-4 rounded-2xl border border-ink-200/70 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:border-white/[0.08] dark:!bg-white/[0.035]"
        >
          <BrandLogo slug={c.slug} size="lg" />
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5">
              <p class="truncate text-[16px] font-semibold text-ink-900 group-hover:text-brand-700 transition-colors">{c.name}</p>
              {c.verified && <Icon name="checkCircle" size={12} strokeWidth={2.2} class="shrink-0 text-brand-500" />}
            </div>
            <p class="mt-0.5 truncate text-[12.5px] text-ink-500">{c.industry} · {c.size}</p>
            <p class="mt-1 text-[12px] font-medium text-brand-700 tabular-nums">{c.openings ?? 0} open roles</p>
          </div>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-ink-200 text-ink-500 transition-all group-hover:border-ink-900 group-hover:bg-ink-900 group-hover:text-ink-50 dark:border-white/15">
            <Icon name="arrowUpRight" size={12} strokeWidth={2} />
          </span>
        </a>
      ))}
    </div>
  </Container>
</section>

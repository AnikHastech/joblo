---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import { insights } from "@data/testimonials";
---
<section class="section-insights-2 py-20 sm:py-28 bg-white dark:!bg-white/[0.02]">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={11} label="Career insights" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          Read what the best <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">already know.</span>
        </h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3 text-[14.5px] font-medium text-ink-900 transition-all hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50 dark:border-white/15 dark:!bg-white/[0.04]">
        All insights
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <!-- Editorial index: 3 horizontal article rows -->
    <ol class="mt-14 overflow-hidden rounded-2xl border border-ink-200/70 bg-white dark:border-white/[0.08] dark:!bg-white/[0.035]">
      {insights.map((post, i) => (
        <li class={i !== 0 ? "border-t border-ink-100 dark:!border-white/[0.06]" : ""}>
          <a href={`/blog/${post.slug}`} class="group grid grid-cols-12 items-center gap-4 p-5 transition-colors hover:bg-ink-50/70 sm:gap-6 sm:p-6 dark:hover:!bg-white/[0.04]">
            <!-- Issue number + date rail -->
            <div class="col-span-3 flex flex-col items-start gap-2 border-l-2 border-brand-500 pl-4 sm:col-span-1">
              <span class="font-display text-[36px] italic font-normal leading-[1.05] tracking-tight bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent tabular-nums pr-2 sm:text-[60px]">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-[11.5px] font-bold uppercase tracking-widest text-ink-800">
                {post.date.split(",")[0]}
              </span>
            </div>

            <!-- Thumbnail -->
            <div class="col-span-9 sm:col-span-2">
              <div class="relative aspect-[16/10] overflow-hidden rounded-lg ring-1 ring-ink-200 dark:ring-white/10">
                <img
                  src={post.coverUrl}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            </div>

            <!-- Category + title -->
            <div class="col-span-12 min-w-0 sm:col-span-6">
              <p class="text-[10.5px] font-bold uppercase tracking-widest text-brand-600">{post.category}</p>
              <h3 class="mt-1.5 text-[18px] font-semibold leading-snug tracking-tight text-ink-900 group-hover:text-brand-700 transition-colors sm:text-xl">
                {post.title}
              </h3>
              <p class="mt-2 line-clamp-2 text-[13.5px] leading-relaxed text-ink-600 sm:line-clamp-1">
                {post.excerpt}
              </p>
            </div>

            <!-- Author + read time (top) + arrow (bottom), stacked -->
            <div class="col-span-12 flex flex-col items-end gap-3 sm:col-span-3">
              <div class="flex min-w-0 items-center gap-2.5">
                <img src={post.authorAvatar} alt="" width="36" height="36" loading="lazy" class="h-9 w-9 shrink-0 rounded-full bg-ink-100" />
                <div class="min-w-0 flex-1">
                  <p class="truncate text-[13px] font-semibold text-ink-900">{post.author}</p>
                  <p class="truncate text-[11.5px] text-ink-500 inline-flex items-center gap-1">
                    <Icon name="clock" size={10} />
                    {post.readMinutes} min read
                  </p>
                </div>
              </div>
              <span class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[12.5px] font-semibold text-ink-50 transition-all group-hover:gap-2 group-hover:bg-brand-600">
                Read more
                <Icon name="arrowUpRight" size={13} strokeWidth={2.2} />
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </Container>
</section>

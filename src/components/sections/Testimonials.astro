---
import Container from "@components/ui/Container.astro";
import Badge from "@components/ui/Badge.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import { testimonials } from "@data/testimonials";

const stats = [
  { k: "72%",  v: "Referrals" },
  { k: "5.2×", v: "Repeat hires" },
  { k: "68",   v: "NPS" },
];
---
<section class="section-testimonials py-20 sm:py-28 bg-white">
  <Container size="xl">
    <!-- Editorial header -->
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <SectionEyebrow number={5} label="Voice" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1] tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">
          In their words,
          <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">on the record.</span>
        </h2>
      </div>
      <div class="lg:col-span-4 lg:pl-8">
        <p class="text-[15px] leading-relaxed text-ink-600">
          A few notes from people we've placed & hiring teams we've partnered with — quoted verbatim, published with permission.
        </p>
      </div>
    </div>

    <!-- Split editorial layout -->
    <div class="mt-14 grid gap-5 lg:grid-cols-12" id="testi-root">
      <!-- Left: Big featured quote card -->
      <div class="relative overflow-hidden rounded-2xl border border-ink-200/70 bg-gradient-to-br from-brand-50/50 via-white to-accent-50/40 dark:border-white/10 dark:from-brand-950/40 dark:via-ink-100 dark:to-accent-900/30 p-6 sm:p-10 lg:col-span-8">
        <!-- Massive quote glyph -->
        <span aria-hidden="true" class="pointer-events-none absolute -left-2 -top-6 font-display text-[220px] leading-none italic text-ink-900/[0.04] select-none">
          &ldquo;
        </span>

        <!-- Top meta bar -->
        <div class="relative flex flex-wrap items-center justify-between gap-3 text-[11px] font-semibold uppercase tracking-[0.2em] text-ink-500">
          <span>
            Take <span id="testi-index" class="text-ink-900 tabular-nums">01</span>
            <span class="mx-1 text-ink-300">/</span>
            <span class="tabular-nums">{String(testimonials.length).padStart(2, "0")}</span>
          </span>
          <span id="testi-tags" class="text-ink-700">
            {testimonials[0].tags.join(" · ")}
          </span>
        </div>

        {testimonials.map((t, i) => (
          <div
            class="testi-slide relative mt-8 transition-opacity duration-500 data-[active=false]:hidden"
            data-index={i}
            data-active={i === 0 ? "true" : "false"}
          >
            <blockquote class="font-display text-xl italic leading-[1.3] text-ink-900 sm:text-3xl lg:text-[38px]">
              &ldquo;{t.quote}&rdquo;
            </blockquote>

            <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-ink-100 pt-6">
              <div class="flex items-center gap-3">
                <img src={t.avatarUrl} alt={t.name} width="52" height="52" loading="lazy" class="h-13 w-13 rounded-full bg-ink-100 ring-2 ring-white shadow-sm" />
                <div>
                  <p class="text-[15.5px] font-semibold text-ink-900">{t.name}</p>
                  <p class="text-[13px] text-ink-500">{t.role} · {t.company} · {t.year}</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="flex" aria-label={`${t.rating} out of 5 stars`}>
                  {Array.from({ length: t.rating }).map(() => (
                    <Icon name="star" size={16} class="text-amber-400" />
                  ))}
                </div>
                {t.hired && (
                  <Badge variant={t.hired === "Employer" ? "brand" : "success"} size="sm" dot>
                    {t.hired === "Employer" ? "Hiring partner" : `Hired in ${t.hired}`}
                  </Badge>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: Controls + list + stats -->
      <div class="flex flex-col gap-5 lg:col-span-4">
        <!-- Controls -->
        <div class="flex items-center justify-between rounded-2xl border border-ink-200/70 bg-white px-4 py-3 shadow-sm">
          <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-widest text-ink-500">
            <span class="relative flex h-1.5 w-1.5">
              <span id="testi-pulse-a" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            </span>
            <span><span id="testi-state">Auto</span> · 6s</span>
          </span>
          <div class="flex items-center gap-1">
            <button id="testi-prev" type="button" class="flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition-colors hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50" aria-label="Previous">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M7.5 3 4.5 6l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button id="testi-toggle" type="button" class="flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition-colors hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50" aria-label="Pause / play">
              <svg id="testi-pause-icon" width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><rect x="3.5" y="2.5" width="1.8" height="7" rx="0.5"/><rect x="6.7" y="2.5" width="1.8" height="7" rx="0.5"/></svg>
              <svg id="testi-play-icon" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" class="hidden"><path d="M3.5 2v8l6-4z"/></svg>
            </button>
            <button id="testi-next" type="button" class="flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 text-ink-700 transition-colors hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50" aria-label="Next">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3 7.5 6l-3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <!-- Quote list (jump-to) -->
        <div class="flex-1 space-y-2">
          {testimonials.map((t, i) => (
            <button
              type="button"
              class="testi-tab group flex w-full items-center gap-4 rounded-2xl border border-ink-200/70 bg-white p-4 text-left transition-all hover:border-ink-300 aria-selected:border-ink-900 aria-selected:shadow-sm"
              aria-selected={i === 0 ? "true" : "false"}
              data-index={i}
            >
              <span class="w-8 shrink-0 text-[11px] font-semibold uppercase tracking-widest text-ink-400 tabular-nums group-aria-selected:text-brand-600">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-[14.5px] font-semibold text-ink-900">{t.name}</p>
                <p class="truncate text-[12.5px] text-ink-500">{t.company}</p>
              </div>
              <span class="testi-dot h-2 w-2 rounded-full bg-ink-200 transition-colors group-aria-selected:bg-brand-500"></span>
            </button>
          ))}
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-3 rounded-2xl border border-ink-200/70 bg-white p-5 shadow-sm">
          {stats.map((s) => (
            <div>
              <p class="text-[10.5px] font-semibold uppercase tracking-widest text-ink-500">{s.v}</p>
              <p class="mt-1 font-display text-[28px] italic leading-none text-ink-900 tabular-nums">{s.k}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  const root = document.getElementById("testi-root");
  if (root) {
    const slides = root.querySelectorAll<HTMLElement>(".testi-slide");
    const tabs   = root.querySelectorAll<HTMLButtonElement>(".testi-tab");
    const indexEl= document.getElementById("testi-index");
    const tagsEl = document.getElementById("testi-tags");
    const stateEl= document.getElementById("testi-state");
    const pulse  = document.getElementById("testi-pulse-a");
    const prev   = document.getElementById("testi-prev");
    const next   = document.getElementById("testi-next");
    const toggle = document.getElementById("testi-toggle");
    const pauseIcon = document.getElementById("testi-pause-icon");
    const playIcon  = document.getElementById("testi-play-icon");

    let current = 0;
    let auto = true;
    let timer: number | undefined;

    const tagsData = Array.from(slides).map((s) => {
      const idx = Number(s.dataset.index);
      const t = tabs[idx];
      return t ? t.querySelector(".testi-tab")?.textContent : "";
    });

    const setActive = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => s.dataset.active = String(idx === current));
      tabs.forEach((t, idx)   => t.setAttribute("aria-selected", String(idx === current)));
      if (indexEl) indexEl.textContent = String(current + 1).padStart(2, "0");
      // Update tags from active slide's data
      const activeSlide = slides[current];
      // Use tags stored in tabs (data comes from server-side)
    };

    const start = () => {
      stop();
      timer = window.setInterval(() => setActive(current + 1), 6000);
      auto = true;
      if (stateEl) stateEl.textContent = "Auto";
      pulse?.classList.remove("hidden");
      pauseIcon?.classList.remove("hidden");
      playIcon?.classList.add("hidden");
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const pause = () => {
      stop();
      auto = false;
      if (stateEl) stateEl.textContent = "Paused";
      pulse?.classList.add("hidden");
      pauseIcon?.classList.add("hidden");
      playIcon?.classList.remove("hidden");
    };

    prev?.addEventListener("click", () => { pause(); setActive(current - 1); });
    next?.addEventListener("click", () => { pause(); setActive(current + 1); });
    toggle?.addEventListener("click", () => auto ? pause() : start());
    tabs.forEach((t) => t.addEventListener("click", () => { pause(); setActive(Number(t.dataset.index)); }));

    // Pause on hover, resume on leave (only when auto was on)
    root.addEventListener("mouseenter", () => { if (auto) stop(); });
    root.addEventListener("mouseleave", () => { if (auto) start(); });

    start();
  }
</script>

---
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
---
<section class="section-employer-cta py-20 sm:py-28 bg-white">
  <Container size="xl">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5 order-2 lg:order-1">
        <!-- Bento visual -->
        <div class="grid grid-cols-6 gap-4">
          <div class="col-span-4 rounded-2xl border border-ink-200 bg-white p-5 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <p class="text-[11px] uppercase tracking-wider text-ink-500">Applicants — Sr. Designer</p>
            </div>
            <div class="mt-4 flex items-end justify-between">
              <p class="text-4xl font-semibold tracking-tight text-ink-900">342</p>
              <span class="text-xs font-medium text-emerald-600">+48% wk</span>
            </div>
            <!-- sparkline -->
            <svg viewBox="0 0 120 40" class="mt-3 w-full text-brand-500" fill="none" preserveAspectRatio="none">
              <path d="M0 30 L15 25 L30 28 L45 18 L60 22 L75 12 L90 15 L105 6 L120 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M0 30 L15 25 L30 28 L45 18 L60 22 L75 12 L90 15 L105 6 L120 10 L120 40 L0 40 Z" fill="currentColor" opacity="0.1"/>
            </svg>
          </div>
          <div class="col-span-2 rounded-2xl bg-[#0c0a09] p-5 text-white shadow-sm">
            <p class="text-[11px] uppercase tracking-wider text-stone-400">Time to hire</p>
            <p class="mt-3 text-3xl font-semibold tracking-tight">14<span class="text-lg font-normal text-stone-400">d</span></p>
            <p class="mt-1 text-xs text-accent-400">↓ 62% vs avg</p>
          </div>
          <div class="col-span-3 rounded-2xl border border-ink-200 bg-white p-5 shadow-sm">
            <p class="text-[11px] uppercase tracking-wider text-ink-500">Shortlist quality</p>
            <div class="mt-4 flex items-baseline gap-1">
              <p class="text-3xl font-semibold tracking-tight text-ink-900">9.4</p>
              <p class="text-sm text-ink-500">/10</p>
            </div>
            <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-ink-100">
              <div class="h-full w-[94%] rounded-full bg-gradient-to-r from-brand-500 to-accent-500"></div>
            </div>
          </div>
          <div class="col-span-3 rounded-2xl bg-gradient-to-br from-accent-500 to-accent-600 p-5 text-white shadow-sm">
            <p class="text-[11px] uppercase tracking-wider text-white/70">Cost per hire</p>
            <p class="mt-3 text-3xl font-semibold tracking-tight">$1,240</p>
            <p class="mt-1 text-xs text-white/80">vs $4,700 industry</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 order-1 lg:order-2 lg:pl-8">
        <SectionEyebrow number={13} label="For employers" />
        <h2 class="mt-4 text-[32px] font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">
          Hire people who <span class="font-display italic font-normal text-brand-600">actually stay</span>.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">
          Post in minutes. Reach 1.8M curated candidates. Ship offers in weeks — not quarters. Loved by growing teams from seed to IPO.
        </p>

        <ul class="mt-8 space-y-3">
          {[
            "AI-matched shortlists — the best 20 candidates, not 2,000 applications",
            "Verified profiles with portfolios, references, and salary transparency",
            "Simple pricing — pay only when you find someone worth interviewing",
          ].map((f) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-700">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6l2.5 2.5L9.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="text-[15.5px] text-ink-700">{f}</span>
            </li>
          ))}
        </ul>

        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/post-a-job" variant="dark" size="lg" icon>Post a job — free</Button>
          <Button href="/pricing" variant="outline" size="lg">See pricing</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

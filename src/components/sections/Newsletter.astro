---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
---
<section class="section-newsletter py-20 sm:py-28">
  <Container size="lg">
    <div class="relative isolate overflow-hidden rounded-2xl border border-ink-200 bg-white dark:border-white/10 p-6 sm:p-12 shadow-sm">
      <div class="pointer-events-none absolute -top-32 -right-32 h-80 w-80 rounded-full bg-brand-100 dark:bg-brand-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 h-80 w-80 rounded-full bg-accent-100 dark:bg-accent-500/20 blur-3xl"></div>

      <div class="relative grid gap-10 sm:grid-cols-12 sm:items-center">
        <div class="sm:col-span-7">
          <SectionEyebrow number={14} label="Weekly digest" />
          <h2 class="mt-4 text-3xl font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-4xl">
            Get the 10 <span class="font-display italic font-normal text-brand-600">best roles</span> of the week.
          </h2>
          <p class="mt-3 text-[15px] text-ink-600">
            Hand-picked opportunities delivered every Tuesday morning. No spam, unsubscribe anytime.
          </p>
        </div>

        <form class="sm:col-span-5" onsubmit="event.preventDefault();">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <div class="flex flex-col gap-2 rounded-2xl border border-ink-200 bg-white p-2 sm:flex-row sm:rounded-full sm:items-center">
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="you@company.com"
              class="w-full bg-transparent px-4 py-3 text-[15px] text-ink-900 placeholder:text-ink-400 focus:outline-none"
            />
            <button
              type="submit"
              class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-ink-900 px-5 text-[14.5px] font-medium text-ink-50 transition-all hover:bg-brand-600 hover:shadow-brand whitespace-nowrap"
            >
              Subscribe
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <p class="mt-3 text-[12px] text-ink-500">Join 84,000+ professionals reading the Joblo Weekly.</p>
        </form>
      </div>
    </div>
  </Container>
</section>

---
import Container from "@components/ui/Container.astro";
import CompanyCard from "@components/companies/CompanyCard.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import { companies } from "@data/companies";
const top = companies.filter((c) => c.featured).slice(0, 4);
---
<section class="section-top-companies py-20 sm:py-28">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={6} label="Top companies" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          Teams building
          <span class="font-display italic font-normal">what's next.</span>
        </h2>
      </div>
      <a href="/companies" class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3 text-[14.5px] font-medium text-ink-900 transition-all hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50">
        Explore companies
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {top.map((c) => <CompanyCard company={c} />)}
    </div>
  </Container>
</section>

---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import { insights } from "@data/testimonials";
---
<section class="section-insights py-20 sm:py-28 bg-white">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <SectionEyebrow number={11} label="Career insights" />
        <h2 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-ink-900 sm:text-5xl">
          Read what the best
          <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">already know.</span>
        </h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-5 py-3 text-[14.5px] font-medium text-ink-900 transition-all hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50">
        All insights
        <Icon name="arrowRight" size={14} />
      </a>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {insights.map((post) => (
        <article class="group relative flex flex-col overflow-hidden rounded-3xl border border-ink-200/70 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-ink-300 hover:shadow-xl dark:border-white/[0.08] dark:!bg-white/[0.035] dark:hover:border-white/20 dark:hover:!bg-white/[0.055]">
          <!-- Cover -->
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={post.coverUrl}
              alt=""
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/10"></div>
            <div class="absolute left-4 top-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-ink-800 backdrop-blur-sm">
                {post.category}
              </span>
            </div>
            <div class="absolute right-4 bottom-4">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-black/40 px-2.5 py-1 text-[11px] font-medium text-white backdrop-blur-sm">
                <Icon name="clock" size={11} strokeWidth={2} />
                {post.readMinutes} min
              </span>
            </div>
          </div>

          <!-- Body -->
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-[19px] font-semibold leading-snug tracking-tight text-ink-900 group-hover:text-brand-700 transition-colors">
              <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0">{post.title}</a>
            </h3>
            <p class="mt-3 line-clamp-3 text-[14.5px] leading-relaxed text-ink-600">
              {post.excerpt}
            </p>

            <!-- Footer -->
            <footer class="mt-6 flex items-center justify-between border-t border-ink-100 pt-5">
              <div class="flex items-center gap-2.5 min-w-0">
                <img
                  src={post.authorAvatar}
                  alt={post.author}
                  width="32"
                  height="32"
                  loading="lazy"
                  class="h-8 w-8 shrink-0 rounded-full bg-ink-100 ring-1 ring-ink-200"
                />
                <div class="min-w-0">
                  <p class="truncate text-[13px] font-medium text-ink-900">{post.author}</p>
                  <p class="truncate text-[11.5px] text-ink-500">{post.date}</p>
                </div>
              </div>
              <span class="flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 text-ink-400 transition-all group-hover:border-ink-900 group-hover:bg-ink-900 group-hover:text-ink-50">
                <Icon name="arrowUpRight" size={13} strokeWidth={2} />
              </span>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

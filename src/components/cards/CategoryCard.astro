---
import type { Category } from "@types/index";
import Icon from "@components/ui/Icon.astro";
interface Props { category: Category; class?: string }
const { category, class: className = "" } = Astro.props;
---
<a
  href={`/categories/${category.slug}`}
  class={`group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-ink-200/70 bg-white p-6 min-h-[200px] transition-all duration-300 hover:-translate-y-1 hover:border-ink-300 hover:shadow-xl dark:border-white/[0.08] dark:!bg-white/[0.035] dark:hover:border-white/20 dark:hover:!bg-white/[0.055] ${className}`}
>
  <!-- ambient corner glow -->
  <div
    class="pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-70"
    style={`background:${category.gradient}`}
    aria-hidden="true"
  ></div>

  <div
    class="relative flex h-14 w-14 items-center justify-center rounded-2xl text-3xl text-white shadow-md ring-1 ring-black/5 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6"
    style={`background:${category.gradient}`}
    aria-hidden="true"
  >
    {category.icon}
  </div>

  <div class="relative mt-6">
    <h3 class="text-[17px] font-semibold tracking-tight text-ink-900">{category.name}</h3>
    <p class="mt-1 text-sm text-ink-500">
      <span class="font-medium text-ink-800 tabular-nums">{category.openings.toLocaleString()}</span> open positions
    </p>
  </div>

  <span
    class="absolute right-5 top-5 flex h-8 w-8 items-center justify-center rounded-full border border-ink-200 text-ink-400 transition-all duration-300 group-hover:border-ink-900 group-hover:bg-ink-900 group-hover:text-ink-50"
    aria-hidden="true"
  >
    <Icon name="arrowUpRight" size={14} strokeWidth={2} />
  </span>
</a>

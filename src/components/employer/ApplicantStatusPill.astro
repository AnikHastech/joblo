---
import { applicantStatusStyle, type ApplicantStatus } from "@data/employer";
interface Props { status: ApplicantStatus; class?: string }
const { status, class: className = "" } = Astro.props;
const s = applicantStatusStyle[status];
---
<span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11.5px] font-semibold ${s.bg} ${s.text} dark:!bg-opacity-20 ${className}`}>
  <span class={`h-1.5 w-1.5 rounded-full ${s.dot}`}></span>
  {status}
</span>

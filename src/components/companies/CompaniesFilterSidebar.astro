---
import Icon from "@components/ui/Icon.astro";
import { companies } from "@data/companies";

// Real counts from actual companies data
const countBy = <K extends string>(key: (c: typeof companies[number]) => K) => {
  const m: Record<string, number> = {};
  companies.forEach((c) => { const k = key(c); m[k] = (m[k] ?? 0) + 1; });
  return m;
};

const industryCounts = countBy((c) => c.industry);
const sizeCounts     = countBy((c) => c.size);

// Location city extraction
const locationCounts = (() => {
  const m: Record<string, number> = { remote: 0 };
  companies.forEach((c) => {
    if (/remote/i.test(c.location)) m.remote++;
    if (c.location.includes("San Francisco")) m["san-francisco"] = (m["san-francisco"] ?? 0) + 1;
    else if (c.location.includes("New York"))  m["new-york"]     = (m["new-york"] ?? 0) + 1;
    else if (c.location.includes("London"))    m["london"]       = (m["london"] ?? 0) + 1;
    else if (c.location.includes("Berlin"))    m["berlin"]       = (m["berlin"] ?? 0) + 1;
    else if (c.location.includes("Tokyo"))     m["tokyo"]        = (m["tokyo"] ?? 0) + 1;
    else if (c.location.includes("Singapore")) m["singapore"]    = (m["singapore"] ?? 0) + 1;
    else if (c.location.includes("Dublin"))    m["dublin"]       = (m["dublin"] ?? 0) + 1;
    else if (c.location.includes("Amsterdam")) m["amsterdam"]    = (m["amsterdam"] ?? 0) + 1;
    else if (c.location.includes("Ottawa"))    m["ottawa"]       = (m["ottawa"] ?? 0) + 1;
  });
  return m;
})();

const verifiedCount = companies.filter((c) => c.verified).length;
const featuredCount = companies.filter((c) => c.featured).length;
const hiringCount   = companies.filter((c) => (c.openings ?? 0) > 0).length;

// Ordered team size buckets
const sizeOrder = ["1-10", "11-50", "51-200", "201-500", "501-1000", "1001-5000", "5000+"];
const sizes = sizeOrder
  .filter((s) => (sizeCounts[s] ?? 0) > 0)
  .map((s) => ({ value: s, label: s, count: sizeCounts[s] }));

const industries = Object.entries(industryCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([label, count]) => ({ label, count, value: label.toLowerCase() }));

const cityList = [
  { value: "san-francisco", label: "San Francisco" },
  { value: "new-york",      label: "New York" },
  { value: "london",        label: "London" },
  { value: "amsterdam",     label: "Amsterdam" },
  { value: "berlin",        label: "Berlin" },
  { value: "dublin",        label: "Dublin" },
  { value: "ottawa",        label: "Ottawa" },
  { value: "tokyo",         label: "Tokyo" },
  { value: "singapore",     label: "Singapore" },
].filter((c) => (locationCounts[c.value] ?? 0) > 0);
---
<aside class="company-filters space-y-3">
  <!-- Header with clear -->
  <div class="flex items-center justify-between rounded-xl border border-ink-200/70 bg-white p-4 dark:border-white/[0.08] dark:!bg-white/[0.035]">
    <div class="flex items-center gap-2">
      <Icon name="filter" size={16} class="text-ink-700" />
      <p class="text-[14px] font-semibold text-ink-900">Filters</p>
      <span id="cf-active-count" class="rounded-full bg-brand-100 px-2 py-0.5 text-[10.5px] font-semibold text-brand-700 aria-hidden:hidden" aria-hidden="true">0 active</span>
    </div>
    <button type="button" id="cf-clear-all" class="text-[12.5px] font-medium text-ink-500 hover:text-ink-900 transition-colors">Clear all</button>
  </div>

  <!-- Quick toggles -->
  <div class="rounded-xl border border-ink-200/70 bg-white p-4 dark:border-white/[0.08] dark:!bg-white/[0.035]">
    <p class="mb-3 text-[13px] font-bold uppercase tracking-widest text-ink-800">Quick filters</p>
    <div class="space-y-2">
      <label class="flex items-center justify-between gap-2 rounded-lg border border-emerald-200 bg-emerald-50/60 p-3 dark:!border-emerald-500/30 dark:!bg-emerald-500/10">
        <span class="flex items-center gap-2.5">
          <Icon name="checkCircle" size={14} class="text-emerald-600" />
          <span class="text-[13.5px] font-semibold text-ink-900">Verified only</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="text-[11.5px] tabular-nums text-ink-500">{verifiedCount}</span>
          <input type="checkbox" name="verified" class="h-4 w-4 rounded border-ink-300 text-emerald-600 focus:ring-emerald-500" />
        </span>
      </label>
      <label class="flex items-center justify-between gap-2 rounded-lg border border-violet-200 bg-violet-50/60 p-3 dark:!border-violet-500/30 dark:!bg-violet-500/10">
        <span class="flex items-center gap-2.5">
          <Icon name="star" size={14} class="text-violet-600" />
          <span class="text-[13.5px] font-semibold text-ink-900">Featured only</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="text-[11.5px] tabular-nums text-ink-500">{featuredCount}</span>
          <input type="checkbox" name="featured" class="h-4 w-4 rounded border-ink-300 text-violet-600 focus:ring-violet-500" />
        </span>
      </label>
      <label class="flex items-center justify-between gap-2 rounded-lg border border-brand-200 bg-brand-50/60 p-3 dark:!border-brand-500/30 dark:!bg-brand-500/10">
        <span class="flex items-center gap-2.5">
          <Icon name="bolt" size={14} class="text-brand-600" />
          <span class="text-[13.5px] font-semibold text-ink-900">Hiring now</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="text-[11.5px] tabular-nums text-ink-500">{hiringCount}</span>
          <input type="checkbox" name="hiring" class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
        </span>
      </label>
    </div>
  </div>

  <!-- Industry -->
  <details open class="filter-group group/f rounded-xl border border-ink-200/70 bg-white p-4 dark:border-white/[0.08] dark:!bg-white/[0.035]">
    <summary class="flex cursor-pointer items-center justify-between list-none">
      <span class="text-[13px] font-bold uppercase tracking-widest text-ink-800">Industry</span>
      <Icon name="chevronDown" size={12} class="text-ink-500 transition-transform group-open/f:rotate-180" />
    </summary>
    <ul class="mt-4 space-y-2">
      {industries.map((ind) => (
        <li>
          <label class="flex items-center justify-between gap-2 rounded-md p-1.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
            <span class="flex items-center gap-2.5">
              <input type="checkbox" name="industry" value={ind.value} class="h-4 w-4 shrink-0 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
              <span class="text-[13.5px] text-ink-800">{ind.label}</span>
            </span>
            <span class="text-[11.5px] tabular-nums text-ink-400">{ind.count}</span>
          </label>
        </li>
      ))}
    </ul>
  </details>

  <!-- Team size -->
  <details open class="filter-group group/f rounded-xl border border-ink-200/70 bg-white p-4 dark:border-white/[0.08] dark:!bg-white/[0.035]">
    <summary class="flex cursor-pointer items-center justify-between list-none">
      <span class="text-[13px] font-bold uppercase tracking-widest text-ink-800">Team size</span>
      <Icon name="chevronDown" size={12} class="text-ink-500 transition-transform group-open/f:rotate-180" />
    </summary>
    <div class="mt-4 flex flex-wrap gap-1.5">
      {sizes.map((s) => (
        <label class="cursor-pointer">
          <input type="checkbox" name="size" value={s.value} class="peer sr-only" />
          <span class="inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-3 py-1.5 text-[12.5px] text-ink-700 transition-all hover:border-ink-400 peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-700 dark:border-white/10 dark:!bg-white/[0.03] dark:peer-checked:!bg-brand-500/15">
            {s.label}
            <span class="text-[10.5px] tabular-nums text-ink-400 peer-checked:text-brand-500">{s.count}</span>
          </span>
        </label>
      ))}
    </div>
  </details>

  <!-- Location -->
  <details open class="filter-group group/f rounded-xl border border-ink-200/70 bg-white p-4 dark:border-white/[0.08] dark:!bg-white/[0.035]">
    <summary class="flex cursor-pointer items-center justify-between list-none">
      <span class="text-[13px] font-bold uppercase tracking-widest text-ink-800">Location</span>
      <Icon name="chevronDown" size={12} class="text-ink-500 transition-transform group-open/f:rotate-180" />
    </summary>
    <div class="mt-4 space-y-3">
      <label class="flex items-center justify-between gap-2 rounded-lg border border-brand-200 bg-brand-50/60 p-3 dark:border-brand-500/30 dark:!bg-brand-500/10">
        <span class="flex items-center gap-2.5">
          <Icon name="globe" size={14} class="text-brand-600" />
          <span class="text-[13.5px] font-semibold text-ink-900">Remote HQ</span>
        </span>
        <span class="flex items-center gap-2">
          <span class="text-[11.5px] tabular-nums text-ink-500">{locationCounts.remote}</span>
          <input type="checkbox" name="remote" class="h-4 w-4 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
        </span>
      </label>
      <ul class="space-y-2">
        {cityList.map((l) => (
          <li>
            <label class="flex items-center justify-between gap-2 rounded-md p-1.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
              <span class="flex items-center gap-2.5">
                <input type="checkbox" name="city" value={l.value} class="h-4 w-4 shrink-0 rounded border-ink-300 text-brand-600 focus:ring-brand-500" />
                <span class="text-[13.5px] text-ink-800">{l.label}</span>
              </span>
              <span class="text-[11.5px] tabular-nums text-ink-400">{locationCounts[l.value]}</span>
            </label>
          </li>
        ))}
      </ul>
    </div>
  </details>

  <!-- Openings range -->
  <details class="filter-group group/f rounded-xl border border-ink-200/70 bg-white p-4 dark:border-white/[0.08] dark:!bg-white/[0.035]">
    <summary class="flex cursor-pointer items-center justify-between list-none">
      <span class="text-[13px] font-bold uppercase tracking-widest text-ink-800">Open roles</span>
      <Icon name="chevronDown" size={12} class="text-ink-500 transition-transform group-open/f:rotate-180" />
    </summary>
    <ul class="mt-4 space-y-2">
      {[
        { value: "1-10",   label: "1 – 10" },
        { value: "11-30",  label: "11 – 30" },
        { value: "31-plus", label: "31+" },
      ].map((r) => (
        <li>
          <label class="flex items-center gap-2.5 rounded-md p-1.5 hover:bg-ink-50 dark:hover:!bg-white/[0.04]">
            <input type="radio" name="openings" value={r.value} class="h-4 w-4 shrink-0 border-ink-300 text-brand-600 focus:ring-brand-500" />
            <span class="text-[13.5px] text-ink-800">{r.label}</span>
          </label>
        </li>
      ))}
    </ul>
  </details>
</aside>

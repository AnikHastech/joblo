---
import type { Company } from "@types/index";
import CompanyMark from "@components/common/CompanyMark.astro";
import Badge from "@components/ui/Badge.astro";

interface Props { company: Company; class?: string }
const { company, class: className = "" } = Astro.props;
---
<a
  href={`/companies/${company.slug}`}
  class={`group relative flex flex-col rounded-2xl border border-ink-200/70 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-lg dark:border-white/[0.08] dark:!bg-white/[0.035] dark:hover:border-white/20 dark:hover:!bg-white/[0.055] ${className}`}
>
  <div class="flex items-start justify-between">
    <CompanyMark slug={company.slug} size="lg" brandColor={company.brandColor} logo={company.logo} />
    {company.verified && <Badge variant="brand" size="sm" dot>Verified</Badge>}
  </div>
  <h3 class="mt-5 text-lg font-semibold tracking-tight text-ink-900">{company.name}</h3>
  <p class="mt-1 line-clamp-2 text-sm text-ink-600">{company.description}</p>

  <dl class="mt-5 grid grid-cols-2 gap-3 text-[13px]">
    <div>
      <dt class="text-ink-400">Industry</dt>
      <dd class="mt-0.5 font-medium text-ink-800">{company.industry}</dd>
    </div>
    <div>
      <dt class="text-ink-400">Team size</dt>
      <dd class="mt-0.5 font-medium text-ink-800">{company.size}</dd>
    </div>
  </dl>

  <footer class="mt-6 flex items-center justify-between border-t border-ink-100 pt-4">
    <span class="text-sm text-ink-600">{company.location}</span>
    <span class="inline-flex items-center gap-1 text-sm font-medium text-brand-700 group-hover:gap-2 transition-all">
      {company.openings ?? 0} open roles
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 6h6m0 0L6 3m3 3L6 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </footer>
</a>

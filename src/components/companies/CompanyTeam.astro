---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import Icon from "@components/ui/Icon.astro";
import type { Company } from "@types/index";
import type { CompanyContent } from "@data/companyContent";

interface Props {
  company: Company;
  content: CompanyContent;
}
const { company, content } = Astro.props;
---
<section class="section-company-team pt-16 pb-20 sm:pt-20 bg-white dark:!bg-white/[0.02]">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <SectionEyebrow number="05" label="The people" />
        <h2 class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-[38px]">
          Meet the <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">team</span>
        </h2>
        <p class="mt-3 max-w-xl text-[14.5px] text-ink-600">
          A small sample of the {company.size.split("-")[0]}+ people you'll work with at {company.name}.
        </p>
      </div>
      <a
        href={content.website + "/team"}
        target="_blank"
        rel="noreferrer"
        class="group inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-2 text-[13px] font-medium text-ink-800 transition-colors hover:border-ink-400 hover:bg-ink-50 dark:!border-white/10 dark:!bg-white/[0.03]"
      >
        See full team
        <Icon name="arrowUpRight" size={13} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {content.team.map((m) => (
        <article class="group flex items-center gap-4 rounded-2xl border border-ink-200/70 bg-white p-4 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-sm dark:!border-white/[0.08] dark:!bg-white/[0.035]">
          <img
            src={m.avatar}
            alt={m.name}
            width="56"
            height="56"
            loading="lazy"
            class="h-14 w-14 shrink-0 rounded-2xl bg-ink-100 object-cover ring-1 ring-ink-200 dark:ring-white/10"
          />
          <div class="min-w-0">
            <p class="text-[14.5px] font-semibold text-ink-900">{m.name}</p>
            <p class="mt-0.5 text-[12.5px] text-ink-500">{m.role}</p>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

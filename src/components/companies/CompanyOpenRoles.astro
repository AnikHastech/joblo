---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import JobCard from "@components/jobs/JobCard.astro";
import Icon from "@components/ui/Icon.astro";
import type { Job, Company } from "@types/index";

interface Props {
  company: Company;
  jobs: Job[];
}
const { company, jobs } = Astro.props;

// Group by category
const byCategory = jobs.reduce<Record<string, Job[]>>((acc, j) => {
  (acc[j.categorySlug] ??= []).push(j);
  return acc;
}, {});
const categories = Object.keys(byCategory).sort();
---
<section id="open-roles" class="section-open-roles scroll-mt-24 pt-16 pb-16 sm:pt-20">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <SectionEyebrow number="04" label="Open roles" />
        <h2 class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-[38px]">
          Come <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">build with us</span>
        </h2>
        <p class="mt-3 max-w-xl text-[14.5px] text-ink-600">
          {jobs.length === 0
            ? `${company.name} isn't hiring right now — follow to hear when new roles open.`
            : `${jobs.length} open role${jobs.length === 1 ? "" : "s"} across ${categories.length} team${categories.length === 1 ? "" : "s"}.`}
        </p>
      </div>
      {jobs.length > 0 && (
        <a
          href={`/jobs?company=${company.slug}`}
          class="group inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-2 text-[13px] font-medium text-ink-800 transition-colors hover:border-ink-400 hover:bg-ink-50 dark:!border-white/10 dark:!bg-white/[0.03]"
        >
          View on job board
          <Icon name="arrowUpRight" size={13} class="transition-transform group-hover:translate-x-0.5" />
        </a>
      )}
    </div>

    {jobs.length === 0 ? (
      <div class="mt-10 rounded-3xl border border-dashed border-ink-200 bg-ink-50/40 p-12 text-center dark:!border-white/10 dark:!bg-white/[0.02]">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-ink-100 text-ink-500 dark:!bg-white/[0.06]">
          <Icon name="bell" size={20} />
        </div>
        <p class="mt-4 text-[15.5px] font-semibold text-ink-900">No open roles today</p>
        <p class="mt-2 text-[13.5px] text-ink-500">Follow {company.name} to get notified when a role opens up.</p>
        <button type="button" class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-ink-900 px-4 py-2 text-[13px] font-semibold text-ink-50 transition-colors hover:bg-brand-600">
          <Icon name="plus" size={13} />
          Follow {company.name}
        </button>
      </div>
    ) : (
      <div class="mt-10 space-y-10">
        {categories.map((cat) => (
          <div>
            <div class="flex items-center gap-3">
              <h3 class="text-[13px] font-bold uppercase tracking-widest text-ink-800">{cat}</h3>
              <span class="h-px flex-1 bg-ink-200 dark:!bg-white/10"></span>
              <span class="text-[11.5px] font-medium tabular-nums text-ink-500">
                {byCategory[cat].length} role{byCategory[cat].length === 1 ? "" : "s"}
              </span>
            </div>
            <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {byCategory[cat].map((j) => <JobCard job={j} />)}
            </div>
          </div>
        ))}
      </div>
    )}
  </Container>
</section>

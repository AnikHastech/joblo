---
import Icon from "@components/ui/Icon.astro";

interface Props {
  icon?: string;
  title: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  compact?: boolean;
}
const {
  icon = "search",
  title, body,
  ctaLabel, ctaHref,
  compact = false,
} = Astro.props;
---
<div class={`rounded-3xl border border-dashed border-ink-200 bg-ink-50/40 text-center dark:!border-white/10 dark:!bg-white/[0.02] ${compact ? "p-8" : "p-12 sm:p-16"}`}>
  <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white text-ink-500 shadow-sm ring-1 ring-ink-200 dark:!bg-white/[0.06] dark:!ring-white/10">
    <Icon name={icon as any} size={22} />
  </div>
  <p class={`mt-5 font-semibold tracking-tight text-ink-900 ${compact ? "text-[15px]" : "text-[17px] sm:text-[19px]"}`}>{title}</p>
  {body && <p class="mx-auto mt-2 max-w-md text-[13.5px] leading-relaxed text-ink-500">{body}</p>}
  {ctaLabel && ctaHref && (
    <a href={ctaHref} class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-ink-900 px-5 py-2.5 text-[13px] font-semibold text-ink-50 transition-colors hover:bg-brand-600">
      {ctaLabel}
      <Icon name="arrowRight" size={13} />
    </a>
  )}
</div>

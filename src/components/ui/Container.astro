---
interface Props {
  as?: string;
  size?: "sm" | "md" | "lg" | "xl";
  class?: string;
}
const { as: Tag = "div", size = "lg", class: className = "" } = Astro.props;
const sizes = {
  sm: "max-w-3xl",
  md: "max-w-5xl",
  lg: "max-w-7xl",
  xl: "max-w-[1600px]",
};
---
<Tag class={`mx-auto w-full px-5 sm:px-8 lg:px-12 ${sizes[size]} ${className}`}>
  <slot />
</Tag>

const isFilled = ["star","twitter","github","play","quote","livePulse"].includes(name as string);
const attrs = isFilled ? "" : `fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round"`;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  role={label ? "img" : "presentation"}
  aria-label={label}
  aria-hidden={!label}
  set:html={`<g ${attrs}>${paths[name]}</g>`}
/>

---
import Icon from "@components/ui/Icon.astro";

/**
 * Reusable data table. Slot in body via <slot />, or drive from `rows` prop
 * for JSON-like data. Handles sticky header, hover, zebra, empty state.
 */
export interface TableColumn {
  key: string;
  label: string;
  align?: "left" | "right" | "center";
  width?: string;   // e.g. "180px" or "20%"
  sortable?: boolean;
  className?: string;
}

interface Props {
  columns?: TableColumn[];
  rows?: Record<string, any>[];
  striped?: boolean;
  sticky?: boolean;   // sticky header
  compact?: boolean;
  emptyLabel?: string;
  class?: string;
}
const {
  columns,
  rows,
  striped = false,
  sticky = true,
  compact = false,
  emptyLabel = "No data",
  class: className = "",
} = Astro.props;

const alignClass = { left: "text-left", right: "text-right", center: "text-center" } as const;
const pad = compact ? "px-4 py-3" : "px-6 py-4";
---
<div class={`joblo-table-wrap overflow-x-auto rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035] ${className}`}>
  <table class="w-full text-left text-[13.5px]">
    {columns && (
      <thead class={sticky ? "sticky top-0 z-10 bg-ink-50/80 backdrop-blur dark:!bg-ink-100/80" : ""}>
        <tr class="border-b border-ink-100 dark:!border-white/[0.06]">
          {columns.map((c) => (
            <th
              scope="col"
              class={`${pad} text-[11px] font-bold uppercase tracking-widest text-ink-500 ${alignClass[c.align ?? "left"]} ${c.className ?? ""}`}
              style={c.width ? `width:${c.width}` : undefined}
            >
              {c.sortable ? (
                <button type="button" class="joblo-table-sort inline-flex items-center gap-1.5 hover:text-ink-900 transition-colors" data-key={c.key}>
                  {c.label}
                  <span class="joblo-table-sort-icon inline-flex flex-col text-[8px] leading-none text-ink-300">
                    <Icon name="chevronDown" size={8} class="rotate-180" />
                    <Icon name="chevronDown" size={8} />
                  </span>
                </button>
              ) : c.label}
            </th>
          ))}
        </tr>
      </thead>
    )}

    <tbody>
      {rows && columns ? (
        rows.length === 0 ? (
          <tr>
            <td colspan={columns.length} class="p-10 text-center text-[13.5px] text-ink-500">{emptyLabel}</td>
          </tr>
        ) : rows.map((row, i) => (
          <tr class={`border-t border-ink-100 transition-colors hover:bg-ink-50/40 dark:!border-white/[0.06] dark:hover:!bg-white/[0.02] ${striped && i % 2 === 1 ? "bg-ink-50/30 dark:!bg-white/[0.015]" : ""}`}>
            {columns.map((c) => (
              <td class={`${pad} text-ink-700 ${alignClass[c.align ?? "left"]} ${c.className ?? ""}`}>
                <Fragment set:html={String(row[c.key] ?? "")} />
              </td>
            ))}
          </tr>
        ))
      ) : (
        <slot />
      )}
    </tbody>
  </table>
</div>

<script>
  // Very light client-side sort: toggles asc/desc and re-orders rows.
  document.querySelectorAll<HTMLElement>(".joblo-table-wrap").forEach((wrap) => {
    const tbody = wrap.querySelector<HTMLTableSectionElement>("tbody");
    const buttons = wrap.querySelectorAll<HTMLButtonElement>(".joblo-table-sort");
    buttons.forEach((btn, colIdx) => {
      let dir: "asc" | "desc" | null = null;
      btn.addEventListener("click", () => {
        dir = dir === "asc" ? "desc" : "asc";
        // reset other sort icons
        buttons.forEach((b) => b.querySelector(".joblo-table-sort-icon")?.classList.remove("text-ink-800","text-brand-600"));
        btn.querySelector(".joblo-table-sort-icon")?.classList.add("text-brand-600");
        const rows = Array.from(tbody?.querySelectorAll("tr") ?? []);
        rows.sort((a, b) => {
          const av = a.children[colIdx]?.textContent?.trim() ?? "";
          const bv = b.children[colIdx]?.textContent?.trim() ?? "";
          const an = parseFloat(av.replace(/[^\d.-]/g, ""));
          const bn = parseFloat(bv.replace(/[^\d.-]/g, ""));
          const bothNum = !isNaN(an) && !isNaN(bn);
          const cmp = bothNum ? an - bn : av.localeCompare(bv);
          return dir === "asc" ? cmp : -cmp;
        });
        rows.forEach((r) => tbody?.appendChild(r));
      });
    });
  });
</script>

---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost" | "dark" | "accent" | "outline";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit";
  class?: string;
  icon?: boolean;
  full?: boolean;
  ariaLabel?: string;
}
const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  icon = false,
  full = false,
  ariaLabel,
} = Astro.props;

const base =
  "group relative inline-flex items-center justify-center gap-2 font-medium tracking-tight rounded-full transition-all duration-200 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500 focus-visible:ring-offset-ink-50 disabled:opacity-50 disabled:pointer-events-none whitespace-nowrap";

const variants = {
  primary:   "bg-ink-900 text-ink-50 hover:bg-ink-800 shadow-sm hover:shadow-md",
  accent:    "bg-accent-500 text-white hover:bg-accent-600 shadow-sm hover:shadow-[0_10px_30px_-8px_rgb(255_77_23/0.5)]",
  secondary: "bg-white text-ink-900 border border-ink-200 hover:border-ink-300 hover:bg-ink-50 shadow-xs",
  outline:   "bg-transparent text-ink-900 border border-ink-300 hover:border-ink-900 hover:bg-ink-900 hover:text-ink-50",
  ghost:     "bg-transparent text-ink-700 hover:bg-ink-100",
  dark:      "bg-brand-600 text-white hover:bg-brand-700 shadow-sm hover:shadow-brand",
};

const sizes = {
  sm: "text-sm h-9 px-4",
  md: "text-[15px] h-11 px-5",
  lg: "text-base h-13 px-7",
};

const cls = `${base} ${variants[variant]} ${sizes[size]} ${full ? "w-full" : ""} ${className}`;
---
{href ? (
  <a href={href} class={cls} aria-label={ariaLabel}>
    <slot />
    {icon && (
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        <path d="M3.5 8h9m0 0L8 3.5M12.5 8L8 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}
  </a>
) : (
  <button type={type} class={cls} aria-label={ariaLabel}>
    <slot />
    {icon && (
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        <path d="M3.5 8h9m0 0L8 3.5M12.5 8L8 12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}
  </button>
)}

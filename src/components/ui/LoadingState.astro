---
/**
 * Skeleton loading state — pulses subtly. Multiple variants for common cases.
 * Use inline for parts of a page, or wrap a full section.
 */
interface Props {
  variant?: "card" | "cards" | "row" | "rows" | "profile" | "text" | "avatar";
  count?: number;      // for cards / rows
  class?: string;
}
const { variant = "text", count = 3, class: className = "" } = Astro.props;

const items = Array.from({ length: count });
---
<div class={`joblo-skeleton ${className}`} aria-busy="true" aria-live="polite">
  {variant === "text" && (
    <div class="space-y-2.5">
      <div class="h-3 w-3/4 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="h-3 w-full rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="h-3 w-5/6 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
    </div>
  )}

  {variant === "avatar" && (
    <div class="flex items-center gap-3">
      <div class="h-11 w-11 rounded-xl bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="flex-1 space-y-2">
        <div class="h-3 w-1/3 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
        <div class="h-2.5 w-1/2 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      </div>
    </div>
  )}

  {variant === "card" && (
    <div class="rounded-2xl border border-ink-200/70 bg-white p-6 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <div class="h-10 w-10 rounded-xl bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="mt-5 h-3 w-1/2 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="mt-3 h-6 w-3/4 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
    </div>
  )}

  {variant === "cards" && (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map(() => (
        <div class="rounded-2xl border border-ink-200/70 bg-white p-5 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
          <div class="flex items-start gap-3">
            <div class="h-11 w-11 rounded-xl bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
            <div class="min-w-0 flex-1 space-y-2">
              <div class="h-3 w-2/3 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
              <div class="h-2.5 w-1/2 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
            </div>
          </div>
          <div class="mt-5 h-2.5 w-full rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
          <div class="mt-2 h-2.5 w-4/5 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
          <div class="mt-5 flex gap-2">
            <div class="h-8 w-20 rounded-full bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
            <div class="h-8 w-8 rounded-full bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
          </div>
        </div>
      ))}
    </div>
  )}

  {variant === "row" && (
    <div class="flex items-center gap-4 rounded-xl border border-ink-200/70 bg-white p-4 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <div class="h-10 w-10 rounded-xl bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="min-w-0 flex-1 space-y-2">
        <div class="h-3 w-1/3 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
        <div class="h-2.5 w-1/2 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      </div>
      <div class="h-8 w-24 rounded-full bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
    </div>
  )}

  {variant === "rows" && (
    <div class="rounded-2xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035] overflow-hidden">
      {items.map((_, i) => (
        <div class={`flex items-center gap-4 p-4 ${i > 0 ? "border-t border-ink-100 dark:!border-white/[0.06]" : ""}`}>
          <div class="h-10 w-10 rounded-xl bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
          <div class="min-w-0 flex-1 space-y-2">
            <div class="h-3 w-2/5 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
            <div class="h-2.5 w-3/5 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
          </div>
          <div class="h-6 w-16 rounded-full bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
        </div>
      ))}
    </div>
  )}

  {variant === "profile" && (
    <div class="rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035] overflow-hidden">
      <div class="h-32 bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
      <div class="p-6 sm:p-10 -mt-12">
        <div class="h-24 w-24 rounded-2xl bg-ink-200 sk-shimmer ring-4 ring-white dark:!bg-white/[0.12] dark:!ring-ink-100"></div>
        <div class="mt-4 h-6 w-64 rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
        <div class="mt-3 h-3 w-96 max-w-full rounded bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>
        <div class="mt-6 flex flex-wrap gap-2">
          {[...Array(5)].map(() => <div class="h-6 w-20 rounded-full bg-ink-200 sk-shimmer dark:!bg-white/[0.08]"></div>)}
        </div>
      </div>
    </div>
  )}

  <span class="sr-only">Loading…</span>
</div>

<style>
  @keyframes sk-pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.55; }
  }
  .sk-shimmer {
    animation: sk-pulse 1.6s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-shimmer { animation: none; opacity: 0.7; }
  }
</style>

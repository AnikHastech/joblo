---
import Icon from "@components/ui/Icon.astro";
import { currentCandidate, dashboardStats } from "@data/dashboard";

interface Props { active?: string }
const { active } = Astro.props;

const nav = [
  { key: "home",         label: "Overview",       href: "/dashboard",                  icon: "home"       },
  { key: "applications", label: "Applications",   href: "/dashboard/applications",     icon: "briefcase", badge: dashboardStats.activeApplications },
  { key: "interviews",   label: "Interviews",     href: "/dashboard/interviews",       icon: "sparkles",  badge: dashboardStats.interviews },
  { key: "offers",       label: "Offers",         href: "/dashboard/offers",           icon: "award",     badge: dashboardStats.offers },
  { key: "assessments",  label: "Assessments",    href: "/dashboard/assessments",      icon: "award"      },
  { key: "referrals",    label: "Referrals",      href: "/dashboard/referrals",        icon: "send"       },
  { key: "messages",     label: "Messages",       href: "/dashboard/messages",         icon: "send",      badge: 1 },
  { key: "saved",        label: "Saved jobs",     href: "/dashboard/saved",            icon: "bookmark",  badge: dashboardStats.savedJobs },
  { key: "alerts",       label: "Job alerts",     href: "/dashboard/alerts",           icon: "bell",      badge: dashboardStats.alerts },
  { key: "notifications",label: "Notifications",  href: "/dashboard/notifications",    icon: "bell"       },
  { key: "profile",      label: "My profile",     href: "/dashboard/profile",          icon: "user"       },
  { key: "resume",       label: "Resume",         href: "/dashboard/resume",           icon: "star"       },
  { key: "settings",     label: "Settings",       href: "/dashboard/settings",         icon: "filter"     },
];
---
<aside class="dashboard-sidebar flex h-full flex-col justify-between gap-6 px-4 py-6 lg:px-5">
  <!-- Brand + identity -->
  <div>
    <div class="flex items-center justify-between gap-2 pb-6 border-b border-ink-200 dark:!border-white/10">
      <a href="/" class="flex items-center gap-2 px-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-ink-900 text-ink-50 font-bold dark:!bg-brand-500">J</span>
        <span class="text-[16px] font-semibold tracking-tight text-ink-900">Joblo</span>
      </a>
      <button
        type="button"
        id="dash-sidebar-close"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 text-ink-600 transition-colors hover:border-ink-400 hover:text-ink-900 lg:hidden dark:!border-white/10 dark:hover:!bg-white/[0.06]"
        aria-label="Close menu"
      >
        <Icon name="close" size={14} />
      </button>
    </div>

    <!-- Candidate mini-profile -->
    <a href="/dashboard/profile" class="mt-4 group flex items-center gap-3 rounded-2xl border border-ink-200/70 bg-white p-3 transition-colors hover:border-ink-300 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
      <img src={currentCandidate.avatar} alt={currentCandidate.name} width="44" height="44" class="h-11 w-11 shrink-0 rounded-xl bg-ink-100 ring-1 ring-ink-200 dark:ring-white/10" />
      <div class="min-w-0 flex-1">
        <p class="truncate text-[13.5px] font-semibold text-ink-900">{currentCandidate.name}</p>
        <p class="mt-0.5 flex items-center gap-1 truncate text-[11.5px] text-emerald-700 dark:text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          {currentCandidate.availability}
        </p>
      </div>
      <Icon name="chevronDown" size={12} class="text-ink-400 -rotate-90" />
    </a>

    <!-- Nav -->
    <nav class="mt-6 space-y-0.5" aria-label="Dashboard">
      {nav.map((item) => {
        const isActive = active === item.key;
        return (
          <a
            href={item.href}
            aria-current={isActive ? "page" : undefined}
            class={[
              "group flex items-center gap-3 rounded-xl px-3 py-2.5 text-[13.5px] font-medium transition-colors",
              isActive
                ? "bg-ink-900 text-ink-50 dark:!bg-brand-500 dark:text-white"
                : "text-ink-700 hover:bg-ink-100 dark:hover:!bg-white/[0.06] dark:text-ink-800",
            ].join(" ")}
          >
            <Icon name={item.icon as any} size={15} class={isActive ? "text-ink-50 dark:text-white" : "text-ink-500 group-hover:text-ink-900"} />
            <span class="flex-1">{item.label}</span>
            {item.badge !== undefined && item.badge > 0 && (
              <span class={[
                "rounded-full px-2 py-0.5 text-[10.5px] font-semibold tabular-nums",
                isActive ? "bg-white/20 text-white" : "bg-ink-100 text-ink-700 dark:!bg-white/[0.08] dark:text-ink-800",
              ].join(" ")}>
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Profile completion -->
    <div class="mt-6 rounded-2xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 p-4 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10">
      <p class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-widest text-brand-700 dark:text-brand-400">
        <Icon name="sparkles" size={12} />
        Profile is {currentCandidate.profileCompletion}% complete
      </p>
      <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-white/80 dark:!bg-white/10">
        <div class="h-full rounded-full bg-gradient-to-r from-brand-500 to-accent-500" style={`width:${currentCandidate.profileCompletion}%`}></div>
      </div>
      <a href="/dashboard/profile/edit" class="mt-3 inline-flex items-center gap-1 text-[12px] font-semibold text-ink-900 hover:text-brand-700 transition-colors">
        Finish setup
        <Icon name="arrowRight" size={11} />
      </a>
    </div>
  </div>

  <!-- Footer -->
  <div class="border-t border-ink-200 pt-4 dark:!border-white/10">
    <a href="/" class="flex items-center gap-2 rounded-xl px-3 py-2 text-[12.5px] text-ink-500 hover:bg-ink-100 hover:text-ink-900 dark:hover:!bg-white/[0.06]">
      <Icon name="arrowUpRight" size={12} />
      Back to site
    </a>
    <button type="button" class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-[12.5px] text-ink-500 hover:bg-ink-100 hover:text-ink-900 dark:hover:!bg-white/[0.06]">
      <Icon name="close" size={12} />
      Sign out
    </button>
  </div>
</aside>

---
import Icon from "@components/ui/Icon.astro";

/**
 * Generic dashboard tile — more flexible than StatCard.
 * Use for panels containing lists, charts, insights, actions.
 * Slots: default (body), header (custom header override), footer.
 */
interface Props {
  title?: string;
  subtitle?: string;
  icon?: string;
  tone?: "brand" | "accent" | "success" | "info" | "warning" | "violet" | "ink" | "gradient";
  href?: string;              // "View all" link in header
  hrefLabel?: string;
  eyebrow?: string;           // small uppercase label above title
  padding?: "none" | "sm" | "md" | "lg";
  class?: string;
}
const {
  title, subtitle, icon, tone = "ink",
  href, hrefLabel = "View all",
  eyebrow,
  padding = "md",
  class: className = "",
} = Astro.props;

const paddings = { none: "", sm: "p-4", md: "p-6", lg: "p-8" };

const toneChip: Record<string, string> = {
  brand:    "bg-brand-50 text-brand-700 dark:!bg-brand-500/15 dark:!text-brand-400",
  accent:   "bg-accent-50 text-accent-700 dark:!bg-accent-500/15 dark:!text-accent-400",
  success:  "bg-emerald-50 text-emerald-700 dark:!bg-emerald-500/15 dark:!text-emerald-400",
  info:     "bg-sky-50 text-sky-700 dark:!bg-sky-500/15 dark:!text-sky-400",
  warning:  "bg-amber-50 text-amber-700 dark:!bg-amber-500/15 dark:!text-amber-400",
  violet:   "bg-violet-50 text-violet-700 dark:!bg-violet-500/15 dark:!text-violet-400",
  ink:      "bg-ink-100 text-ink-700 dark:!bg-white/[0.06] dark:!text-ink-800",
  gradient: "bg-gradient-to-br from-brand-100 to-accent-100 text-brand-700 dark:!from-brand-500/20 dark:!to-accent-500/20 dark:!text-brand-400",
};

const shellClass = tone === "gradient"
  ? "rounded-3xl border border-ink-200/70 bg-gradient-to-br from-brand-50/70 via-white to-accent-50/40 dark:!border-white/[0.08] dark:!from-brand-500/10 dark:!via-white/[0.02] dark:!to-accent-500/10"
  : "rounded-3xl border border-ink-200/70 bg-white dark:!border-white/[0.08] dark:!bg-white/[0.035]";
---
<section class={`dashboard-card ${shellClass} ${paddings[padding]} ${className}`}>
  <slot name="header">
    {(title || eyebrow || icon || href) && (
      <header class={`flex items-start justify-between gap-4 ${padding !== "none" ? "-mt-1 mb-5" : "p-6 border-b border-ink-100 dark:!border-white/[0.06]"}`}>
        <div class="flex items-start gap-3 min-w-0 flex-1">
          {icon && (
            <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl ${toneChip[tone]}`}>
              <Icon name={icon as any} size={16} />
            </span>
          )}
          <div class="min-w-0 flex-1">
            {eyebrow && <p class="text-[11px] font-semibold uppercase tracking-widest text-ink-500">{eyebrow}</p>}
            {title && <h3 class={`${eyebrow ? "mt-1" : ""} text-[16px] font-semibold tracking-tight text-ink-900 sm:text-[17px]`}>{title}</h3>}
            {subtitle && <p class="mt-0.5 text-[12.5px] text-ink-500">{subtitle}</p>}
          </div>
        </div>
        {href && (
          <a href={href} class="text-[12.5px] font-medium text-brand-700 hover:underline whitespace-nowrap">
            {hrefLabel} →
          </a>
        )}
      </header>
    )}
  </slot>

  <slot />

  <slot name="footer" />
</section>

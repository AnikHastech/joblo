---
import Icon from "@components/ui/Icon.astro";

interface Props {
  label: string;
  value: string | number;
  icon: string;
  change?: number;         // percent (positive or negative)
  changeLabel?: string;
  href?: string;
  tone?: "brand" | "accent" | "success" | "info";
}
const {
  label, value, icon, change, changeLabel,
  href, tone = "brand",
} = Astro.props;

const tones: Record<string, string> = {
  brand:   "from-brand-50 to-accent-50 text-brand-700 ring-brand-100/50 dark:!from-brand-500/10 dark:!to-accent-500/10 dark:!ring-white/10 dark:!text-brand-400",
  accent:  "from-accent-50 to-brand-50 text-accent-700 ring-accent-100/50 dark:!from-accent-500/10 dark:!to-brand-500/10 dark:!ring-white/10 dark:!text-accent-400",
  success: "from-emerald-50 to-emerald-50 text-emerald-700 ring-emerald-100/50 dark:!from-emerald-500/10 dark:!to-emerald-500/10 dark:!ring-white/10 dark:!text-emerald-400",
  info:    "from-sky-50 to-sky-50 text-sky-700 ring-sky-100/50 dark:!from-sky-500/10 dark:!to-sky-500/10 dark:!ring-white/10 dark:!text-sky-400",
};

const Tag = href ? "a" : "div";
---
<Tag
  {...(href ? { href } : {})}
  class="stat-card group relative flex flex-col rounded-2xl border border-ink-200/70 bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-ink-300 hover:shadow-sm dark:!border-white/[0.08] dark:!bg-white/[0.035]"
>
  <div class="flex items-start justify-between">
    <span class={`flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br ring-1 ${tones[tone]}`}>
      <Icon name={icon as any} size={16} />
    </span>
    {change !== undefined && (
      <span class={`inline-flex items-center gap-0.5 rounded-full px-2 py-0.5 text-[11px] font-semibold tabular-nums ${change >= 0 ? "bg-emerald-100 text-emerald-700 dark:!bg-emerald-500/15 dark:text-emerald-400" : "bg-rose-100 text-rose-700 dark:!bg-rose-500/15 dark:text-rose-400"}`}>
        <Icon name={change >= 0 ? "arrowUp" : "arrowUp"} size={9} class={change >= 0 ? "" : "rotate-180"} />
        {Math.abs(change)}%
      </span>
    )}
  </div>
  <p class="mt-5 text-[11px] font-semibold uppercase tracking-widest text-ink-500">{label}</p>
  <p class="mt-1 text-[28px] font-semibold tracking-tight text-ink-900 tabular-nums sm:text-[32px]">{value}</p>
  {changeLabel && <p class="mt-1 text-[11.5px] text-ink-500">{changeLabel}</p>}
</Tag>

---
import Container from "@components/ui/Container.astro";
import SectionEyebrow from "@components/ui/SectionEyebrow.astro";
import JobCard from "@components/jobs/JobCard.astro";
import Icon from "@components/ui/Icon.astro";
import type { Job } from "@types/index";

interface Props {
  jobs: Job[];
}
const { jobs } = Astro.props;
if (!jobs.length) return null;
---
<section class="section-related-jobs pt-16 pb-24 sm:pt-20 sm:pb-32 bg-white dark:!bg-white/[0.02]">
  <Container size="xl">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <SectionEyebrow number="09" label="Similar roles" />
        <h2 class="mt-3 text-3xl font-semibold leading-[1.1] tracking-tight text-ink-900 sm:text-4xl">
          You might also <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">like these</span>
        </h2>
        <p class="mt-3 max-w-xl text-[15px] text-ink-600">
          Hand-picked from the same category, matched by seniority and comp range.
        </p>
      </div>
      <a
        href="/jobs"
        class="group inline-flex items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 py-2 text-[13px] font-medium text-ink-800 transition-colors hover:border-ink-400 hover:bg-ink-50 dark:!border-white/10 dark:!bg-white/[0.03]"
      >
        Browse all jobs
        <Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {jobs.map((j) => <JobCard job={j} />)}
    </div>
  </Container>
</section>

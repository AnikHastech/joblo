---
import Icon from "@components/ui/Icon.astro";
import Badge from "@components/ui/Badge.astro";
import CompanyMark from "@components/common/CompanyMark.astro";
import type { Job, Company } from "@types/index";

interface Props {
  job: Job;
  company: Company;
}
const { job, company } = Astro.props;

const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(0)}k` : `${n}`);
const sym = job.currency === "USD" ? "$" : job.currency === "EUR" ? "€" : `${job.currency} `;
const salary = `${sym}${fmt(job.salaryMin)}–${fmt(job.salaryMax)}`;
const posted =
  job.postedDaysAgo === 0 ? "Today" :
  job.postedDaysAgo === 1 ? "Yesterday" :
  `${job.postedDaysAgo} days ago`;

const facts = [
  { label: "Location",     value: job.location,                 icon: "mapPin",  tone: "brand"   },
  { label: "Salary range", value: `${salary}/yr`,               icon: "trending",tone: "emerald" },
  { label: "Posted",       value: posted,                       icon: "clock",   tone: "amber"   },
  { label: "Applicants",   value: `${job.applicants ?? 0} so far`, icon: "users", tone: "violet"  },
];

const toneMap: Record<string, string> = {
  brand:   "bg-brand-50 text-brand-700 ring-brand-100/60 dark:!bg-brand-500/12 dark:text-brand-400 dark:ring-brand-500/20",
  emerald: "bg-emerald-50 text-emerald-700 ring-emerald-100/60 dark:!bg-emerald-500/12 dark:text-emerald-400 dark:ring-emerald-500/20",
  amber:   "bg-amber-50 text-amber-700 ring-amber-100/60 dark:!bg-amber-500/12 dark:text-amber-400 dark:ring-amber-500/20",
  violet:  "bg-violet-50 text-violet-700 ring-violet-100/60 dark:!bg-violet-500/12 dark:text-violet-400 dark:ring-violet-500/20",
};
---
<header class="job-details-header relative overflow-hidden rounded-3xl border border-ink-200/70 bg-white/85 p-6 backdrop-blur-md shadow-sm sm:p-8 dark:!border-white/[0.08] dark:!bg-white/[0.035]">
  <!-- Ambient corner glow -->
  <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-gradient-to-br from-brand-300/30 via-accent-300/20 to-transparent blur-3xl dark:!from-brand-500/15 dark:!via-accent-500/10" aria-hidden="true"></div>

  <div class="relative flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-6">
    <a href={`/companies/${company.slug}`} class="group/mark relative inline-flex shrink-0 items-center gap-3" aria-label={company.name}>
      <span class="relative">
        <span class="absolute -inset-1 rounded-2xl bg-gradient-to-br from-brand-400/30 to-accent-400/30 opacity-0 blur transition-opacity group-hover/mark:opacity-100" aria-hidden="true"></span>
        <span class="relative">
          <CompanyMark slug={company.slug} size="xl" />
        </span>
      </span>
    </a>

    <div class="min-w-0 flex-1">
      <!-- Company meta row -->
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <a
          href={`/companies/${company.slug}`}
          class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-ink-800 hover:text-brand-700 transition-colors"
        >
          {company.name}
          {company.verified && (
            <span class="text-brand-600 dark:!text-brand-400" title="Verified employer" aria-label="Verified">
              <Icon name="checkCircle" size={14} strokeWidth={2} />
            </span>
          )}
        </a>
        <span class="h-1 w-1 rounded-full bg-ink-300"></span>
        <span class="text-[12.5px] text-ink-500">{company.industry}</span>
        <span class="h-1 w-1 rounded-full bg-ink-300"></span>
        <span class="text-[12.5px] text-ink-500 tabular-nums">{company.size} employees</span>
      </div>

      <!-- Title -->
      <h1 class="mt-3 text-[30px] font-semibold leading-[1.05] tracking-[-0.02em] text-ink-900 sm:text-[38px] lg:text-[44px]">
        {job.title.split(",")[0]}
        {job.title.includes(",") && (
          <>
            ,
            <span class="font-display italic font-normal bg-gradient-to-br from-brand-600 to-accent-500 bg-clip-text text-transparent">
              {" "}{job.title.split(",").slice(1).join(",").trim()}
            </span>
          </>
        )}
      </h1>

      <!-- Badges -->
      <div class="mt-5 flex flex-wrap items-center gap-1.5">
        {job.featured && <Badge variant="featured" size="sm" dot>Featured</Badge>}
        {job.remote && <Badge variant="success" size="sm" dot>Remote friendly</Badge>}
        <Badge variant="brand" size="sm">{job.experience}</Badge>
        <Badge variant="outline" size="sm">{job.type}</Badge>
        {job.tags.slice(0, 3).map((tag) => (
          <Badge variant="default" size="sm">{tag}</Badge>
        ))}
      </div>
    </div>
  </div>

  <!-- Facts grid -->
  <dl class="relative mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-3">
    {facts.map((f) => (
      <div class="group flex items-start gap-3 rounded-2xl border border-ink-200/60 bg-white/70 p-3.5 transition-colors hover:border-ink-300 dark:!border-white/[0.06] dark:!bg-white/[0.02]">
        <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ring-1 ${toneMap[f.tone]}`}>
          <Icon name={f.icon as any} size={15} strokeWidth={2} />
        </span>
        <div class="min-w-0">
          <dt class="text-[10.5px] font-semibold uppercase tracking-[0.16em] text-ink-500">{f.label}</dt>
          <dd class="mt-0.5 truncate text-[13.5px] font-semibold text-ink-900 tabular-nums">{f.value}</dd>
        </div>
      </div>
    ))}
  </dl>
</header>
